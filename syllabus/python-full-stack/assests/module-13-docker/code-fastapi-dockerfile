# =============================================================
# Dockerfile for a FastAPI Application
# TechPath Institute — Module 13: Docker & Containerization
#
# This Dockerfile packages a FastAPI app into a Docker image.
# Think of it as a recipe that tells Docker exactly how to
# build and run your application.
#
# Example app: TechPath Student Management API
# Manages student records for TechPath Institute, Bhopal
# =============================================================

# ----------------------------------------------------------
# Stage 1 (Single-stage build — simple and beginner-friendly)
# ----------------------------------------------------------

# FROM — Start with a base image.
# python:3.12-slim is a lightweight Python image (~150 MB).
# "slim" means it has only the essentials — no extra tools.
# This keeps our final image small and fast to download.
FROM python:3.12-slim

# LABEL — Add metadata about this image.
# These labels help identify who built it and what it does.
LABEL maintainer="TechPath Institute <info@techpath.biz>"
LABEL description="FastAPI Student Management API for TechPath Institute"
LABEL version="1.0"

# ENV — Set environment variables.
# PYTHONDONTWRITEBYTECODE=1 prevents Python from creating .pyc files
# PYTHONUNBUFFERED=1 ensures print() output appears in docker logs
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# WORKDIR — Set the working directory inside the container.
# All following commands (COPY, RUN, CMD) will run from /app.
# If /app doesn't exist, Docker creates it automatically.
WORKDIR /app

# COPY requirements.txt first — this is a caching trick!
# Docker caches each layer. If requirements.txt hasn't changed,
# Docker skips the pip install step on rebuild — saving minutes.
COPY requirements.txt .

# RUN — Execute a command during the build process.
# Install all Python dependencies from requirements.txt.
# --no-cache-dir tells pip not to save downloaded packages,
# keeping the image smaller.
# --upgrade pip ensures we have the latest pip version.
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# COPY — Copy application code from your computer into the image.
# The first "." means "everything in the current directory" (on host).
# The second "." means "into /app" (in the container, set by WORKDIR).
# This copies your FastAPI app code, models, routes, etc.
COPY . .

# EXPOSE — Document which port the application listens on.
# This doesn't actually open the port — it's documentation.
# You still need -p 8000:8000 when running the container.
# Our FastAPI app runs on port 8000 (uvicorn default).
EXPOSE 8000

# CMD — The default command to run when the container starts.
# This starts uvicorn (the ASGI server) with our FastAPI app.
#
# --host 0.0.0.0  : Listen on ALL network interfaces
#                   (required so the app is accessible from outside the container)
# --port 8000     : Listen on port 8000
#
# We use the "exec form" (JSON array) instead of shell form.
# Exec form: CMD ["program", "arg1", "arg2"]  <-- CORRECT
# Shell form: CMD program arg1 arg2            <-- works but not recommended
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]


# =============================================================
# MULTI-STAGE BUILD VARIANT (Advanced — for production)
#
# Multi-stage builds create smaller, more secure images by
# separating the "build" step from the "run" step.
# The final image only contains what's needed to RUN the app.
#
# Uncomment the section below and comment out everything above
# to use the multi-stage version.
# =============================================================

