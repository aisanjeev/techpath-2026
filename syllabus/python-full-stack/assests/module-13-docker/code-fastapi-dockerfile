#
# LABEL maintainer="TechPath Institute <info@techpath.biz>"
# LABEL description="FastAPI Student API — Production Build"
#
# ENV PYTHONDONTWRITEBYTECODE=1
# ENV PYTHONUNBUFFERED=1
#
# WORKDIR /app
