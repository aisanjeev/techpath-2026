# # Access:  http://localhost:8000/docs (Swagger UI)
# # Logs:    docker logs techpath-api


# =============================================================
# HOW TO USE THIS DOCKERFILE
# =============================================================
#
# 1. Make sure your project has this structure:
#
#    techpath-api/
#    ├── Dockerfile           <-- this file
#    ├── requirements.txt     <-- Python dependencies
#    ├── .dockerignore        <-- files to exclude from build
#    └── app/
#        ├── __init__.py
#        ├── main.py          <-- FastAPI app entry point
#        ├── models.py        <-- Student, Course models
#        └── routes/
#            └── students.py  <-- API routes for students
#
# 2. Create a requirements.txt:
#
#    fastapi==0.115.0
#    uvicorn[standard]==0.30.0
#    sqlalchemy==2.0.31
#    pydantic==2.8.0
#
# 3. Build the image:
#    docker build -t techpath-api .
#
# 4. Run the container:
#    docker run -d -p 8000:8000 --name my-api techpath-api
#
# 5. Open in browser:
#    http://localhost:8000/docs    (Swagger UI)
#    http://localhost:8000/api/v1/students  (Student list)
#
# 6. View logs:
#    docker logs my-api
#
# 7. Stop and clean up:
#    docker stop my-api
#    docker rm my-api
# =============================================================
