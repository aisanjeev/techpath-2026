# ===========================================
# TechPath Backend Configuration
# ===========================================
# Copy this file to .env.local for local development

# -----------------
# Application
# -----------------
APP_NAME=TechPath API
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# -----------------
# Server
# -----------------
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4321
ALLOWED_HOSTS=["localhost", "127.0.0.1"]
CORS_ORIGINS=["http://localhost:4321", "http://localhost:3000"]

# -----------------
# Database
# -----------------
# SQLite for local development:
DATABASE_URL=sqlite+aiosqlite:///./data/techpath.db
# MySQL for production:
# DATABASE_URL=mysql+aiomysql://user:password@host:3306/techpath
DATABASE_ECHO=false

# -----------------
# Authentication
# -----------------
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------
# Spam protection (public contact/newsletter forms)
# -----------------
# Cloudflare Turnstile secret key (dashboard -> Turnstile -> your widget).
# Leave blank to disable verification. The matching site key goes in the
# frontend as PUBLIC_TURNSTILE_SITE_KEY - set both or neither.
TURNSTILE_SECRET_KEY=
CONTACT_RATE_LIMIT_PER_HOUR=5
NEWSLETTER_RATE_LIMIT_PER_HOUR=10

# -----------------
# Storage
# -----------------
STORAGE_TYPE=local
LOCAL_UPLOAD_PATH=./data/uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=techpath-uploads

# -----------------
# Azure OpenAI
# -----------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# -----------------
# Email (SMTP)
# -----------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@techpath.biz

# -----------------
# Live classroom media (self-hosted MediaMTX WHIP/WHEP + recording transcode)
# -----------------
# Base URL of the MediaMTX server used for teacher/student live audio+video
# (WHIP publish, WHEP/HLS playback). Leave blank to disable live media.
LIVE_MEDIA_BASE_URL=https://live.techpath.biz
# Base URL of the service that transcodes MediaMTX recordings into on-demand replays.
WATCH_SERVICE_BASE_URL=https://watch.techpath.biz

# -----------------
# Graded quizzes
# -----------------
# Fraction of a quiz's questions a student must answer correctly to pass it and
# unlock the following material. A FRACTION (0.7), not a percentage (70).
QUIZ_PASS_MARK=0.7
