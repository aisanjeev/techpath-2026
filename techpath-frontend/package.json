    "lint": "eslint src --ext .ts,.tsx,.astro",
    "lint:fix": "eslint src --ext .ts,.tsx,.astro --fix",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,css,json}\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
