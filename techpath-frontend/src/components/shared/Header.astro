---
import { Image } from 'astro:assets';
import Navigation from './Navigation.astro';
import techpathLogo from '@/assets/images/techpath-logo.webp';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-slate-800/50 bg-slate-950/80 backdrop-blur-xl">
  <div class="container mx-auto px-4">
    <div class="flex h-18 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <Image 
          src={techpathLogo}
          alt="TechPath" 
          width={160}
          height={40}
          loading="eager"
          decoding="async"
          class="h-8 w-auto md:h-10"
        />
      </a>

      <!-- Desktop Navigation -->
      <Navigation currentPath={currentPath} />

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-700 bg-slate-800/50 lg:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

      <!-- CTA Button (Desktop) -->
      <a
        href="/contact"
        class="hidden rounded-lg bg-gradient-to-r from-primary-500 to-primary-600 px-5 py-2.5 text-sm font-semibold text-white transition-all hover:from-primary-600 hover:to-primary-700 hover:shadow-lg hover:shadow-primary-500/25 lg:inline-flex"
      >
        Get Started
      </a>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="hidden border-t border-slate-800 bg-slate-950 lg:hidden"
  >
    <nav class="container mx-auto px-4 py-4">
      <ul class="space-y-2">
        <li>
          <a
            href="/services"
            class={`block rounded-lg px-4 py-3 text-sm font-medium transition-colors ${currentPath.startsWith('/services') ? 'bg-primary-500/10 text-primary-400' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}
          >
            Services
          </a>
        </li>
        <li>
          <a
            href="/solutions"
            class={`block rounded-lg px-4 py-3 text-sm font-medium transition-colors ${currentPath.startsWith('/solutions') ? 'bg-primary-500/10 text-primary-400' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}
          >
            Solutions
          </a>
        </li>
        <li>
          <a
            href="/case-studies"
            class={`block rounded-lg px-4 py-3 text-sm font-medium transition-colors ${currentPath.startsWith('/case-studies') ? 'bg-primary-500/10 text-primary-400' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}
          >
            Case Studies
          </a>
        </li>
        <li>
          <a
            href="/blog"
            class={`block rounded-lg px-4 py-3 text-sm font-medium transition-colors ${currentPath.startsWith('/blog') ? 'bg-primary-500/10 text-primary-400' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}
          >
            Blog
          </a>
        </li>
        <li>
          <a
            href="/training"
            class={`block rounded-lg px-4 py-3 text-sm font-medium transition-colors ${currentPath.startsWith('/training') ? 'bg-primary-500/10 text-primary-400' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}
          >
            Training
          </a>
        </li>
        <li>
          <a
            href="/about"
            class={`block rounded-lg px-4 py-3 text-sm font-medium transition-colors ${currentPath === '/about' ? 'bg-primary-500/10 text-primary-400' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}
          >
            About
          </a>
        </li>
        <li>
          <a
            href="/pricing"
            class={`block rounded-lg px-4 py-3 text-sm font-medium transition-colors ${currentPath === '/pricing' ? 'bg-primary-500/10 text-primary-400' : 'text-slate-300 hover:bg-slate-800 hover:text-white'}`}
          >
            Pricing
          </a>
        </li>
        <li class="pt-2">
          <a
            href="/contact"
            class="block rounded-lg bg-gradient-to-r from-primary-500 to-primary-600 px-4 py-3 text-center text-sm font-semibold text-white"
          >
            Get Started
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
  });
</script>

