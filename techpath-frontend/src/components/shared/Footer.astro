---
const currentYear = new Date().getFullYear();
const apiBaseUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

const footerLinks = {
  services: [
    { label: 'AI & Machine Learning', href: '/services/ai-consulting' },
    { label: 'Cloud Infrastructure', href: '/services/cloud-services' },
    { label: 'Web Development', href: '/services/web-development' },
    { label: 'Data Analytics', href: '/services/data-analytics' },
    { label: 'Cybersecurity', href: '/services/cybersecurity' },
  ],
  company: [
    { label: 'About Us', href: '/about' },
    { label: 'Careers', href: '/careers' },
    { label: 'Case Studies', href: '/case-studies' },
    { label: 'Blog', href: '/blog' },
    { label: 'Contact', href: '/contact' },
  ],
  resources: [
    { label: 'Documentation', href: '/docs' },
    { label: 'Pricing', href: '/pricing' },
    { label: 'FAQs', href: '/faqs' },
    { label: 'Support', href: '/support' },
    { label: 'Partners', href: '/partners' },
  ],
  legal: [
    { label: 'Privacy Policy', href: '/privacy' },
    { label: 'Terms of Service', href: '/terms' },
    { label: 'Cookie Policy', href: '/cookies' },
  ],
};

const socialLinks = [
  { label: 'Twitter', href: 'https://twitter.com/techpath', icon: 'twitter' },
  { label: 'LinkedIn', href: 'https://linkedin.com/company/techpath', icon: 'linkedin' },
  { label: 'GitHub', href: 'https://github.com/techpath', icon: 'github' },
];
---

<footer class="border-t border-slate-800 bg-slate-950">
  <div class="container mx-auto px-4 py-16">
    <div class="grid gap-12 lg:grid-cols-6">
      <!-- Brand Column -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center">
          <img 
            src="/images/techpath-logo.webp" 
            alt="TechPath" 
            class="h-8 w-auto md:h-10"
          />
        </a>
        <p class="mt-4 max-w-sm text-slate-400">
          AI-powered IT solutions for modern enterprises. Transforming businesses through
          innovation and technology.
        </p>

        <!-- Newsletter -->
        <form class="mt-6" id="newsletter-form">
          <label for="newsletter-email" class="mb-2 block text-sm font-medium text-slate-300">
            Subscribe to our newsletter
          </label>
          <div class="flex gap-2">
            <input
              type="email"
              id="newsletter-email"
              name="email"
              placeholder="Enter your email"
              class="flex-1 rounded-lg border border-slate-700 bg-slate-800/50 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500"
              required
            />
            <button
              type="submit"
              class="rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-600"
            >
              Subscribe
            </button>
          </div>
          <p id="newsletter-message" class="mt-2 hidden text-sm"></p>
        </form>
      </div>

      <!-- Links Columns -->
      <div>
        <h3 class="mb-4 font-semibold text-white">Services</h3>
        <ul class="space-y-3">
          {
            footerLinks.services.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-slate-400 transition-colors hover:text-primary-400"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-semibold text-white">Company</h3>
        <ul class="space-y-3">
          {
            footerLinks.company.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-slate-400 transition-colors hover:text-primary-400"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-semibold text-white">Resources</h3>
        <ul class="space-y-3">
          {
            footerLinks.resources.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-slate-400 transition-colors hover:text-primary-400"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-semibold text-white">Legal</h3>
        <ul class="space-y-3">
          {
            footerLinks.legal.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-slate-400 transition-colors hover:text-primary-400"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-800 pt-8 md:flex-row"
    >
      <p class="text-sm text-slate-500">
        &copy; {currentYear} TechPath. All rights reserved.
      </p>

      <!-- Social Links -->
      <div class="flex gap-4">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-700 text-slate-400 transition-colors hover:border-primary-500 hover:text-primary-400"
              aria-label={link.label}
            >
              {link.icon === 'twitter' && (
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
                </svg>
              )}
              {link.icon === 'linkedin' && (
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                </svg>
              )}
              {link.icon === 'github' && (
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<script define:vars={{ apiBaseUrl }}>
  const API_URL = apiBaseUrl;
  const form = document.getElementById('newsletter-form');
  const message = document.getElementById('newsletter-message');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const email = formData.get('email');

    try {
      // Call FastAPI backend directly
      const response = await fetch(`${API_URL}/api/v1/contact/newsletter`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });

      const result = await response.json();

      if (message) {
        message.classList.remove('hidden', 'text-red-400', 'text-green-400');
        
        if (response.ok) {
          message.classList.add('text-green-400');
          message.textContent = result.message || 'Successfully subscribed!';
          form.reset();
        } else {
          message.classList.add('text-red-400');
          message.textContent = result.detail || 'An error occurred. Please try again.';
        }
      }
    } catch (error) {
      console.error('Newsletter error:', error);
      if (message) {
        message.classList.remove('hidden', 'text-green-400');
        message.classList.add('text-red-400');
        message.textContent = 'Network error. Please try again.';
      }
    }
  });
</script>

