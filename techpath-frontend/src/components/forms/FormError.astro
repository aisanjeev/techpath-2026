---
interface Props {
  message: string;
  class?: string;
}

const { message, class: className } = Astro.props;
---

<div
  class={`flex items-start gap-2 rounded-lg border border-red-500/30 bg-red-500/10 p-4 ${className || ''}`}
  role="alert"
>
  <svg class="h-5 w-5 flex-shrink-0 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
  </svg>
  <p class="text-sm text-red-300">{message}</p>
</div>

