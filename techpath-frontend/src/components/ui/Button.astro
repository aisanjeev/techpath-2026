---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className,
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-semibold transition-all rounded-lg';

const variants = {
  primary:
    'bg-gradient-to-r from-primary-500 to-primary-600 text-white hover:from-primary-600 hover:to-primary-700 hover:shadow-lg hover:shadow-primary-500/25',
  secondary:
    'bg-secondary-500 text-white hover:bg-secondary-600',
  outline:
    'border border-slate-700 bg-slate-800/50 text-white hover:border-slate-600 hover:bg-slate-800',
  ghost:
    'text-slate-300 hover:bg-slate-800/50 hover:text-white',
};

const sizes = {
  sm: 'px-4 py-2 text-sm gap-1.5',
  md: 'px-6 py-3 gap-2',
  lg: 'px-8 py-4 text-lg gap-2.5',
};

const classes = `${baseStyles} ${variants[variant]} ${sizes[size]} ${disabled ? 'opacity-50 cursor-not-allowed' : ''} ${className || ''}`;

const Tag = href ? 'a' : 'button';
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} disabled={disabled} class={classes}>
      <slot />
    </button>
  )
}

