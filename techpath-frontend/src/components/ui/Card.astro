---
interface Props {
  title: string;
  description: string;
  href?: string;
  image?: string;
  meta?: string;
  tags?: string[];
  class?: string;
}

const { title, description, href, image, meta, tags, class: className } = Astro.props;

const CardWrapper = href ? 'a' : 'div';
---

<a
  href={href}
  class={`group flex flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/50 transition-all hover:border-primary-500/50 hover:bg-slate-900 ${className || ''}`}
>
  {/* Image */}
  {
    image ? (
      <div class="aspect-video overflow-hidden">
        <img
          src={image}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="flex aspect-video items-center justify-center bg-gradient-to-br from-primary-500/10 to-secondary-500/10">
        <span class="text-4xl text-primary-400/50">📄</span>
      </div>
    )
  }

  {/* Content */}
  <div class="flex flex-1 flex-col p-6">
    {/* Tags */}
    {
      tags && tags.length > 0 && (
        <div class="mb-3 flex flex-wrap gap-2">
          {tags.slice(0, 3).map((tag) => (
            <span class="rounded-full bg-primary-500/10 px-2 py-1 text-xs font-medium text-primary-400">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    {/* Title */}
    <h3
      class="mb-2 font-heading text-lg font-bold text-white transition-colors group-hover:text-primary-400"
    >
      {title}
    </h3>

    {/* Description */}
    <p class="mb-4 flex-1 text-sm text-slate-400 line-clamp-3">
      {description}
    </p>

    {/* Meta */}
    {meta && <p class="text-xs text-slate-500">{meta}</p>}
  </div>
</a>

