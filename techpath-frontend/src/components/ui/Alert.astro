---
interface Props {
  variant?: 'info' | 'success' | 'warning' | 'error';
  title?: string;
  dismissible?: boolean;
  class?: string;
}

const { variant = 'info', title, dismissible = false, class: className } = Astro.props;

const variants = {
  info: {
    bg: 'bg-primary-500/10',
    border: 'border-primary-500/30',
    icon: 'text-primary-400',
    title: 'text-primary-400',
    text: 'text-primary-300',
  },
  success: {
    bg: 'bg-accent-500/10',
    border: 'border-accent-500/30',
    icon: 'text-accent-400',
    title: 'text-accent-400',
    text: 'text-accent-300',
  },
  warning: {
    bg: 'bg-yellow-500/10',
    border: 'border-yellow-500/30',
    icon: 'text-yellow-400',
    title: 'text-yellow-400',
    text: 'text-yellow-300',
  },
  error: {
    bg: 'bg-red-500/10',
    border: 'border-red-500/30',
    icon: 'text-red-400',
    title: 'text-red-400',
    text: 'text-red-300',
  },
};

const style = variants[variant];
---

<div
  class={`alert-container flex gap-3 rounded-lg border p-4 ${style.bg} ${style.border} ${className || ''}`}
  role="alert"
>
  {/* Icon */}
  <div class={`flex-shrink-0 ${style.icon}`}>
    {
      variant === 'info' && (
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
      )
    }
    {
      variant === 'success' && (
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
      )
    }
    {
      variant === 'warning' && (
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          />
        </svg>
      )
    }
    {
      variant === 'error' && (
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
      )
    }
  </div>

  {/* Content */}
  <div class="flex-1">
    {title && <h4 class={`mb-1 font-semibold ${style.title}`}>{title}</h4>}
    <div class={style.text}>
      <slot />
    </div>
  </div>

  {/* Dismiss Button */}
  {
    dismissible && (
      <button
        type="button"
        class={`alert-dismiss flex-shrink-0 ${style.icon} hover:opacity-75`}
        aria-label="Dismiss"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    )
  }
</div>

{
  dismissible && (
    <script>
      document.querySelectorAll('.alert-dismiss').forEach((button) => {
        button.addEventListener('click', () => {
          const alert = button.closest('.alert-container');
          alert?.remove();
        });
      });
    </script>
  )
}

