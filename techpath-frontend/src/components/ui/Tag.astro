---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;

const baseClasses =
  'inline-flex items-center rounded-full border border-slate-700 bg-slate-800/50 px-3 py-1 text-sm text-slate-300 transition-colors hover:border-primary-500/50 hover:text-primary-400';
---

{
  href ? (
    <a href={href} class={`${baseClasses} ${className || ''}`}>
      <slot />
    </a>
  ) : (
    <span class={`${baseClasses} ${className || ''}`}>
      <slot />
    </span>
  )
}

