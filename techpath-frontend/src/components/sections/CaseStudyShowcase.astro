---
interface CaseStudyItem {
  id: number;
  slug: string;
  title: string;
  clientName: string;
  industry: string;
  description: string;
  image: string | null;
  stats: { value: string; label: string };
  tags: string[];
  href: string;
}

interface Props {
  caseStudies: CaseStudyItem[];
  title?: string;
  subtitle?: string;
  viewAllLabel?: string;
  viewAllHref?: string;
}

const {
  caseStudies,
  title = 'Featured Case Studies',
  subtitle = "Real stories of digital transformation. See how we've helped businesses achieve measurable results.",
  viewAllLabel = 'View All Case Studies',
  viewAllHref = '/case-studies',
} = Astro.props;
---

<section class="py-20 lg:py-28">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2 class="mb-4 font-heading text-3xl font-bold text-white md:text-4xl lg:text-5xl">
        {title}
      </h2>
      <p class="text-lg text-slate-400">
        {subtitle}
      </p>
    </div>

    {caseStudies.length === 0 ? (
      <div class="rounded-2xl border border-slate-800 bg-slate-900/50 px-8 py-16 text-center">
        <p class="text-slate-400">No case studies yet. Check back soon.</p>
        {viewAllHref && (
          <a
            href={viewAllHref}
            class="mt-4 inline-flex items-center gap-2 text-primary-400 hover:text-primary-300"
          >
            {viewAllLabel}
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        )}
      </div>
    ) : (
      <>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {
            caseStudies.map((study) => (
              <a
                href={study.href}
                class="group flex flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/50 transition-all hover:border-primary-500/50 hover:bg-slate-900"
              >
                <div class="relative aspect-video overflow-hidden">
                  {study.image ? (
                    <img
                      src={study.image}
                      alt={study.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-primary-500/20 to-secondary-500/20">
                      <span class="text-4xl text-primary-400/50">📊</span>
                    </div>
                  )}
                  {study.stats.value && (
                    <div class="absolute bottom-4 left-4 rounded-lg bg-slate-900/90 px-3 py-2 backdrop-blur-sm">
                      <span class="text-2xl font-bold text-white">{study.stats.value}</span>
                      <span class="ml-2 text-sm text-slate-400">{study.stats.label}</span>
                    </div>
                  )}
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <div class="mb-3 flex flex-wrap gap-2">
                    {study.tags.map((tag) => (
                      <span class="rounded-full bg-primary-500/10 px-2 py-1 text-xs font-medium text-primary-400">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <h3 class="mb-2 font-heading text-xl font-bold text-white transition-colors group-hover:text-primary-400">
                    {study.title}
                  </h3>
                  <p class="mb-2 text-sm text-slate-500">{study.clientName} • {study.industry}</p>
                  <p class="mb-4 flex-1 line-clamp-3 text-slate-400">{study.description}</p>
                  <div class="flex items-center gap-2 text-sm font-medium text-primary-400">
                    Read Case Study
                    <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
        {viewAllHref && (
          <div class="mt-12 text-center">
            <a
              href={viewAllHref}
              class="inline-flex items-center gap-2 rounded-lg border border-slate-700 bg-slate-800/50 px-6 py-3 font-semibold text-white backdrop-blur-sm transition-all hover:border-primary-500/50 hover:bg-slate-800"
            >
              {viewAllLabel}
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        )}
      </>
    )}
  </div>
</section>
