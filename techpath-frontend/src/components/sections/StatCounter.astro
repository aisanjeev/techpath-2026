---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<section class="relative overflow-hidden py-16">
  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-r from-primary-500/5 via-transparent to-secondary-500/5"></div>

  <div class="container relative z-10 mx-auto px-4">
    <div class="grid grid-cols-2 gap-8 lg:grid-cols-4">
      {
        stats.map((stat, index) => (
          <div
            class="group text-center"
            style={`animation-delay: ${index * 100}ms`}
          >
            <div class="mb-2 font-heading text-4xl font-bold text-white transition-transform group-hover:scale-110 md:text-5xl">
              {stat.value}
            </div>
            <div class="text-slate-400">{stat.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

