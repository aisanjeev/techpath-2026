---
interface Feature {
  title: string;
  description: string;
  icon: string;
}

interface Props {
  features: Feature[];
  title?: string;
  subtitle?: string;
}

const {
  features,
  title = 'Why Choose TechPath?',
  subtitle = 'We combine technical excellence with business acumen to deliver solutions that drive real results.',
} = Astro.props;

const iconPaths: Record<string, string> = {
  shield: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  scale: 'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3',
  users: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
  rocket: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
};
---

<section class="py-20 lg:py-28">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <h2 class="mb-4 font-heading text-3xl font-bold text-white md:text-4xl lg:text-5xl">
        {title}
      </h2>
      <p class="text-lg text-slate-400">
        {subtitle}
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {
        features.map((feature, index) => (
          <div
            class="group rounded-2xl border border-slate-800 bg-slate-900/50 p-8 transition-all duration-300 hover:border-primary-500/50 hover:bg-slate-900"
            style={`animation-delay: ${index * 100}ms`}
          >
            {/* Icon */}
            <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-to-br from-primary-500/20 to-secondary-500/20 transition-transform duration-300 group-hover:scale-110">
              <svg
                class="h-7 w-7 text-primary-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={iconPaths[feature.icon] || iconPaths.rocket}
                />
              </svg>
            </div>

            {/* Title */}
            <h3 class="mb-3 font-heading text-xl font-bold text-white">{feature.title}</h3>

            {/* Description */}
            <p class="text-slate-400">{feature.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

