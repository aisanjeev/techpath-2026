---
import type { ApiCourse } from '@services/courseService';

interface Props {
  courses: ApiCourse[];
}

const { courses } = Astro.props;

const categoryColors: Record<string, { badge: string; glow: string }> = {
  'ai': { badge: 'bg-violet-500/15 text-violet-400 border-violet-500/30', glow: 'from-violet-500/20' },
  'data': { badge: 'bg-blue-500/15 text-blue-400 border-blue-500/30', glow: 'from-blue-500/20' },
  'cloud': { badge: 'bg-cyan-500/15 text-cyan-400 border-cyan-500/30', glow: 'from-cyan-500/20' },
  'web': { badge: 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30', glow: 'from-emerald-500/20' },
  'business': { badge: 'bg-amber-500/15 text-amber-400 border-amber-500/30', glow: 'from-amber-500/20' },
};

function getCategoryStyle(categoryName: string = '') {
  const lower = categoryName.toLowerCase();
  if (lower.includes('ai') || lower.includes('machine') || lower.includes('gen')) return categoryColors.ai;
  if (lower.includes('data') || lower.includes('science')) return categoryColors.data;
  if (lower.includes('cloud') || lower.includes('devops')) return categoryColors.cloud;
  if (lower.includes('web') || lower.includes('full')) return categoryColors.web;
  return categoryColors.business;
}

const formatPrice = (n: number) =>
  new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(n);
---

<section class="relative overflow-hidden bg-slate-950 py-20 lg:py-28">
  <!-- Background texture -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute left-0 top-0 h-px w-full bg-gradient-to-r from-transparent via-slate-700/60 to-transparent"></div>
    <div class="absolute bottom-0 left-0 h-px w-full bg-gradient-to-r from-transparent via-slate-700/60 to-transparent"></div>
    <div class="absolute -left-64 top-1/2 h-[500px] w-[500px] -translate-y-1/2 rounded-full bg-primary-500/5 blur-3xl"></div>
    <div class="absolute -right-64 top-1/2 h-[500px] w-[500px] -translate-y-1/2 rounded-full bg-emerald-500/5 blur-3xl"></div>
  </div>

  <div class="container relative mx-auto px-4">

    <!-- Section header -->
    <div class="mb-12 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <span class="mb-3 inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
          TechPath Academy
        </span>
        <h2 class="font-heading text-3xl font-bold leading-tight text-white md:text-4xl">
          We don't just build tech.<br />
          <span class="bg-gradient-to-r from-primary-400 to-emerald-400 bg-clip-text text-transparent">
            We build the people who do.
          </span>
        </h2>
        <p class="mt-3 max-w-xl text-slate-400">
          Alongside our enterprise services, TechPath runs hands-on, instructor-led
          training programs that turn complete beginners into job-ready professionals —
          with real projects, real mentors, and real placements.
        </p>
      </div>

      <!-- Mini stats -->
      <div class="flex shrink-0 flex-wrap gap-6 lg:flex-col lg:items-end lg:gap-3">
        {[
          { value: '1,000+', label: 'Students Trained' },
          { value: '94%', label: 'Placement Rate' },
          { value: '₹7K', label: 'Starting Price' },
        ].map(({ value, label }) => (
          <div class="text-right">
            <div class="text-xl font-bold text-white">{value}</div>
            <div class="text-xs text-slate-500">{label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Main layout: left copy strip + right slider -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-5">

      <!-- LEFT: value prop card -->
      <div class="flex flex-col justify-between rounded-2xl border border-slate-700/50 bg-gradient-to-br from-slate-800/60 to-slate-900/60 p-7 lg:col-span-2">
        <div>
          <div class="mb-6 space-y-4">
            {[
              { icon: '🎯', title: 'Project-First Learning', desc: 'Every course is built around real deliverables — not slides and quizzes.' },
              { icon: '🧑‍🏫', title: 'Live Instructors', desc: 'Small batches, direct access to senior engineers every session.' },
              { icon: '💼', title: 'Placement Support', desc: '94% of graduates land roles within 90 days of completing a course.' },
              { icon: '🔄', title: '30-Day Money Back', desc: 'Not satisfied in the first month? Full refund, no questions asked.' },
            ].map(({ icon, title, desc }) => (
              <div class="flex gap-3">
                <span class="mt-0.5 text-xl leading-none">{icon}</span>
                <div>
                  <div class="text-sm font-semibold text-white">{title}</div>
                  <div class="mt-0.5 text-sm leading-relaxed text-slate-400">{desc}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <a
          href="/training"
          class="group mt-6 inline-flex items-center justify-center gap-2 rounded-xl border border-primary-500/40 bg-primary-500/10 px-5 py-3 text-sm font-semibold text-primary-400 transition-all hover:border-primary-500/70 hover:bg-primary-500/20"
        >
          Explore All Courses
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- RIGHT: course card slider -->
      <div class="relative lg:col-span-3">
        {courses.length === 0 ? (
          <div class="flex h-full items-center justify-center rounded-2xl border border-slate-700/50 bg-slate-800/30 p-12 text-center">
            <div>
              <p class="text-slate-400">No featured courses available right now.</p>
              <a href="/training" class="mt-4 inline-block text-sm text-primary-400 hover:underline">Browse all courses →</a>
            </div>
          </div>
        ) : (
          <>
            <!-- Slider viewport -->
            <div class="overflow-hidden" id="training-slider-viewport">
              <div class="flex transition-transform duration-500 ease-in-out" id="training-slider-track">
                {courses.map((course) => {
                  const style = getCategoryStyle(course.category?.name);
                  const discount = course.original_price && course.original_price > course.price
                    ? Math.round(((course.original_price - course.price) / course.original_price) * 100)
                    : null;
                  return (
                    <div class="w-full flex-shrink-0 px-1.5 sm:w-1/2">
                      <a
                        href={`/training/${course.slug}`}
                        class="group flex h-full flex-col rounded-2xl border border-slate-700/50 bg-slate-800/50 p-5 transition-all duration-200 hover:border-slate-600 hover:bg-slate-800/80 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/30"
                      >
                        <!-- Top: category + discount -->
                        <div class="mb-3 flex items-center justify-between">
                          <span class={`rounded-full border px-2.5 py-0.5 text-xs font-medium ${style.badge}`}>
                            {course.category?.name || 'Training'}
                          </span>
                          {discount && (
                            <span class="rounded bg-green-500/20 px-2 py-0.5 text-xs font-semibold text-green-400">
                              {discount}% OFF
                            </span>
                          )}
                        </div>

                        <!-- Image or gradient banner -->
                        <div class={`mb-4 h-32 w-full overflow-hidden rounded-xl bg-gradient-to-br ${style.glow} to-slate-800/60`}>
                          {course.featured_image ? (
                            <img
                              src={course.featured_image}
                              alt={course.title}
                              loading="lazy"
                              class="h-full w-full object-cover opacity-80 transition-opacity group-hover:opacity-100"
                            />
                          ) : (
                            <div class="flex h-full items-center justify-center">
                              <svg class="h-12 w-12 text-white/20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                              </svg>
                            </div>
                          )}
                        </div>

                        <!-- Course info -->
                        <h3 class="mb-1.5 font-heading text-base font-bold leading-snug text-white transition-colors group-hover:text-primary-300">
                          {course.title}
                        </h3>

                        {course.short_description && (
                          <p class="mb-3 line-clamp-2 text-xs leading-relaxed text-slate-400">
                            {course.short_description}
                          </p>
                        )}

                        <!-- Duration + Level -->
                        <div class="mb-3 flex flex-wrap gap-2">
                          {course.duration && (
                            <span class="inline-flex items-center gap-1 rounded-md bg-slate-700/50 px-2 py-0.5 text-xs text-slate-400">
                              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                              </svg>
                              {course.duration}
                            </span>
                          )}
                          {course.level && (
                            <span class="inline-flex items-center rounded-md bg-slate-700/50 px-2 py-0.5 text-xs capitalize text-slate-400">
                              {course.level}
                            </span>
                          )}
                        </div>

                        <!-- Rating -->
                        {course.rating > 0 && (
                          <div class="mb-3 flex items-center gap-1.5">
                            <div class="flex">
                              {[1,2,3,4,5].map((i) => (
                                <svg class={`h-3.5 w-3.5 ${i <= Math.round(course.rating) ? 'text-amber-400' : 'text-slate-600'}`} fill="currentColor" viewBox="0 0 20 20">
                                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                              ))}
                            </div>
                            <span class="text-xs text-slate-400">
                              {course.rating.toFixed(1)}
                              {course.review_count > 0 && ` (${course.review_count})`}
                            </span>
                          </div>
                        )}

                        <!-- Price + CTA -->
                        <div class="mt-auto flex items-center justify-between">
                          <div>
                            <span class="text-lg font-bold text-white">{formatPrice(course.price)}</span>
                            {course.original_price && course.original_price > course.price && (
                              <span class="ml-1.5 text-sm text-slate-500 line-through">{formatPrice(course.original_price)}</span>
                            )}
                          </div>
                          <span class="inline-flex items-center gap-1 rounded-lg bg-primary-500/15 px-3 py-1.5 text-xs font-semibold text-primary-400 transition-colors group-hover:bg-primary-500 group-hover:text-white">
                            Enroll Now
                            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                          </span>
                        </div>
                      </a>
                    </div>
                  );
                })}
              </div>
            </div>

            <!-- Controls -->
            <div class="mt-6 flex items-center justify-between">
              <!-- Dots -->
              <div class="flex gap-2" id="training-dots"></div>

              <!-- Arrows -->
              <div class="flex gap-2">
                <button
                  id="training-prev"
                  aria-label="Previous courses"
                  class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-700 text-slate-400 transition-colors hover:border-slate-500 hover:text-white disabled:cursor-not-allowed disabled:opacity-30"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                  </svg>
                </button>
                <button
                  id="training-next"
                  aria-label="Next courses"
                  class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-700 text-slate-400 transition-colors hover:border-slate-500 hover:text-white disabled:cursor-not-allowed disabled:opacity-30"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </button>
              </div>
            </div>
          </>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const track = document.getElementById('training-slider-track');
    const dotsEl = document.getElementById('training-dots');
    const prevBtn = document.getElementById('training-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('training-next') as HTMLButtonElement | null;
    if (!track) return;

    const slides = track.children.length;
    let current = 0;

    function getVisible() {
      return window.innerWidth >= 640 ? 2 : 1;
    }

    function maxIndex() {
      return Math.max(0, slides - getVisible());
    }

    function buildDots() {
      if (!dotsEl) return;
      dotsEl.innerHTML = '';
      const count = maxIndex() + 1;
      for (let i = 0; i < count; i++) {
        const d = document.createElement('button');
        d.className = 'h-1.5 rounded-full transition-all duration-300 ' +
          (i === current ? 'w-6 bg-primary-400' : 'w-1.5 bg-slate-600');
        d.setAttribute('aria-label', `Slide ${i + 1}`);
        d.addEventListener('click', () => go(i));
        dotsEl.appendChild(d);
      }
    }

    function go(index: number) {
      current = Math.max(0, Math.min(index, maxIndex()));
      const pct = (100 / getVisible()) * current;
      track!.style.transform = `translateX(-${pct}%)`;
      buildDots();
      if (prevBtn) prevBtn.disabled = current === 0;
      if (nextBtn) nextBtn.disabled = current >= maxIndex();
    }

    prevBtn?.addEventListener('click', () => go(current - 1));
    nextBtn?.addEventListener('click', () => go(current + 1));
    window.addEventListener('resize', () => go(Math.min(current, maxIndex())));

    go(0);
  })();
</script>
