---
import { Picture } from 'astro:assets';
import himalayan from '@assets/images/trusted/himalayan-tripsters.png';
import talwalkar from '@assets/images/trusted/talwalkar-square.png';
import digitalAssassin from '@assets/images/trusted/digital-assassin.png';
import nrem from '@assets/images/trusted/nrem.png';
import conwerz from '@assets/images/trusted/conwerz-ai.png';
import globalEvents from '@assets/images/trusted/global-events-travels.png';
import octavia from '@assets/images/trusted/octavia-hospital.png';

interface HomeHero {
  badge_text: string;
  headline: string;
  headline_highlight: string;
  subheadline: string;
  primary_cta_label: string;
  primary_cta_href: string;
  secondary_cta_label: string;
  secondary_cta_href: string;
}

interface Props {
  hero?: HomeHero;
}

const { hero: heroProp } = Astro.props;
const hero = heroProp ?? {
  badge_text: 'Now offering GenAI Solutions',
  headline: 'AI-Powered IT Solutions for',
  headline_highlight: 'Modern Enterprises',
  subheadline: 'Transform your business with cutting-edge AI, cloud infrastructure, and custom software solutions. We help enterprises innovate faster and scale smarter.',
  primary_cta_label: 'Start Your Project',
  primary_cta_href: '/contact',
  secondary_cta_label: 'Watch Demo',
  secondary_cta_href: '/case-studies',
};
---

<section class="relative overflow-hidden py-20 lg:py-32">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary-500/20 via-slate-950 to-slate-950"></div>
  <div class="absolute inset-0 bg-[url('/images/grid.svg')] bg-center opacity-10"></div>
  
  <!-- Floating elements (animation skipped on small screens / reduced-motion to save TBT) -->
  <div class="absolute left-1/4 top-1/4 h-64 w-64 rounded-full bg-primary-500/10 blur-3xl motion-safe:md:animate-float"></div>
  <div class="absolute right-1/4 bottom-1/4 h-96 w-96 rounded-full bg-secondary-500/10 blur-3xl motion-safe:md:animate-float" style="animation-delay: -3s;"></div>

  <div class="container relative z-10 mx-auto px-4">
    <div class="mx-auto max-w-4xl text-center">
      <!-- Badge -->
      <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-primary-500/30 bg-primary-500/10 px-4 py-2">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-primary-500"></span>
        </span>
        <span class="text-sm font-medium text-primary-400">{hero.badge_text}</span>
      </div>

      <!-- Headline -->
      <h1 class="mb-6 font-heading text-4xl font-bold leading-tight text-white md:text-5xl lg:text-6xl xl:text-7xl">
        {hero.headline}
        <span class="bg-gradient-to-r from-primary-400 via-secondary-400 to-accent-400 bg-clip-text text-transparent">
          {hero.headline_highlight}
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="mx-auto mb-10 max-w-2xl text-lg text-slate-400 md:text-xl">
        {hero.subheadline}
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href={hero.primary_cta_href}
          class="group inline-flex items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-primary-500 to-primary-600 px-8 py-4 font-semibold text-white transition-all hover:from-primary-600 hover:to-primary-700 hover:shadow-xl hover:shadow-primary-500/25"
        >
          {hero.primary_cta_label}
          <svg
            class="h-5 w-5 transition-transform group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
        <a
          href={hero.secondary_cta_href}
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-700 bg-slate-800/50 px-8 py-4 font-semibold text-white backdrop-blur-sm transition-all hover:border-slate-600 hover:bg-slate-800"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          {hero.secondary_cta_label}
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="mt-16">
        <p class="mb-5 text-xs font-medium uppercase tracking-widest text-slate-500">
          Trusted by leading companies worldwide
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4">
          {[
            { src: himalayan, alt: 'Himalayan Tripsters' },
            { src: talwalkar, alt: 'Talwalkar Square' },
            { src: digitalAssassin, alt: 'Digital Assassin' },
            { src: nrem, alt: 'NREM' },
            { src: conwerz, alt: 'Conwerz AI' },
            { src: globalEvents, alt: 'Global Events Travels' },
            { src: octavia, alt: 'Octavia Hospital' },
          ].map(({ src, alt }, idx) => (
            <div class="flex items-center justify-center rounded-xl bg-white px-4 py-2.5 opacity-80 ring-1 ring-slate-200 shadow-sm transition-all duration-200 hover:opacity-100 hover:-translate-y-0.5 hover:shadow-md">
              <Picture
                src={src}
                alt={alt}
                widths={[120, 240]}
                sizes="120px"
                formats={['avif', 'webp']}
                fallbackFormat="png"
                loading={idx < 3 ? 'eager' : 'lazy'}
                {...(idx < 3 ? { fetchpriority: 'high' } : {})}
                decoding="async"
                class="h-auto max-h-8 w-auto max-w-[120px] object-contain"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

