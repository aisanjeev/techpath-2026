---
interface Plan {
  name: string;
  description: string;
  price: string;
  period: string;
  features: string[];
  cta: string;
  highlighted?: boolean;
}

interface Props {
  plans: Plan[];
}

const { plans } = Astro.props;
---

<div class="grid gap-8 lg:grid-cols-3">
  {
    plans.map((plan) => (
      <div
        class={`relative flex flex-col rounded-2xl border p-8 transition-all ${
          plan.highlighted
            ? 'border-primary-500 bg-gradient-to-b from-primary-500/10 to-transparent'
            : 'border-slate-800 bg-slate-900/50 hover:border-slate-700'
        }`}
      >
        {plan.highlighted && (
          <div class="absolute -top-4 left-1/2 -translate-x-1/2">
            <span class="rounded-full bg-primary-500 px-4 py-1 text-sm font-semibold text-white">
              Most Popular
            </span>
          </div>
        )}

        {/* Plan Header */}
        <div class="mb-8 text-center">
          <h3 class="mb-2 font-heading text-2xl font-bold text-white">{plan.name}</h3>
          <p class="text-slate-400">{plan.description}</p>
        </div>

        {/* Price */}
        <div class="mb-8 text-center">
          <span class="font-heading text-5xl font-bold text-white">{plan.price}</span>
          <span class="text-slate-400"> / {plan.period}</span>
        </div>

        {/* Features */}
        <ul class="mb-8 flex-1 space-y-4">
          {plan.features.map((feature) => (
            <li class="flex items-start gap-3">
              <svg
                class="h-5 w-5 flex-shrink-0 text-accent-500"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              <span class="text-slate-300">{feature}</span>
            </li>
          ))}
        </ul>

        {/* CTA Button */}
        <a
          href="/contact"
          class={`block rounded-lg py-4 text-center font-semibold transition-all ${
            plan.highlighted
              ? 'bg-gradient-to-r from-primary-500 to-primary-600 text-white hover:from-primary-600 hover:to-primary-700 hover:shadow-lg hover:shadow-primary-500/25'
              : 'border border-slate-700 bg-slate-800/50 text-white hover:border-slate-600 hover:bg-slate-800'
          }`}
        >
          {plan.cta}
        </a>
      </div>
    ))
  }
</div>

