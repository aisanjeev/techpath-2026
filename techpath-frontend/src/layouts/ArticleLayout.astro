---
/**
 * ArticleLayout
 * Full-featured layout for blog posts, documentation, and service pages
 * Includes TOC sidebar, metadata, author info, and related content
 */
import MainLayout from './MainLayout.astro';
import Breadcrumb from '@components/shared/Breadcrumb.astro';
import MarkdownRenderer from '@components/MarkdownRenderer.astro';
import '@styles/markdown.css';

interface BreadcrumbItem {
  label: string;
  href: string;
  current?: boolean;
}

interface RelatedPost {
  slug: string;
  title: string;
  description?: string;
  image?: string;
}

interface CategoryInfo {
  name: string;
  slug: string;
}

interface Props {
  /** Page title (displayed on page) */
  title: string;
  /** Page description/excerpt (displayed on page) */
  description: string;
  /** SEO title for <head> (optional, defaults to title) */
  seoTitle?: string;
  /** SEO description for <head> meta (optional, defaults to description) */
  seoDescription?: string;
  /** Author name */
  author?: string;
  /** Publication date */
  pubDate?: Date;
  /** Last modified date */
  updatedDate?: Date;
  /** Featured image */
  image?: string;
  /** Category (for blog posts) */
  category?: CategoryInfo;
  /** Tags */
  tags?: string[];
  /** Reading time in minutes */
  readingTime?: number;
  /** Breadcrumb items */
  breadcrumbs?: BreadcrumbItem[];
  /** Related posts */
  relatedPosts?: RelatedPost[];
  /** Show TOC sidebar */
  showToc?: boolean;
  /** Show author bio section */
  showAuthorBio?: boolean;
  /** Show share buttons */
  showShareButtons?: boolean;
  /** Type of content (affects some styling) */
  type?: 'blog' | 'documentation' | 'service';
}

const {
  title,
  description,
  seoTitle,
  seoDescription,
  author,
  pubDate,
  updatedDate,
  image,
  category,
  tags = [],
  readingTime,
  breadcrumbs,
  relatedPosts = [],
  showToc = true,
  showAuthorBio = true,
  showShareButtons = true,
  type = 'blog',
} = Astro.props;

// Use SEO fields if provided, otherwise fallback to display fields
const headTitle = seoTitle || title;
const headDescription = seoDescription || description;

// Format dates
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);

const formattedPubDate = pubDate ? formatDate(pubDate) : null;
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;

// Get current URL for share buttons
const currentUrl = Astro.url.href;
---

<MainLayout title={headTitle} description={headDescription} image={image}>
  <article class="article-layout py-12 lg:py-20">
    <div class="container mx-auto px-4">
      {/* Breadcrumbs */}
      {breadcrumbs && breadcrumbs.length > 0 && (
        <Breadcrumb items={breadcrumbs} />
      )}

      {/* Article Header */}
      <header class="article-header max-w-4xl mx-auto mb-12">
        {/* Category and Tags */}
        {(category || tags.length > 0) && (
          <div class="flex flex-wrap gap-2 mb-4">
            {/* Category (styled differently) */}
            {category && type === 'blog' && (
              <a
                href={`/blog/category/${category.slug}`}
                class="px-3 py-1 text-sm font-medium bg-teal-500/20 text-teal-400 rounded-full hover:bg-teal-500/30 transition-colors"
              >
                {category.name}
              </a>
            )}
            {/* Tags */}
            {tags.map((tag) => (
              type === 'blog' ? (
                <a
                  href={`/blog/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
                  class="px-3 py-1 text-sm font-medium bg-primary-500/10 text-primary-400 rounded-full hover:bg-primary-500/20 transition-colors"
                >
                  {tag}
                </a>
              ) : (
                <span class="px-3 py-1 text-sm font-medium bg-primary-500/10 text-primary-400 rounded-full">
                  {tag}
                </span>
              )
            ))}
          </div>
        )}

        {/* Title */}
        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
          {title}
        </h1>

        {/* Description */}
        <p class="text-xl text-slate-400 leading-relaxed mb-8">
          {description}
        </p>

        {/* Meta information */}
        <div class="flex flex-wrap items-center gap-4 text-sm text-slate-400 pb-8 border-b border-slate-800">
          {/* Author */}
          {author && (
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center">
                <span class="text-white font-bold">{author.charAt(0)}</span>
              </div>
              <div>
                <span class="block font-medium text-slate-200">{author}</span>
                {type === 'blog' && <span class="text-xs">Author</span>}
              </div>
            </div>
          )}

          {/* Separator */}
          {author && (formattedPubDate || readingTime) && (
            <span class="hidden sm:block text-slate-700">|</span>
          )}

          {/* Date */}
          {formattedPubDate && (
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <time datetime={pubDate?.toISOString()}>{formattedPubDate}</time>
            </div>
          )}

          {/* Updated date */}
          {formattedUpdatedDate && (
            <span class="text-xs">(Updated: {formattedUpdatedDate})</span>
          )}

          {/* Reading time */}
          {readingTime && (
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{readingTime} min read</span>
            </div>
          )}
        </div>
      </header>

      {/* Featured Image */}
      {image && (
        <figure class="max-w-5xl mx-auto mb-12">
          <img
            src={image}
            alt={title}
            class="w-full h-auto rounded-2xl shadow-2xl"
            loading="eager"
          />
        </figure>
      )}

      {/* Main Content Area */}
      <div class="article-content-wrapper max-w-4xl mx-auto">
        {/* Content with markdown styling */}
        <div class="markdown-content">
          <slot />
        </div>
      </div>

      {/* Article Footer */}
      <footer class="max-w-4xl mx-auto mt-16">
        {/* Tags (bottom) */}
        {tags.length > 0 && (
          <div class="flex flex-wrap items-center gap-3 pb-8 border-b border-slate-800">
            <span class="text-sm text-slate-500">Tagged:</span>
            {tags.map((tag) => (
              type === 'blog' ? (
                <a
                  href={`/blog/tags/${tag.toLowerCase()}`}
                  class="px-3 py-1 text-sm border border-slate-700 text-slate-400 rounded-full hover:border-primary-500 hover:text-primary-400 transition-colors"
                >
                  #{tag}
                </a>
              ) : (
                <span class="px-3 py-1 text-sm border border-slate-700 text-slate-400 rounded-full">
                  #{tag}
                </span>
              )
            ))}
          </div>
        )}

        {/* Share buttons */}
        {showShareButtons && (
          <div class="flex items-center gap-4 py-8 border-b border-slate-800">
            <span class="text-sm text-slate-500">Share:</span>
            <div class="flex gap-3">
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(currentUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center w-10 h-10 rounded-lg bg-slate-800 text-slate-400 hover:bg-[#1DA1F2] hover:text-white transition-colors"
                aria-label="Share on Twitter"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
                </svg>
              </a>
              <a
                href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(currentUrl)}&title=${encodeURIComponent(title)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center w-10 h-10 rounded-lg bg-slate-800 text-slate-400 hover:bg-[#0A66C2] hover:text-white transition-colors"
                aria-label="Share on LinkedIn"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                </svg>
              </a>
              <button
                class="copy-link-btn flex items-center justify-center w-10 h-10 rounded-lg bg-slate-800 text-slate-400 hover:bg-primary-500 hover:text-white transition-colors"
                data-url={currentUrl}
                aria-label="Copy link"
              >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </button>
            </div>
          </div>
        )}

        {/* Author Bio */}
        {showAuthorBio && author && (
          <div class="py-8 border-b border-slate-800">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-16 h-16 rounded-full bg-gradient-to-br from-primary-500 to-secondary-500 flex items-center justify-center">
                <span class="text-white text-2xl font-bold">{author.charAt(0)}</span>
              </div>
              <div>
                <h4 class="font-semibold text-white mb-1">Written by {author}</h4>
                <p class="text-sm text-slate-400 mb-3">
                  Expert in technology solutions and digital transformation. Passionate about helping businesses succeed.
                </p>
                <a href="/about" class="text-sm text-primary-400 hover:text-primary-300 transition-colors">
                  View profile →
                </a>
              </div>
            </div>
          </div>
        )}

        {/* Related Posts */}
        {relatedPosts.length > 0 && (
          <div class="py-12">
            <h3 class="font-heading text-2xl font-bold text-white mb-8">Related Articles</h3>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
              {relatedPosts.map((post) => (
                <a
                  href={`/blog/${post.slug}`}
                  class="group block rounded-xl border border-slate-800 bg-slate-900/50 overflow-hidden hover:border-primary-500/50 transition-colors"
                >
                  {post.image && (
                    <div class="aspect-video bg-slate-800 overflow-hidden">
                      <img
                        src={post.image}
                        alt={post.title}
                        class="w-full h-full object-cover transition-transform group-hover:scale-105"
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div class="p-4">
                    <h4 class="font-semibold text-white group-hover:text-primary-400 transition-colors mb-2">
                      {post.title}
                    </h4>
                    {post.description && (
                      <p class="text-sm text-slate-400 line-clamp-2">{post.description}</p>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        {/* CTA Section */}
        <div class="mt-12 p-8 rounded-2xl bg-gradient-to-br from-primary-500/10 to-secondary-500/10 border border-slate-800 text-center">
          <h3 class="font-heading text-2xl font-bold text-white mb-3">
            Ready to get started?
          </h3>
          <p class="text-slate-400 mb-6">
            Let's discuss how we can help transform your business.
          </p>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 bg-primary-500 text-white font-semibold rounded-lg hover:bg-primary-600 transition-colors"
          >
            Contact Us
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </footer>
    </div>
  </article>
</MainLayout>

<script>
  // Copy link functionality
  document.querySelectorAll('.copy-link-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-url');
      if (url) {
        try {
          await navigator.clipboard.writeText(url);
          // Visual feedback
          btn.classList.add('bg-accent-500');
          setTimeout(() => btn.classList.remove('bg-accent-500'), 1500);
        } catch (err) {
          console.error('Failed to copy link:', err);
        }
      }
    });
  });
</script>

