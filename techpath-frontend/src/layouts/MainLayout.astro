---
import Header from '@components/shared/Header.astro';
import Footer from '@components/shared/Footer.astro';
import CookieConsentBanner from '@components/shared/CookieConsentBanner.astro';
import '@styles/globals.css';
import { fetchPublicSettings } from '@services/settingsService';
import { getRobotsContent } from '@utils/seo';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
}

// Fetch settings from API (cached at edge)
const settings = await fetchPublicSettings();

const defaultDescription = settings.seo_default_description || 'TechPath - AI-Powered IT Solutions for Modern Enterprises';
const companyName = settings.company_name || 'TechPath';
const googleAnalyticsId = settings.google_analytics_id;
const gtmId = settings.gtm_id;

const {
  title,
  description = defaultDescription,
  image = '/images/og-image.jpg',
  canonicalUrl,
  noIndex = false,
} = Astro.props;

const siteUrl = import.meta.env.SITE_URL || 'https://techpath.biz';
const fullUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const fullImageUrl = new URL(image, siteUrl).toString();
const robotsContent = getRobotsContent(noIndex);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title} | {companyName}</title>
    <meta name="title" content={`${title} | ${companyName}`} />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />

    <!-- Canonical URL -->
    <link rel="canonical" href={fullUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={`${title} | ${companyName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content={companyName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={fullUrl} />
    <meta property="twitter:title" content={`${title} | ${companyName}`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageUrl} />

    <!-- Resource hints for analytics origins -->
    {(gtmId || googleAnalyticsId) && (
      <>
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
        <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
      </>
    )}

    <!-- Google Tag Manager (deferred until idle to keep main thread free for LCP) -->
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){
          function loadGTM(){
            w[l]=w[l]||[];w[l].push({'gtm.start': new Date().getTime(),event:'gtm.js'});
            var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
            j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
            f.parentNode.insertBefore(j,f);
          }
          if ('requestIdleCallback' in w) {
            w.requestIdleCallback(loadGTM, { timeout: 4000 });
          } else {
            w.addEventListener('load', function(){ setTimeout(loadGTM, 1500); });
          }
        })(window,document,'script','dataLayer',gtmId);
      </script>
    )}

    <!-- Google Analytics (deferred until idle) -->
    {googleAnalyticsId && (
      <script is:inline define:vars={{ googleAnalyticsId }}>
        (function(w,d,id){
          function loadGA(){
            var s=d.createElement('script');
            s.async=true;
            s.src='https://www.googletagmanager.com/gtag/js?id='+id;
            d.head.appendChild(s);
            w.dataLayer = w.dataLayer || [];
            function gtag(){w.dataLayer.push(arguments);}
            w.gtag = gtag;
            gtag('js', new Date());
            gtag('config', id);
          }
          if ('requestIdleCallback' in w) {
            w.requestIdleCallback(loadGA, { timeout: 4000 });
          } else {
            w.addEventListener('load', function(){ setTimeout(loadGA, 1500); });
          }
        })(window,document,googleAnalyticsId);
      </script>
    )}

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon.png" />

    <!-- Fonts (subset weights, non-blocking load with display=swap) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Schema.org JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": companyName,
      "url": siteUrl,
      "logo": `${siteUrl}/images/logo.svg`,
      "description": description,
      "sameAs": [
        settings.social_twitter,
        settings.social_linkedin,
        settings.social_facebook,
      ].filter(Boolean)
    })} />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-slate-950 font-sans text-slate-100 antialiased">
    {gtmId && (
      <noscript>
        <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0" width="0" style="display:none;visibility:hidden"></iframe>
      </noscript>
    )}
    <div class="flex min-h-screen flex-col overflow-x-clip">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
      <CookieConsentBanner />
    </div>
  </body>
</html>

<style is:global>
  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: theme('colors.slate.900');
  }

  ::-webkit-scrollbar-thumb {
    background: theme('colors.slate.700');
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: theme('colors.slate.600');
  }

  /* Selection */
  ::selection {
    background: theme('colors.primary.500 / 30%');
    color: theme('colors.primary.100');
  }
</style>

