---
/**
 * Support Page
 * Help center with resources, contact options, and documentation links
 */
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumb from '@components/shared/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Support', href: '/support', current: true },
];

const supportChannels = [
  {
    title: 'Email Support',
    description: 'Send us a detailed message and we\'ll respond within 24 hours.',
    icon: 'email',
    action: 'support@techpath.biz',
    actionType: 'email',
    availability: 'Response within 24 hours',
  },
  {
    title: 'Phone Support',
    description: 'Speak directly with our support team during business hours.',
    icon: 'phone',
    action: '+1 (555) 123-4567',
    actionType: 'phone',
    availability: 'Mon-Fri, 9AM-6PM PST',
  },
  {
    title: 'Live Chat',
    description: 'Chat with us in real-time for quick questions and assistance.',
    icon: 'chat',
    action: 'Start Chat',
    actionType: 'button',
    availability: 'Mon-Fri, 9AM-6PM PST',
  },
  {
    title: 'Schedule a Call',
    description: 'Book a time that works for you to discuss your needs.',
    icon: 'calendar',
    action: '/contact',
    actionType: 'link',
    availability: 'By appointment',
  },
];

const resources = [
  {
    title: 'Documentation',
    description: 'Technical guides and API documentation for developers.',
    href: '/docs',
    icon: 'docs',
  },
  {
    title: 'FAQ',
    description: 'Answers to frequently asked questions about our services.',
    href: '/faq',
    icon: 'faq',
  },
  {
    title: 'Blog',
    description: 'Articles, tutorials, and industry insights.',
    href: '/blog',
    icon: 'blog',
  },
  {
    title: 'Status Page',
    description: 'Check the current status of our services and infrastructure.',
    href: '#',
    icon: 'status',
  },
];

const commonIssues = [
  {
    title: 'Getting Started',
    items: [
      { text: 'How to request a project quote', href: '/contact' },
      { text: 'Understanding our development process', href: '/faq#category-3' },
      { text: 'Setting up your first consultation', href: '/contact' },
    ],
  },
  {
    title: 'Project Management',
    items: [
      { text: 'Accessing project dashboards', href: '/faq#category-3' },
      { text: 'Submitting feedback and change requests', href: '/faq#category-3' },
      { text: 'Understanding project milestones', href: '/faq#category-3' },
    ],
  },
  {
    title: 'Billing & Payments',
    items: [
      { text: 'Payment methods and terms', href: '/faq#category-1' },
      { text: 'Invoice and payment questions', href: '/contact' },
      { text: 'Subscription management', href: '/contact' },
    ],
  },
  {
    title: 'Technical Support',
    items: [
      { text: 'Reporting bugs or issues', href: '/contact' },
      { text: 'Requesting maintenance support', href: '/contact' },
      { text: 'Security concerns', href: '/contact' },
    ],
  },
];
---

<MainLayout 
  title="Support Center" 
  description="Get help with TechPath services. Access documentation, FAQs, and contact our support team."
>
  <section class="support-page py-12 lg:py-20">
    <div class="container mx-auto px-4">
      <Breadcrumb items={breadcrumbItems} />

      <header class="max-w-3xl mx-auto text-center mb-16">
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">
          How Can We Help?
        </h1>
        <p class="text-xl text-slate-400">
          Our support team is here to assist you. Choose the best way to reach us or explore our resources.
        </p>
      </header>

      <!-- Support Channels -->
      <div class="max-w-5xl mx-auto mb-20">
        <h2 class="font-heading text-2xl font-bold text-white mb-8 text-center">
          Contact Our Support Team
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {supportChannels.map((channel) => (
            <div class="support-card rounded-xl border border-slate-800 bg-slate-900/50 p-6 hover:border-primary-500/50 transition-colors">
              <div class="w-12 h-12 rounded-xl bg-primary-500/10 flex items-center justify-center mb-4">
                {channel.icon === 'email' && (
                  <svg class="w-6 h-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                )}
                {channel.icon === 'phone' && (
                  <svg class="w-6 h-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                )}
                {channel.icon === 'chat' && (
                  <svg class="w-6 h-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                  </svg>
                )}
                {channel.icon === 'calendar' && (
                  <svg class="w-6 h-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                )}
              </div>
              <h3 class="font-semibold text-white mb-2">{channel.title}</h3>
              <p class="text-sm text-slate-400 mb-4">{channel.description}</p>
              
              {channel.actionType === 'email' && (
                <a href={`mailto:${channel.action}`} class="text-primary-400 font-medium hover:underline">
                  {channel.action}
                </a>
              )}
              {channel.actionType === 'phone' && (
                <a href={`tel:${channel.action.replace(/\D/g, '')}`} class="text-primary-400 font-medium hover:underline">
                  {channel.action}
                </a>
              )}
              {channel.actionType === 'button' && (
                <button class="px-4 py-2 bg-primary-500 text-white text-sm font-medium rounded-lg hover:bg-primary-600 transition-colors">
                  {channel.action}
                </button>
              )}
              {channel.actionType === 'link' && (
                <a href={channel.action} class="inline-flex items-center gap-1 text-primary-400 font-medium hover:underline">
                  Book Now
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              )}
              
              <p class="text-xs text-slate-500 mt-3">{channel.availability}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Resources Section -->
      <div class="max-w-5xl mx-auto mb-20">
        <h2 class="font-heading text-2xl font-bold text-white mb-8 text-center">
          Self-Service Resources
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {resources.map((resource) => (
            <a 
              href={resource.href}
              class="resource-card group rounded-xl border border-slate-800 bg-slate-900/50 p-6 hover:border-primary-500/50 transition-all"
            >
              <div class="w-12 h-12 rounded-xl bg-slate-800 flex items-center justify-center mb-4 group-hover:bg-primary-500/20 transition-colors">
                {resource.icon === 'docs' && (
                  <svg class="w-6 h-6 text-slate-400 group-hover:text-primary-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                )}
                {resource.icon === 'faq' && (
                  <svg class="w-6 h-6 text-slate-400 group-hover:text-primary-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                {resource.icon === 'blog' && (
                  <svg class="w-6 h-6 text-slate-400 group-hover:text-primary-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                )}
                {resource.icon === 'status' && (
                  <svg class="w-6 h-6 text-slate-400 group-hover:text-primary-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                  </svg>
                )}
              </div>
              <h3 class="font-semibold text-white mb-2 group-hover:text-primary-400 transition-colors">
                {resource.title}
              </h3>
              <p class="text-sm text-slate-400">{resource.description}</p>
            </a>
          ))}
        </div>
      </div>

      <!-- Common Issues -->
      <div class="max-w-5xl mx-auto mb-20">
        <h2 class="font-heading text-2xl font-bold text-white mb-8 text-center">
          Quick Links
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {commonIssues.map((category) => (
            <div>
              <h3 class="font-semibold text-white mb-4">{category.title}</h3>
              <ul class="space-y-3">
                {category.items.map((item) => (
                  <li>
                    <a 
                      href={item.href} 
                      class="text-sm text-slate-400 hover:text-primary-400 transition-colors flex items-start gap-2"
                    >
                      <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                      {item.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Emergency Support -->
      <div class="max-w-3xl mx-auto">
        <div class="rounded-2xl border border-red-500/30 bg-red-500/5 p-8">
          <div class="flex flex-col md:flex-row items-center gap-6">
            <div class="flex-shrink-0">
              <div class="w-16 h-16 rounded-full bg-red-500/10 flex items-center justify-center">
                <svg class="w-8 h-8 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              </div>
            </div>
            <div class="text-center md:text-left">
              <h3 class="font-heading text-xl font-bold text-white mb-2">
                Emergency Support
              </h3>
              <p class="text-slate-400 mb-4">
                For critical production issues affecting your business, we offer 24/7 emergency support for clients with active maintenance agreements.
              </p>
              <a 
                href="mailto:emergency@techpath.biz" 
                class="inline-flex items-center gap-2 text-red-400 font-medium hover:underline"
              >
                emergency@techpath.biz
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .support-page {
    @apply bg-slate-950;
  }
</style>

