---
/**
 * Dynamic Blog Post Page
 * Renders individual blog posts with beautiful markdown styling
 */
import ArticleLayout from '@layouts/ArticleLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { calculateReadingTime } from '@utils/contentHelpers';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  allPosts: CollectionEntry<'blog'>[];
}

const { post, allPosts } = Astro.props;
const { Content } = await post.render();

// Calculate reading time if not provided
const readingTime = post.data.readingTime || calculateReadingTime(post.body);

// Get related posts (simple implementation - same tags)
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .filter((p) => p.data.tags?.some((tag) => post.data.tags?.includes(tag)))
  .slice(0, 3)
  .map((p) => ({
    slug: p.slug,
    title: p.data.title,
    description: p.data.description,
    image: p.data.image,
  }));

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: post.data.title, href: '#', current: true },
];
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  author={post.data.author}
  pubDate={post.data.pubDate}
  image={post.data.image}
  tags={post.data.tags}
  readingTime={readingTime}
  breadcrumbs={breadcrumbItems}
  relatedPosts={relatedPosts}
  showToc={true}
  showAuthorBio={true}
  showShareButtons={true}
  type="blog"
>
  <Content />
</ArticleLayout>
