---
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumb from '@components/shared/Breadcrumb.astro';
import Card from '@components/ui/Card.astro';
import { getCollection } from 'astro:content';
import { fetchBlogPosts, normalizeApiPost } from '@services/blogService';

// SSR for this page - fetches from API at request time
// Set to true for build-time generation, false for runtime SSR
export const prerender = false;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog', current: true },
];

// Get posts from both sources
const [collectionPosts, apiPosts] = await Promise.all([
  getCollection('blog'),
  fetchBlogPosts({ limit: 50 }),
]);

// Normalize API posts to match collection format
const normalizedApiPosts = apiPosts.map(normalizeApiPost);

// Combine and dedupe by slug (prefer API posts as they're more up-to-date)
const apiSlugs = new Set(normalizedApiPosts.map((p) => p.slug));
const uniqueCollectionPosts = collectionPosts.filter((p) => !apiSlugs.has(p.slug));

// Combine all posts
const allPosts = [...normalizedApiPosts, ...uniqueCollectionPosts.map((p) => ({
  ...p,
  source: 'collection' as const,
}))];

// Sort by date
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const featuredPost = sortedPosts[0];
const recentPosts = sortedPosts.slice(1, 7);
---

<MainLayout
  title="Blog"
  description="Insights, tutorials, and updates on AI, cloud computing, web development, and digital transformation from the TechPath team."
>
  <section class="py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <Breadcrumb items={breadcrumbItems} />

      <!-- Header -->
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <h1 class="mb-6 font-heading text-4xl font-bold text-white md:text-5xl lg:text-6xl">
          Our <span class="bg-gradient-to-r from-primary-400 to-secondary-400 bg-clip-text text-transparent">Blog</span>
        </h1>
        <p class="text-lg text-slate-400 md:text-xl">
          Insights, tutorials, and updates on AI, cloud computing, and modern software development.
        </p>
      </div>

      {
        featuredPost && (
          <article class="mb-16">
            <a
              href={`/blog/${featuredPost.slug}`}
              class="group relative flex flex-col overflow-hidden rounded-3xl border border-slate-800 bg-slate-900/50 md:flex-row"
            >
              <div class="aspect-video w-full md:aspect-auto md:w-1/2">
                {featuredPost.data.image ? (
                  <img
                    src={featuredPost.data.image}
                    alt={featuredPost.data.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-primary-500/20 to-secondary-500/20">
                    <span class="text-6xl text-primary-400/50">📝</span>
                  </div>
                )}
              </div>
              <div class="flex flex-1 flex-col justify-center p-8 md:p-12">
                <span class="mb-4 inline-block w-fit rounded-full bg-primary-500/10 px-3 py-1 text-sm font-medium text-primary-400">
                  Featured
                </span>
                <h2 class="mb-4 font-heading text-2xl font-bold text-white transition-colors group-hover:text-primary-400 md:text-3xl">
                  {featuredPost.data.title}
                </h2>
                <p class="mb-6 text-slate-400">{featuredPost.data.description}</p>
                <div class="flex items-center gap-4 text-sm text-slate-500">
                  <span>{featuredPost.data.author}</span>
                  <span>•</span>
                  <time datetime={featuredPost.data.pubDate.toISOString()}>
                    {new Intl.DateTimeFormat('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    }).format(featuredPost.data.pubDate)}
                  </time>
                </div>
              </div>
            </a>
          </article>
        )
      }

      <!-- Posts Grid -->
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          recentPosts.map((post) => (
            <Card
              title={post.data.title}
              description={post.data.description}
              href={`/blog/${post.slug}`}
              image={post.data.image ?? undefined}
              meta={`${post.data.author} • ${new Intl.DateTimeFormat('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              }).format(post.data.pubDate)}`}
              tags={post.data.tags}
            />
          ))
        }
      </div>

      {
        sortedPosts.length > 7 && (
          <div class="mt-12 text-center">
            <a
              href="/blog/archive"
              class="inline-flex items-center gap-2 text-primary-400 transition-colors hover:text-primary-300"
            >
              View all posts
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"
                />
              </svg>
            </a>
          </div>
        )
      }
    </div>
  </section>
</MainLayout>

