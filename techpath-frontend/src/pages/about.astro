---
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumb from '@components/shared/Breadcrumb.astro';
import StatCounter from '@components/sections/StatCounter.astro';
import CTA from '@components/shared/CTA.astro';
import { fetchAboutPageContent } from '@services/pageContentService';
import { resolveAssetImage } from '@utils/blogImages';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about', current: true },
];

const content = await fetchAboutPageContent();

// SVG icon map for values (inline SVGs keyed by icon name)
const valueIconMap: Record<string, string> = {
  trophy: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>`,
  globe: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  star: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>`,
  eye: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>`,
  lightbulb: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>`,
};
---

<MainLayout
  title={content.seo?.title ?? 'About Techpath'}
  description={content.seo?.description ?? "Techpath Research and Development Pvt Ltd — IT training institute and enterprise IT services company in Mughalsarai."}
  image={content.seo?.image ?? undefined}
  canonicalUrl={content.seo?.canonical_url ?? undefined}
  noIndex={content.seo?.no_index ?? false}
>
  <!-- ─── Hero ─────────────────────────────────────────────────────────── -->
  <section class="py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <Breadcrumb items={breadcrumbItems} />

      <div class="mx-auto mb-16 max-w-4xl text-center">
        <h1 class="mb-6 font-heading text-4xl font-bold text-white md:text-5xl lg:text-6xl">
          {content.hero.title.split(content.hero.title_highlight)[0]}
          <span class="bg-gradient-to-r from-primary-400 to-secondary-400 bg-clip-text text-transparent">
            {content.hero.title_highlight}
          </span>
          {content.hero.title.split(content.hero.title_highlight)[1] ?? ''}
        </h1>
        <p class="mx-auto max-w-3xl text-lg leading-relaxed text-slate-400 md:text-xl">
          {content.hero.subheadline}
        </p>
      </div>

      <!-- ─── Mission ─────────────────────────────────────────────────── -->
      <div class="relative mb-16 overflow-hidden rounded-3xl border border-slate-800 bg-slate-900/50 p-8 md:p-12 lg:p-16">
        <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-primary-500/10 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-secondary-500/10 blur-3xl"></div>
        <div class="relative z-10 mx-auto max-w-3xl text-center">
          <h2 class="mb-6 font-heading text-3xl font-bold text-white md:text-4xl">{content.mission_title}</h2>
          <p class="text-lg leading-relaxed text-slate-300">{content.mission_text}</p>
        </div>
      </div>

      <!-- ─── Stats ────────────────────────────────────────────────────── -->
      <StatCounter stats={content.stats} />
    </div>
  </section>

  <!-- ─── Two Arms: Academy + Services ─────────────────────────────────── -->
  {content.arms && content.arms.length > 0 && (
    <section class="py-10 lg:py-16 bg-slate-900/40">
      <div class="container mx-auto px-4">
        <h2 class="mb-3 text-center font-heading text-3xl font-bold text-white md:text-4xl">
          Two Ways We Serve You
        </h2>
        <p class="mb-10 text-center text-slate-400">
          One company. Two arms. One mission.
        </p>
        <div class="mx-auto grid max-w-5xl gap-6 lg:grid-cols-2">
          {content.arms.map((arm, i) => (
            <div class:list={[
              'relative flex flex-col overflow-hidden rounded-3xl border p-8',
              i === 0
                ? 'border-primary-500/30 bg-gradient-to-br from-primary-500/10 to-slate-900/80'
                : 'border-secondary-500/30 bg-gradient-to-br from-secondary-500/10 to-slate-900/80'
            ]}>
              <!-- Glow blob -->
              <div class:list={[
                'pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full blur-3xl',
                i === 0 ? 'bg-primary-500/15' : 'bg-secondary-500/15'
              ]}></div>

              <div class="relative z-10 flex flex-1 flex-col">
                <!-- Badge + title -->
                <div class="mb-4">
                  <span class:list={[
                    'mb-3 inline-block rounded-full px-3 py-1 text-xs font-semibold',
                    i === 0
                      ? 'bg-primary-500/15 text-primary-300'
                      : 'bg-secondary-500/15 text-secondary-300'
                  ]}>
                    {arm.subtitle}
                  </span>
                  <h3 class="font-heading text-2xl font-bold text-white">{arm.title}</h3>
                </div>

                <p class="mb-6 flex-1 text-sm leading-relaxed text-slate-400">{arm.description}</p>

                <!-- Mini stats 2×2 -->
                <div class="mb-6 grid grid-cols-2 gap-3">
                  {arm.stats.map((s) => (
                    <div class="rounded-xl border border-slate-700/60 bg-slate-900/60 px-4 py-3 text-center">
                      <div class:list={[
                        'font-heading text-xl font-bold',
                        i === 0 ? 'text-primary-400' : 'text-secondary-400'
                      ]}>{s.value}</div>
                      <div class="mt-0.5 text-xs text-slate-500">{s.label}</div>
                    </div>
                  ))}
                </div>

                <!-- CTA -->
                <a
                  href={arm.href}
                  class:list={[
                    'inline-flex items-center justify-center gap-2 rounded-xl px-5 py-2.5 text-sm font-bold transition-colors',
                    i === 0
                      ? 'bg-primary-500 text-slate-950 hover:bg-primary-400'
                      : 'bg-secondary-500 text-slate-950 hover:bg-secondary-400'
                  ]}
                >
                  {arm.cta_label}
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ─── Values ────────────────────────────────────────────────────────── -->
  <section class="py-10 lg:py-16">
    <div class="container mx-auto px-4">
      <h2 class="mb-12 text-center font-heading text-3xl font-bold text-white md:text-4xl">
        What We Stand For
      </h2>
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2 lg:grid-cols-4">
        {content.values.map((value) => (
          <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition-colors hover:border-primary-500/40">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-primary-500/20 to-secondary-500/20 text-primary-400">
              <Fragment set:html={valueIconMap[value.icon] ?? valueIconMap['star']} />
            </div>
            <h3 class="mb-2 font-heading text-lg font-bold text-white">{value.title}</h3>
            <p class="text-sm leading-relaxed text-slate-400">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Trusted By ────────────────────────────────────────────────────── -->
  {content.trusted_by && content.trusted_by.length > 0 && (
    <section class="py-10 lg:py-14 bg-slate-900/40">
      <div class="container mx-auto px-4">
        <p class="mb-8 text-center text-sm font-semibold uppercase tracking-widest text-slate-500">
          Trusted by Companies Across India
        </p>
        <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-6 md:gap-10">
          {content.trusted_by.map((client) => (
            <div class="flex h-14 w-36 items-center justify-center rounded-xl border border-slate-800 bg-slate-900/50 px-4 transition-all hover:border-slate-600">
              <img
                src={resolveAssetImage(client.logo)}
                alt={client.name}
                width="120"
                height="32"
                class="max-h-8 w-auto object-contain opacity-60 grayscale transition-all hover:opacity-100 hover:grayscale-0"
                loading="lazy"
                decoding="async"
                onerror={`this.style.display='none';this.nextElementSibling.style.display='block'`}
              />
              <span class="hidden text-xs font-medium text-slate-400">{client.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ─── Team ──────────────────────────────────────────────────────────── -->
  <section class="py-10 lg:py-16">
    <div class="container mx-auto px-4">
      <h2 class="mb-4 text-center font-heading text-3xl font-bold text-white md:text-4xl">
        Leadership Team
      </h2>
      <p class="mx-auto mb-12 max-w-2xl text-center text-slate-400">
        Senior engineers and educators — the people you'll actually work with.
      </p>
      <div class:list={[
        'mx-auto grid gap-8',
        content.team.length === 1
          ? 'max-w-sm'
          : content.team.length === 2
          ? 'max-w-2xl md:grid-cols-2'
          : 'max-w-4xl md:grid-cols-2 lg:grid-cols-3'
      ]}>
        {content.team.map((member) => (
          <div class="group rounded-2xl border border-slate-800 bg-slate-900/50 p-6 text-center transition-all hover:border-primary-500/40">
            <!-- Photo with initial fallback -->
            <div class="relative mx-auto mb-5 h-28 w-28">
              <img
                src={resolveAssetImage(member.image)}
                alt={member.name}
                width="112"
                height="112"
                class="h-28 w-28 rounded-2xl object-cover ring-2 ring-slate-700 transition-all group-hover:ring-primary-500/50"
                loading="lazy"
                decoding="async"
                onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
              />
              <div
                class="hidden h-28 w-28 items-center justify-center rounded-2xl bg-gradient-to-br from-primary-500/20 to-secondary-500/20 text-4xl font-bold text-primary-400/70 ring-2 ring-slate-700"
                aria-hidden="true"
              >
                {member.name.charAt(0)}
              </div>
            </div>
            <h3 class="mb-1 font-heading text-xl font-bold text-white">{member.name}</h3>
            <p class="mb-3 text-sm font-semibold text-primary-400">{member.role}</p>
            <p class="text-sm leading-relaxed text-slate-400">{member.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── CTA ───────────────────────────────────────────────────────────── -->
  <CTA
    title={content.cta_title}
    description={content.cta_description}
    primaryButton={{ label: content.cta_primary_label, href: content.cta_primary_href }}
    secondaryButton={{ label: content.cta_secondary_label, href: content.cta_secondary_href }}
  />
</MainLayout>
