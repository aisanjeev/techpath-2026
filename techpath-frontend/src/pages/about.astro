---
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumb from '@components/shared/Breadcrumb.astro';
import StatCounter from '@components/sections/StatCounter.astro';
import CTA from '@components/shared/CTA.astro';
import { fetchAboutPageContent } from '@services/pageContentService';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about', current: true },
];

const content = await fetchAboutPageContent();
const valueIcons: Record<string, string> = {
  lightbulb: '💡',
  trophy: '🏆',
  eye: '👁️',
  star: '⭐',
};
---

<MainLayout
  title={content.seo?.title ?? 'About Us'}
  description={content.seo?.description ?? "Learn about TechPath's mission to deliver innovative AI and IT solutions. Meet our team of experts dedicated to your success."}
  image={content.seo?.image ?? undefined}
  canonicalUrl={content.seo?.canonical_url ?? undefined}
  noIndex={content.seo?.no_index ?? false}
>
  <section class="py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <Breadcrumb items={breadcrumbItems} />

      <!-- Hero Section -->
      <div class="mx-auto mb-20 max-w-4xl text-center">
        <h1 class="mb-6 font-heading text-4xl font-bold text-white md:text-5xl lg:text-6xl">
          {content.hero.title.split(content.hero.title_highlight)[0]}
          <span class="bg-gradient-to-r from-primary-400 to-secondary-400 bg-clip-text text-transparent">
            {content.hero.title_highlight}
          </span>
          {content.hero.title.split(content.hero.title_highlight)[1] ?? ''}
        </h1>
        <p class="text-lg text-slate-400 md:text-xl">
          {content.hero.subheadline}
        </p>
      </div>

      <!-- Mission Statement -->
      <div class="relative mb-20 overflow-hidden rounded-3xl border border-slate-800 bg-slate-900/50 p-8 md:p-12 lg:p-16">
        <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-primary-500/10 blur-3xl"></div>
        <div class="absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-secondary-500/10 blur-3xl"></div>
        <div class="relative z-10 mx-auto max-w-3xl text-center">
          <h2 class="mb-6 font-heading text-3xl font-bold text-white md:text-4xl">{content.mission_title}</h2>
          <p class="text-lg leading-relaxed text-slate-300">
            {content.mission_text}
          </p>
        </div>
      </div>

      <!-- Stats -->
      <StatCounter stats={content.stats} />

      <!-- Values Section -->
      <div class="mb-20 mt-20">
        <h2 class="mb-12 text-center font-heading text-3xl font-bold text-white md:text-4xl">
          Our Values
        </h2>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
          {
            content.values.map((value) => (
              <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition-colors hover:border-primary-500/50">
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-primary-500/20 to-secondary-500/20">
                  <span class="text-2xl">{valueIcons[value.icon] ?? '•'}</span>
                </div>
                <h3 class="mb-2 font-heading text-xl font-bold text-white">{value.title}</h3>
                <p class="text-slate-400">{value.description}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Team Section -->
      <div class="mb-20">
        <h2 class="mb-4 text-center font-heading text-3xl font-bold text-white md:text-4xl">
          Leadership Team
        </h2>
        <p class="mx-auto mb-12 max-w-2xl text-center text-slate-400">
          Meet the experts behind TechPath's innovative solutions.
        </p>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
          {
            content.team.map((member) => (
              <div class="group text-center">
                <div class="mx-auto mb-4 h-40 w-40 overflow-hidden rounded-2xl bg-gradient-to-br from-primary-500/20 to-secondary-500/20 transition-transform group-hover:scale-105">
                  <div class="flex h-full w-full items-center justify-center text-4xl text-primary-400/50">
                    {member.name.charAt(0)}
                  </div>
                </div>
                <h3 class="mb-1 font-heading text-lg font-bold text-white">{member.name}</h3>
                <p class="mb-2 text-sm font-medium text-primary-400">{member.role}</p>
                <p class="text-sm text-slate-400">{member.bio}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CTA
    title={content.cta_title}
    description={content.cta_description}
    primaryButton={{ label: content.cta_primary_label, href: content.cta_primary_href }}
    secondaryButton={{ label: content.cta_secondary_label, href: content.cta_secondary_href }}
  />
</MainLayout>

