---
/**
 * Cookie Policy Page
 * Legal page explaining cookie usage on the website
 */
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumb from '@components/shared/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Cookie Policy', href: '/cookies', current: true },
];

const lastUpdated = 'December 15, 2025';
---

<MainLayout 
  title="Cookie Policy" 
  description="Learn about how TechPath uses cookies and similar technologies on our website."
>
  <article class="legal-page py-12 lg:py-20">
    <div class="container mx-auto px-4">
      <Breadcrumb items={breadcrumbItems} />

      <header class="max-w-4xl mx-auto mb-12">
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-white mb-4">
          Cookie Policy
        </h1>
        <p class="text-slate-400">
          Last updated: {lastUpdated}
        </p>
      </header>

      <div class="max-w-4xl mx-auto prose-legal">
        <section class="mb-12">
          <p class="text-lg text-slate-300 leading-relaxed">
            This Cookie Policy explains how TechPath ("we," "our," or "us") uses cookies and similar tracking technologies when you visit our website. This policy should be read alongside our <a href="/privacy" class="text-primary-400 hover:underline">Privacy Policy</a>.
          </p>
        </section>

        <section class="mb-10">
          <h2 class="text-2xl font-heading font-bold text-white mb-4 pb-3 border-b border-slate-800">
            1. What Are Cookies?
          </h2>
          <p class="text-slate-300 mb-4">
            Cookies are small text files that are stored on your device (computer, tablet, or mobile) when you visit a website. They help the website remember your preferences and provide a better user experience.
          </p>
          <p class="text-slate-300">
            Cookies can be "session cookies" (which expire when you close your browser) or "persistent cookies" (which remain on your device for a set period or until you delete them).
          </p>
        </section>

        <section class="mb-10">
          <h2 class="text-2xl font-heading font-bold text-white mb-4 pb-3 border-b border-slate-800">
            2. Types of Cookies We Use
          </h2>
          
          <div class="space-y-6">
            <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-6">
              <h3 class="text-xl font-semibold text-white mb-2">Essential Cookies</h3>
              <p class="text-slate-300 mb-2">These cookies are necessary for the website to function properly.</p>
              <ul class="list-disc pl-6 text-slate-400 space-y-1 text-sm">
                <li>Session management</li>
                <li>Security features</li>
                <li>Load balancing</li>
              </ul>
              <p class="text-xs text-slate-500 mt-2">Cannot be disabled</p>
            </div>

            <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-6">
              <h3 class="text-xl font-semibold text-white mb-2">Performance Cookies</h3>
              <p class="text-slate-300 mb-2">These cookies help us understand how visitors interact with our website.</p>
              <ul class="list-disc pl-6 text-slate-400 space-y-1 text-sm">
                <li>Page view tracking</li>
                <li>Error monitoring</li>
                <li>Performance metrics</li>
              </ul>
              <p class="text-xs text-slate-500 mt-2">Can be disabled in cookie preferences</p>
            </div>

            <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-6">
              <h3 class="text-xl font-semibold text-white mb-2">Functionality Cookies</h3>
              <p class="text-slate-300 mb-2">These cookies remember your preferences and settings.</p>
              <ul class="list-disc pl-6 text-slate-400 space-y-1 text-sm">
                <li>Language preferences</li>
                <li>Theme settings</li>
                <li>Form data</li>
              </ul>
              <p class="text-xs text-slate-500 mt-2">Can be disabled in cookie preferences</p>
            </div>

            <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-6">
              <h3 class="text-xl font-semibold text-white mb-2">Marketing Cookies</h3>
              <p class="text-slate-300 mb-2">These cookies track your activity across websites for advertising purposes.</p>
              <ul class="list-disc pl-6 text-slate-400 space-y-1 text-sm">
                <li>Ad personalization</li>
                <li>Campaign tracking</li>
                <li>Social media integration</li>
              </ul>
              <p class="text-xs text-slate-500 mt-2">Can be disabled in cookie preferences</p>
            </div>
          </div>
        </section>

        <section class="mb-10">
          <h2 class="text-2xl font-heading font-bold text-white mb-4 pb-3 border-b border-slate-800">
            3. Specific Cookies We Use
          </h2>
          
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-slate-700">
                  <th class="text-left py-3 px-4 text-white font-semibold">Cookie Name</th>
                  <th class="text-left py-3 px-4 text-white font-semibold">Type</th>
                  <th class="text-left py-3 px-4 text-white font-semibold">Duration</th>
                  <th class="text-left py-3 px-4 text-white font-semibold">Purpose</th>
                </tr>
              </thead>
              <tbody class="text-slate-300">
                <tr class="border-b border-slate-800">
                  <td class="py-3 px-4 font-mono text-xs">_session</td>
                  <td class="py-3 px-4">Essential</td>
                  <td class="py-3 px-4">Session</td>
                  <td class="py-3 px-4">Maintains user session</td>
                </tr>
                <tr class="border-b border-slate-800">
                  <td class="py-3 px-4 font-mono text-xs">_ga</td>
                  <td class="py-3 px-4">Performance</td>
                  <td class="py-3 px-4">2 years</td>
                  <td class="py-3 px-4">Google Analytics tracking</td>
                </tr>
                <tr class="border-b border-slate-800">
                  <td class="py-3 px-4 font-mono text-xs">_gid</td>
                  <td class="py-3 px-4">Performance</td>
                  <td class="py-3 px-4">24 hours</td>
                  <td class="py-3 px-4">Google Analytics user identification</td>
                </tr>
                <tr class="border-b border-slate-800">
                  <td class="py-3 px-4 font-mono text-xs">theme</td>
                  <td class="py-3 px-4">Functionality</td>
                  <td class="py-3 px-4">1 year</td>
                  <td class="py-3 px-4">Stores theme preference</td>
                </tr>
                <tr class="border-b border-slate-800">
                  <td class="py-3 px-4 font-mono text-xs">cookie_consent</td>
                  <td class="py-3 px-4">Essential</td>
                  <td class="py-3 px-4">1 year</td>
                  <td class="py-3 px-4">Stores cookie preferences</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="mb-10">
          <h2 class="text-2xl font-heading font-bold text-white mb-4 pb-3 border-b border-slate-800">
            4. Third-Party Cookies
          </h2>
          <p class="text-slate-300 mb-4">
            Some cookies on our website are set by third-party services. These include:
          </p>
          <ul class="list-disc pl-6 text-slate-300 space-y-2">
            <li><strong class="text-white">Google Analytics:</strong> Website analytics and performance tracking</li>
            <li><strong class="text-white">Google Tag Manager:</strong> Tag management for marketing tools</li>
            <li><strong class="text-white">LinkedIn:</strong> Social sharing and advertising</li>
            <li><strong class="text-white">Twitter:</strong> Social sharing functionality</li>
            <li><strong class="text-white">HubSpot:</strong> Marketing automation and CRM</li>
          </ul>
          <p class="text-slate-300 mt-4">
            Please refer to these third parties' privacy policies for more information about their cookie practices.
          </p>
        </section>

        <section class="mb-10">
          <h2 class="text-2xl font-heading font-bold text-white mb-4 pb-3 border-b border-slate-800">
            5. Managing Cookies
          </h2>
          <p class="text-slate-300 mb-4">
            You can control and manage cookies in several ways:
          </p>
          
          <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Browser Settings</h3>
          <p class="text-slate-300 mb-4">
            Most browsers allow you to control cookies through their settings. Here's how to manage cookies in popular browsers:
          </p>
          <ul class="list-disc pl-6 text-slate-300 space-y-2 mb-6">
            <li><a href="https://support.google.com/chrome/answer/95647" target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:underline">Google Chrome</a></li>
            <li><a href="https://support.mozilla.org/en-US/kb/cookies-information-websites-store-on-your-computer" target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:underline">Mozilla Firefox</a></li>
            <li><a href="https://support.apple.com/guide/safari/manage-cookies-sfri11471/mac" target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:underline">Safari</a></li>
            <li><a href="https://support.microsoft.com/en-us/microsoft-edge/delete-cookies-in-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a29ae09" target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:underline">Microsoft Edge</a></li>
          </ul>

          <h3 class="text-xl font-semibold text-slate-200 mt-6 mb-3">Opt-Out Tools</h3>
          <p class="text-slate-300 mb-4">
            You can opt out of certain third-party cookies using these tools:
          </p>
          <ul class="list-disc pl-6 text-slate-300 space-y-2">
            <li><a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:underline">Google Analytics Opt-out Browser Add-on</a></li>
            <li><a href="https://optout.networkadvertising.org/" target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:underline">Network Advertising Initiative Opt-out</a></li>
            <li><a href="https://www.youronlinechoices.com/" target="_blank" rel="noopener noreferrer" class="text-primary-400 hover:underline">Your Online Choices (EU)</a></li>
          </ul>
        </section>

        <section class="mb-10">
          <h2 class="text-2xl font-heading font-bold text-white mb-4 pb-3 border-b border-slate-800">
            6. Impact of Disabling Cookies
          </h2>
          <p class="text-slate-300">
            If you choose to disable cookies, some features of our website may not function properly. Essential cookies cannot be disabled as they are necessary for the website to work. Disabling other cookies may affect your experience, including personalization features and analytics.
          </p>
        </section>

        <section class="mb-10">
          <h2 class="text-2xl font-heading font-bold text-white mb-4 pb-3 border-b border-slate-800">
            7. Updates to This Policy
          </h2>
          <p class="text-slate-300">
            We may update this Cookie Policy from time to time. Any changes will be posted on this page with an updated revision date. We encourage you to review this policy periodically.
          </p>
        </section>

        <section class="mb-10">
          <h2 class="text-2xl font-heading font-bold text-white mb-4 pb-3 border-b border-slate-800">
            8. Contact Us
          </h2>
          <p class="text-slate-300 mb-4">
            If you have any questions about our use of cookies, please contact us:
          </p>
          <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-6">
            <p class="text-slate-300 mb-2"><strong class="text-white">TechPath</strong></p>
            <p class="text-slate-400">Email: <a href="mailto:privacy@techpath.biz" class="text-primary-400 hover:underline">privacy@techpath.biz</a></p>
            <p class="text-slate-400">Phone: +1 (555) 123-4567</p>
          </div>
        </section>
      </div>
    </div>
  </article>
</MainLayout>

<style>
  .legal-page {
    @apply bg-slate-950;
  }

  .prose-legal p {
    @apply leading-relaxed;
  }
</style>

