---
import MainLayout from '@layouts/MainLayout.astro';
---

<MainLayout title="Page Not Found | TechPath" description="The page you're looking for doesn't exist.">
  <section class="flex min-h-[60vh] flex-col items-center justify-center px-4 py-20 text-center">
    <p class="text-8xl font-extrabold text-teal-600">404</p>
    <h1 class="mt-4 text-3xl font-bold text-gray-900 sm:text-4xl">Page Not Found</h1>
    <p class="mt-4 max-w-md text-lg text-gray-600">
      Sorry, the page you're looking for doesn't exist or has been moved.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="/"
        class="rounded-lg bg-teal-600 px-6 py-3 font-semibold text-white shadow hover:bg-teal-700 transition-colors"
      >
        Go Home
      </a>
      <a
        href="/training"
        class="rounded-lg border border-teal-600 px-6 py-3 font-semibold text-teal-600 hover:bg-teal-50 transition-colors"
      >
        Browse Courses
      </a>
    </div>
  </section>
</MainLayout>
