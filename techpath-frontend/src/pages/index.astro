---
import MainLayout from '@layouts/MainLayout.astro';
import HeroSection from '@components/sections/HeroSection.astro';
import FeaturesGrid from '@components/sections/FeaturesGrid.astro';
import ServiceShowcase from '@components/sections/ServiceShowcase.astro';
import CaseStudyShowcase from '@components/sections/CaseStudyShowcase.astro';
import Testimonials from '@components/sections/Testimonials.astro';
import StatCounter from '@components/sections/StatCounter.astro';
import FAQSection from '@components/sections/FAQSection.astro';
import CTA from '@components/shared/CTA.astro';
import { fetchHomePageContent } from '@services/pageContentService';
import { fetchCaseStudies, normalizeCaseStudy } from '@services/caseStudyService';
import { fetchServices } from '@services/serviceService';

const content = await fetchHomePageContent();
const caseStudiesSection = content.case_studies_section ?? {
  section_title: 'Featured Case Studies',
  section_subtitle: "Real stories of digital transformation. See how we've helped businesses achieve measurable results.",
  limit: 6,
  view_all_label: 'View All Case Studies',
  view_all_href: '/case-studies',
};

// Fetch dynamic services from API
const apiServices = await fetchServices();
const dynamicServices = apiServices
  .filter((s) => s.featured && s.is_active)
  .slice(0, 4)
  .map((s) => ({
    title: s.title,
    description: s.short_description || s.description.replace(/<[^>]+>/g, '').slice(0, 150),
    icon: s.icon || 'code',
    href: `/services/${s.slug}`,
  }));

// Use dynamic services if available, fallback to content.services
const services = dynamicServices.length > 0 ? dynamicServices : content.services;

const apiCaseStudies = await fetchCaseStudies({
  limit: caseStudiesSection.limit ?? 6,
  featured: true,
});
const caseStudies = apiCaseStudies.map(normalizeCaseStudy);
---

<MainLayout
  title={content.seo?.title ?? 'AI-Powered IT Solutions'}
  description={content.seo?.description ?? 'TechPath delivers enterprise-grade AI solutions, cloud infrastructure, and custom software development for modern businesses.'}
  image={content.seo?.image ?? undefined}
  canonicalUrl={content.seo?.canonical_url ?? undefined}
  noIndex={content.seo?.no_index ?? false}
>
  <HeroSection hero={content.hero} />

  <StatCounter stats={content.stats} />

  <ServiceShowcase services={services} />

  <CaseStudyShowcase
    caseStudies={caseStudies}
    title={caseStudiesSection.section_title}
    subtitle={caseStudiesSection.section_subtitle}
    viewAllLabel={caseStudiesSection.view_all_label}
    viewAllHref={caseStudiesSection.view_all_href}
  />

  <FeaturesGrid features={content.features} />

  <Testimonials testimonials={content.testimonials} />

  <FAQSection faqs={content.faqs} />

  <CTA
    title={content.cta.title}
    description={content.cta.description}
    primaryButton={{ label: content.cta.primary_label, href: content.cta.primary_href }}
    secondaryButton={{ label: content.cta.secondary_label, href: content.cta.secondary_href }}
  />
</MainLayout>

