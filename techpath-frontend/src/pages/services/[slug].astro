---
/**
 * Service detail page – data from API (GET /api/v1/services/{slug}).
 * Renders hero, trust bar, description (HTML), flexible engagement, case studies, FAQ, and value-based CTA. No pricing shown.
 */
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumb from '@components/shared/Breadcrumb.astro';
import ServiceHero from './_components/ServiceHero.astro';
import ServiceCTA from './_components/ServiceCTA.astro';
import FlexibleEngagement from './_components/FlexibleEngagement.astro';
import TrustBadges from '@components/sections/TrustBadges.astro';
import FAQSection from '@components/sections/FAQSection.astro';
import { fetchServiceBySlug } from '@services/serviceService';
import { fetchCaseStudies, normalizeCaseStudy } from '@services/caseStudyService';
import '@styles/markdown.css';

export const prerender = false;

const slug = Astro.params.slug;
if (!slug) {
  return Astro.redirect('/404');
}

const [service, apiCaseStudies] = await Promise.all([
  fetchServiceBySlug(slug),
  fetchCaseStudies({ limit: 3 }),
]);

if (!service) {
  return Astro.redirect('/404');
}

const iconKeys = ['brain', 'cloud', 'code', 'chart', 'shield', 'transform'];
const heroIcon = service.icon && iconKeys.includes(service.icon) ? service.icon : 'code';
const heroDescription =
  service.short_description ||
  (typeof service.description === 'string'
    ? service.description.replace(/<[^>]+>/g, '').slice(0, 400)
    : '');

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: service.title, href: '#', current: true },
];

const caseStudies = apiCaseStudies.map(normalizeCaseStudy);

// Use dynamic FAQs from service, or fallback to default
const serviceFaqs = service.faqs && service.faqs.length > 0 ? service.faqs : [
  { question: 'How long does implementation take?', answer: 'Timeline depends on scope. We typically deliver proof-of-concept in 4–8 weeks and full implementation in 2–6 months. We\'ll provide a detailed timeline during your free consultation.' },
  { question: 'What if we don\'t have clean data?', answer: 'We help assess your data and can include data cleaning and preparation as part of the project. Many clients start with imperfect data—we build pipelines and processes to improve it.' },
  { question: 'Do you provide training for our team?', answer: 'Yes. We include knowledge transfer and training as part of our engagements so your team can maintain and extend the solution.' },
  { question: 'What\'s included in ongoing support?', answer: 'Support options include monitoring, bug fixes, performance optimization, and periodic retraining. We\'ll tailor a support plan to your needs during the consultation.' },
  { question: 'Can we start with a pilot project?', answer: 'Absolutely. Many clients begin with a focused pilot to validate value before scaling. We\'ll define success metrics and a clear path to expansion.' },
  { question: 'How do you ensure data security?', answer: 'We follow industry best practices: encryption in transit and at rest, access controls, and compliance with your security requirements (SOC 2, HIPAA, etc.). We can sign NDAs and security addendums.' },
];
---

<MainLayout
  title={service.meta_title || service.title}
  description={service.meta_description || heroDescription || service.title}
  image={service.og_image || service.image_url || undefined}
  canonicalUrl={service.canonical_url || undefined}
  noIndex={service.no_index || false}
>
  <article class="service-page py-12 lg:py-20">
    <div class="container mx-auto px-4">
      <Breadcrumb items={breadcrumbItems} />

      <ServiceHero
        title={service.title}
        description={heroDescription}
        icon={heroIcon}
        features={service.features ?? []}
      />

      <TrustBadges />

      <!-- Main content (HTML from admin) -->
      {service.description && (
        <div class="mx-auto mt-12 max-w-4xl">
          <div class="markdown-content" set:html={service.description} />
        </div>
      )}

      <FlexibleEngagement />

      <!-- Case studies -->
      <div class="mx-auto mt-20 max-w-6xl">
        <h2 class="mb-10 text-center font-heading text-3xl font-bold text-white">
          Success Stories
        </h2>
        {caseStudies.length > 0 ? (
          <div class="grid gap-8 md:grid-cols-3">
            {
              caseStudies.map((study) => (
                <a
                  href={study.href}
                  class="group flex flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/50 transition-colors hover:border-primary-500/50 hover:bg-slate-900"
                >
                  {study.image ? (
                    <div class="aspect-video overflow-hidden">
                      <img
                        src={study.image}
                        alt={study.title}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  ) : (
                    <div class="flex aspect-video items-center justify-center bg-gradient-to-br from-primary-500/20 to-secondary-500/20">
                      <span class="text-4xl text-primary-400/50">📊</span>
                    </div>
                  )}
                  <div class="flex flex-1 flex-col p-6">
                    <h3 class="mb-2 font-heading text-lg font-semibold text-white transition-colors group-hover:text-primary-400">
                      {study.title}
                    </h3>
                    <p class="mb-4 line-clamp-2 text-sm text-slate-400">
                      {study.description}
                    </p>
                    {study.stats.value && (
                      <p class="mt-auto text-sm font-medium text-primary-400">
                        {study.stats.value} {study.stats.label}
                      </p>
                    )}
                  </div>
                </a>
              ))
            }
          </div>
          <div class="mt-10 text-center">
            <a
              href="/case-studies"
              class="inline-flex items-center gap-2 font-medium text-primary-400 transition-colors hover:text-primary-300"
            >
              See All Case Studies
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        ) : (
          <p class="text-center text-slate-400">No case studies yet. <a href="/case-studies" class="text-primary-400 hover:underline">View case studies</a> when available.</p>
        )}
      </div>

      <!-- FAQ -->
      <div class="mx-auto mt-20 max-w-4xl">
        <h2 class="mb-10 text-center font-heading text-3xl font-bold text-white">
          Frequently Asked Questions
        </h2>
        <FAQSection faqs={serviceFaqs} />
      </div>

      <ServiceCTA
        title={service.title}
        cta={service.cta_text}
      />
    </div>
  </article>
</MainLayout>

<style>
  .service-page {
    @apply bg-slate-950;
  }
</style>
