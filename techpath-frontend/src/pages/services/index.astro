---
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumb from '@components/shared/Breadcrumb.astro';
import ServiceCard from './_components/ServiceCard.astro';
import CTA from '@components/shared/CTA.astro';
import { fetchServicesPageContent } from '@services/pageContentService';
import { fetchServices } from '@services/serviceService';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services', current: true },
];

const [content, apiServices] = await Promise.all([
  fetchServicesPageContent(),
  fetchServices(),
]);

const iconKeys = ['brain', 'cloud', 'code', 'chart', 'shield', 'transform'];
const services = apiServices.map((s, i) => ({
  title: s.title,
  slug: s.slug,
  description: s.short_description || s.description.replace(/<[^>]+>/g, '').slice(0, 200),
  icon: s.icon && iconKeys.includes(s.icon) ? s.icon : iconKeys[i % iconKeys.length],
  features: s.features ?? [],
}));
---

<MainLayout
  title={content.seo?.title ?? 'Our Services'}
  description={content.seo?.description ?? "Explore TechPath's comprehensive IT services including AI solutions, cloud infrastructure, web development, and data analytics."}
  image={content.seo?.image ?? undefined}
  canonicalUrl={content.seo?.canonical_url ?? undefined}
  noIndex={content.seo?.no_index ?? false}
>
  <section class="py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <Breadcrumb items={breadcrumbItems} />

      <!-- Header -->
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <h1 class="mb-6 font-heading text-4xl font-bold text-white md:text-5xl lg:text-6xl">
          {content.hero.title.split(content.hero.title_highlight)[0]}
          <span class="bg-gradient-to-r from-primary-400 to-secondary-400 bg-clip-text text-transparent">
            {content.hero.title_highlight}
          </span>
          {content.hero.title.split(content.hero.title_highlight)[1] ?? ''}
        </h1>
        <p class="text-lg text-slate-400 md:text-xl">
          {content.hero.subheadline}
        </p>
      </div>

      <!-- Services Grid -->
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
    </div>
  </section>

  <CTA
    title={content.cta_title}
    description={content.cta_description}
    primaryButton={{ label: content.cta_primary_label, href: content.cta_primary_href }}
    secondaryButton={{ label: content.cta_secondary_label, href: content.cta_secondary_href }}
  />
</MainLayout>

