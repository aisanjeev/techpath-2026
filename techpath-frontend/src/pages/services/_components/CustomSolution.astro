---
// "Need a Custom Solution?" section — matches design mockup
---

<section class="py-20 lg:py-28">
  <div class="container mx-auto px-4">
    <div class="overflow-hidden rounded-3xl border border-slate-700/60 bg-[#0d1117]">

      <!-- Terminal chrome bar -->
      <div class="flex items-center justify-between border-b border-slate-700/60 px-6 py-3.5">
        <div class="flex items-center gap-4">
          <div class="flex gap-2">
            <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
            <span class="h-3 w-3 rounded-full bg-amber-400/80"></span>
            <span class="h-3 w-3 rounded-full bg-emerald-500/80"></span>
          </div>
          <span class="font-mono text-xs tracking-widest text-slate-500">CUSTOM_ENGAGEMENT.CONFIG</span>
        </div>
        <span class="inline-flex items-center gap-2 text-xs text-slate-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Available · responding within 4h
        </span>
      </div>

      <!-- Body: full width -->
      <div>

        <!-- ── CONTENT ── -->
        <div class="flex flex-col justify-between gap-8 p-8 md:p-12">
          <div>
            <!-- Eyebrow -->
            <div class="inline-flex items-center gap-2 rounded-full border border-slate-600/60 bg-slate-800/60 px-4 py-1.5 text-xs font-semibold tracking-[0.15em] text-slate-300">
              <svg class="h-3.5 w-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              CUSTOM IS OUR DEFAULT
            </div>

            <!-- Heading -->
            <h2 class="mt-6 font-heading text-4xl font-bold leading-tight text-white md:text-5xl">
              Don't fit the packages?<br />
              <span class="text-slate-300">Good.</span>
            </h2>

            <p class="mt-5 max-w-md text-[16px] leading-[1.65] text-slate-400">
              Most of our best work doesn't fit a tier. Tell us your constraints and we'll architect the engagement around them — not the other way around.
            </p>

            <!-- Flexible on tags -->
            <div class="mt-7">
              <p class="mb-3 text-xs font-semibold tracking-[0.18em] text-slate-500 uppercase">Flexible on</p>
              <div class="flex flex-wrap gap-2">
                {['Team size', 'Timeline', 'Tech stack', 'Pricing model', 'Engagement type', 'IP terms'].map((tag) => (
                  <span class="rounded-full border border-slate-600/60 bg-slate-800/40 px-4 py-1.5 text-sm text-slate-300">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- CTAs -->
          <div class="flex flex-col gap-3 sm:flex-row">
            <a
              href="/contact"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-violet-500"
            >
              Start a custom scope
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a
              href="/services"
              class="inline-flex items-center justify-center rounded-xl border border-slate-600 px-6 py-3.5 text-sm font-medium text-slate-300 transition-colors hover:border-slate-500 hover:text-white"
            >
              Compare packages
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
