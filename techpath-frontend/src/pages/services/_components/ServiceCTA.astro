---
interface Props {
  title: string;
  cta: string;
}

const { title, cta } = Astro.props;
---

<section class="mx-auto mt-20 max-w-4xl">
  <div
    class="relative overflow-hidden rounded-3xl border border-slate-800 bg-gradient-to-br from-slate-900 to-slate-800 p-8 md:p-12"
  >
    <!-- Background decoration -->
    <div
      class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-primary-500/10 blur-3xl"
    >
    </div>
    <div
      class="absolute -bottom-20 -left-20 h-64 w-64 rounded-full bg-secondary-500/10 blur-3xl"
    >
    </div>

    <div class="relative z-10 text-center">
      <h2 class="mb-4 font-heading text-3xl font-bold text-white md:text-4xl">
        Ready to get started with {title}?
      </h2>

      <p class="mb-4 text-lg text-slate-400">
        {cta}
      </p>

      <div class="mb-6">
        <p class="text-lg text-slate-300">
          Every business is unique. We create custom solutions tailored to your specific needs and budget.
        </p>
        <p class="mt-2 text-sm text-slate-400">
          Schedule a free consultation to discuss your project.
        </p>
      </div>

      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-primary-500 to-primary-600 px-8 py-4 font-semibold text-white transition-all hover:from-primary-600 hover:to-primary-700 hover:shadow-lg hover:shadow-primary-500/25"
        >
          Schedule Free Consultation
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>

        <a
          href="/case-studies"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-700 bg-slate-800/50 px-8 py-4 font-semibold text-white transition-all hover:border-slate-600 hover:bg-slate-800"
        >
          View Case Studies
        </a>
      </div>
    </div>
  </div>
</section>

