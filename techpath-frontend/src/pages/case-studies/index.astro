---
/**
 * Case Studies Listing Page
 * Fetches case studies from FastAPI backend
 */
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumb from '@components/shared/Breadcrumb.astro';
import CTA from '@components/shared/CTA.astro';
import { fetchCaseStudies, normalizeCaseStudy } from '@services/caseStudyService';

// Server-render this page to fetch from API
export const prerender = false;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Case Studies', href: '/case-studies', current: true },
];

// Fetch case studies from API
const apiCaseStudies = await fetchCaseStudies({ limit: 20 });
const caseStudies = apiCaseStudies.map(normalizeCaseStudy);
---

<MainLayout
  title="Case Studies"
  description="Explore how TechPath has helped businesses transform with AI, cloud, and modern software solutions. Real results from real projects."
>
  <section class="py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <Breadcrumb items={breadcrumbItems} />

      <!-- Header -->
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <h1 class="mb-6 font-heading text-4xl font-bold text-white md:text-5xl lg:text-6xl">
          Case <span class="bg-gradient-to-r from-primary-400 to-secondary-400 bg-clip-text text-transparent">Studies</span>
        </h1>
        <p class="text-lg text-slate-400 md:text-xl">
          Real stories of digital transformation. See how we've helped businesses achieve
          measurable results with innovative technology solutions.
        </p>
      </div>

      {caseStudies.length === 0 ? (
        <div class="text-center py-16">
          <p class="text-slate-400 text-lg">No case studies available yet. Check back soon!</p>
        </div>
      ) : (
        <!-- Case Studies Grid -->
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {
            caseStudies.map((study) => (
              <a
                href={study.href}
                class="group flex flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/50 transition-all hover:border-primary-500/50 hover:bg-slate-900"
              >
                <div class="relative aspect-video overflow-hidden">
                  {study.image ? (
                    <img 
                      src={study.image} 
                      alt={study.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-primary-500/20 to-secondary-500/20">
                      <span class="text-4xl text-primary-400/50">📊</span>
                    </div>
                  )}
                  {study.stats.value && (
                    <div class="absolute bottom-4 left-4 rounded-lg bg-slate-900/90 px-3 py-2 backdrop-blur-sm">
                      <span class="text-2xl font-bold text-white">{study.stats.value}</span>
                      <span class="ml-2 text-sm text-slate-400">{study.stats.label}</span>
                    </div>
                  )}
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <div class="mb-3 flex flex-wrap gap-2">
                    {study.tags.map((tag) => (
                      <span class="rounded-full bg-primary-500/10 px-2 py-1 text-xs font-medium text-primary-400">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <h3 class="mb-2 font-heading text-xl font-bold text-white transition-colors group-hover:text-primary-400">
                    {study.title}
                  </h3>
                  <p class="mb-2 text-sm text-slate-500">{study.clientName} • {study.industry}</p>
                  <p class="mb-4 flex-1 text-slate-400">{study.description}</p>
                  <div class="flex items-center gap-2 text-sm font-medium text-primary-400">
                    Read Case Study
                    <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      )}
    </div>
  </section>

  <CTA
    title="Ready to Be Our Next Success Story?"
    description="Let's discuss how we can help achieve your business goals."
    primaryButton={{ label: 'Start Your Project', href: '/contact' }}
    secondaryButton={{ label: 'View Services', href: '/services' }}
  />
</MainLayout>

