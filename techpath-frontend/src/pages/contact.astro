---
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumb from '@components/shared/Breadcrumb.astro';
import ContactForm from '@components/sections/ContactForm.astro';
import { fetchContactPageContent } from '@services/pageContentService';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact', current: true },
];

const content = await fetchContactPageContent();
---

<MainLayout
  title={content.seo?.title ?? 'Contact Us'}
  description={content.seo?.description ?? "Get in touch with TechPath. We'd love to discuss your project and how we can help transform your business with AI-powered solutions."}
  image={content.seo?.image ?? undefined}
  canonicalUrl={content.seo?.canonical_url ?? undefined}
  noIndex={content.seo?.no_index ?? false}
>
  <section class="py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <Breadcrumb items={breadcrumbItems} />

      <!-- Header -->
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <h1 class="mb-6 font-heading text-4xl font-bold text-white md:text-5xl lg:text-6xl">
          {content.hero.title.split(content.hero.title_highlight)[0]}
          <span class="bg-gradient-to-r from-primary-400 to-secondary-400 bg-clip-text text-transparent">
            {content.hero.title_highlight}
          </span>
          {content.hero.title.split(content.hero.title_highlight)[1] ?? ''}
        </h1>
        <p class="text-lg text-slate-400 md:text-xl">
          {content.hero.subheadline}
        </p>
      </div>

      <!-- Contact Methods -->
      <div class="mx-auto mb-16 grid max-w-4xl gap-6 md:grid-cols-3">
        {
          content.contact_methods.map((method) => (
            <a
              href={method.href}
              class="group flex flex-col items-center rounded-2xl border border-slate-800 bg-slate-900/50 p-6 text-center transition-all hover:border-primary-500/50 hover:bg-slate-900"
            >
              <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-to-br from-primary-500/20 to-secondary-500/20 transition-transform group-hover:scale-110">
                {method.icon === 'email' && (
                  <svg class="h-7 w-7 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                )}
                {method.icon === 'phone' && (
                  <svg class="h-7 w-7 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                )}
                {method.icon === 'location' && (
                  <svg class="h-7 w-7 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                )}
              </div>
              <h3 class="mb-1 font-heading text-lg font-bold text-white">{method.title}</h3>
              <p class="mb-2 text-sm text-slate-500">{method.description}</p>
              <span class="font-medium text-primary-400 transition-colors group-hover:text-primary-300">
                {method.value}
              </span>
            </a>
          ))
        }
      </div>

      <!-- Contact Form -->
      <div class="mx-auto max-w-2xl">
        <div class="rounded-3xl border border-slate-800 bg-slate-900/50 p-8 md:p-12">
          <h2 class="mb-2 text-center font-heading text-2xl font-bold text-white">
            Send us a message
          </h2>
          <p class="mb-8 text-center text-slate-400">
            Fill out the form below and we'll get back to you within 24 hours.
          </p>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</MainLayout>

