---
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumb from '@components/shared/Breadcrumb.astro';
import ContactForm from '@components/sections/ContactForm.astro';
import { fetchContactPageContent } from '@services/pageContentService';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact', current: true },
];

const content = await fetchContactPageContent();

// LocalBusiness schema.org data
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Techpath Research and Development Pvt Ltd",
  "url": "https://techpath.biz",
  "telephone": "+918299708052",
  "email": "info@techpath.biz",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Circus Road",
    "addressLocality": "Mughalsarai",
    "addressRegion": "Uttar Pradesh",
    "postalCode": "232101",
    "addressCountry": "IN"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "09:00",
      "closes": "19:00"
    }
  ],
  "sameAs": ["https://wa.me/918299708052"],
  "hasMap": "https://share.google/orP0Vj2FvrJEvLSSW"
};
---

<MainLayout
  title={content.seo?.title ?? 'Contact Techpath'}
  description={content.seo?.description ?? "Contact Techpath — IT training in Mughalsarai and enterprise IT services. Free demo class for students. Free strategy call for businesses."}
  image={content.seo?.image ?? undefined}
  canonicalUrl={content.seo?.canonical_url ?? undefined}
  noIndex={content.seo?.no_index ?? false}
>
  <!-- LocalBusiness JSON-LD in head slot -->
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- ─── Hero ─────────────────────────────────────────────────────────── -->
  <section class="pt-12 pb-0 lg:pt-16">
    <div class="container mx-auto px-4">
      <Breadcrumb items={breadcrumbItems} />

      <div class="mx-auto mb-8 max-w-3xl text-center">
        <h1 class="mb-4 font-heading text-4xl font-bold text-white md:text-5xl">
          {content.hero.title.split(content.hero.title_highlight)[0]}
          <span class="bg-gradient-to-r from-primary-400 to-secondary-400 bg-clip-text text-transparent">
            {content.hero.title_highlight}
          </span>
          {content.hero.title.split(content.hero.title_highlight)[1] ?? ''}
        </h1>
        <p class="mb-6 text-lg text-slate-400">
          {content.hero.subheadline}
        </p>
        <!-- Badges -->
        {content.hero.badges && content.hero.badges.length > 0 && (
          <div class="flex flex-wrap justify-center gap-2">
            {content.hero.badges.map((badge) => (
              <a
                href={badge.href}
                target={badge.href.startsWith('http') ? '_blank' : undefined}
                rel={badge.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center rounded-full border border-slate-700 bg-slate-800/60 px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:border-primary-500/50 hover:text-primary-300"
              >
                {badge.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ─── Contact Tabs: Academy / Services ─────────────────────────────── -->
  <section class="py-10 lg:py-14">
    <div class="container mx-auto px-4">
      <!-- Tab buttons -->
      <div class="mx-auto mb-8 flex max-w-lg overflow-hidden rounded-2xl border border-slate-700 bg-slate-900 p-1" role="tablist">
        {content.contact_tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            data-contact-tab={tab.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            class:list={[
              'contact-tab-btn flex-1 rounded-xl px-4 py-2.5 text-sm font-semibold transition-all',
              i === 0 ? 'bg-primary-500 text-slate-950' : 'text-slate-400 hover:text-slate-200'
            ]}
          >
            {tab.label}
          </button>
        ))}
      </div>

      <!-- Tab panels -->
      {content.contact_tabs.map((tab, i) => (
        <div
          data-contact-panel={tab.id}
          class:list={['contact-panel mx-auto max-w-5xl', i !== 0 ? 'hidden' : '']}
          role="tabpanel"
        >
          <div class="grid gap-8 lg:grid-cols-2">
            <!-- Left: CTA -->
            <div class="flex flex-col justify-center rounded-2xl border border-slate-800 bg-slate-900/50 p-8">
              <h2 class="mb-2 font-heading text-2xl font-bold text-white lg:text-3xl">{tab.headline}</h2>
              <p class="mb-6 text-slate-400">{tab.subtext}</p>
              <div class="flex flex-col gap-3 sm:flex-row">
                <a
                  href={tab.cta_primary.href}
                  class="flex-1 rounded-xl bg-primary-500 px-5 py-3 text-center text-sm font-bold text-slate-950 transition-colors hover:bg-primary-400"
                >
                  {tab.cta_primary.label}
                </a>
                <a
                  href={tab.cta_secondary.href}
                  class="flex-1 rounded-xl border border-slate-600 px-5 py-3 text-center text-sm font-semibold text-slate-300 transition-colors hover:border-slate-400 hover:text-white"
                >
                  {tab.cta_secondary.label}
                </a>
              </div>
              <p class="mt-4 rounded-lg bg-primary-500/10 px-4 py-2.5 text-center text-xs font-medium text-primary-300">
                {tab.urgency}
              </p>
            </div>

            <!-- Right: Social proof -->
            <div class="flex flex-col gap-4">
              <!-- Stats grid -->
              {tab.id === 'academy' && content.social_proof.academy.stats.length > 0 && (
                <div class="grid grid-cols-2 gap-4">
                  {content.social_proof.academy.stats.map((s) => (
                    <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-5 text-center">
                      <div class="font-heading text-2xl font-bold text-primary-400">{s.value}</div>
                      <div class="mt-1 text-sm text-slate-400">{s.label}</div>
                    </div>
                  ))}
                </div>
              )}
              {tab.id === 'services' && content.social_proof.services.stats.length > 0 && (
                <div class="grid grid-cols-2 gap-4">
                  {content.social_proof.services.stats.map((s) => (
                    <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-5 text-center">
                      <div class="font-heading text-2xl font-bold text-secondary-400">{s.value}</div>
                      <div class="mt-1 text-sm text-slate-400">{s.label}</div>
                    </div>
                  ))}
                </div>
              )}
              <!-- Head of Solutions card (services only) -->
              {tab.id === 'services' && content.social_proof.services.head_of_solutions && (
                <div class="flex items-start gap-4 rounded-xl border border-slate-700 bg-slate-900/50 p-5">
                  <img
                    src={content.social_proof.services.head_of_solutions.image}
                    alt={content.social_proof.services.head_of_solutions.name}
                    width="56"
                    height="56"
                    class="h-14 w-14 flex-shrink-0 rounded-full object-cover ring-2 ring-secondary-500/40"
                    onerror="this.setAttribute('src','/images/avatar-placeholder.jpg')"
                  />
                  <div>
                    <div class="font-semibold text-white">{content.social_proof.services.head_of_solutions.name}</div>
                    <div class="mb-2 text-xs text-slate-500">{content.social_proof.services.head_of_solutions.role}</div>
                    <blockquote class="border-l-2 border-secondary-500/50 pl-3 text-sm italic text-slate-400">
                      "{content.social_proof.services.head_of_solutions.quote}"
                    </blockquote>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── Contact Methods ───────────────────────────────────────────────── -->
  <section class="py-10 lg:py-14 bg-slate-900/30">
    <div class="container mx-auto px-4">
      <h2 class="mb-8 text-center font-heading text-2xl font-bold text-white">
        Get in Touch Directly
      </h2>
      <div class="mx-auto grid max-w-5xl gap-5 md:grid-cols-3">
        {content.contact_methods.map((method) => (
          <div class="group flex flex-col rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition-all hover:border-primary-500/40 hover:bg-slate-900">
            <!-- Icon -->
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-primary-500/20 to-secondary-500/20">
              {method.icon === 'phone' && (
                <svg class="h-6 w-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              )}
              {method.icon === 'email' && (
                <svg class="h-6 w-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
              {method.icon === 'location' && (
                <svg class="h-6 w-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              )}
            </div>

            <h3 class="mb-1 font-heading text-lg font-bold text-white">{method.title}</h3>
            <p class="mb-3 text-sm text-slate-500">{method.description}</p>
            <a href={method.href} class="font-medium text-primary-400 transition-colors hover:text-primary-300 break-words">
              {method.value}
            </a>

            {method.landmark && (
              <p class="mt-2 text-xs text-slate-500">{method.landmark}</p>
            )}

            {method.secondary_action && (
              <a
                href={method.secondary_action.href}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex items-center gap-2 rounded-lg border border-slate-700 px-3 py-2 text-xs font-semibold text-slate-300 transition-colors hover:border-primary-500/50 hover:text-primary-300"
              >
                {method.secondary_action.label}
              </a>
            )}

            {method.map_label && (
              <a
                href={method.href}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex items-center gap-1.5 text-xs text-secondary-400 transition-colors hover:text-secondary-300"
              >
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                {method.map_label}
              </a>
            )}

            {method.note && (
              <p class="mt-3 text-xs text-slate-500 leading-relaxed">{method.note}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Office Hours + Batch Timings ─────────────────────────────────── -->
  <section class="py-10 lg:py-14">
    <div class="container mx-auto px-4">
      <div class="mx-auto grid max-w-5xl gap-6 lg:grid-cols-2">

        <!-- Office Hours -->
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-7">
          <div class="mb-4 flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary-500/10">
              <svg class="h-5 w-5 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h2 class="font-heading text-xl font-bold text-white">Office Hours</h2>
          </div>
          <div class="space-y-3">
            <div class="flex items-start gap-3 rounded-lg bg-slate-800/50 px-4 py-3">
              <span class="mt-0.5 text-sm font-semibold text-primary-400 whitespace-nowrap">Mon–Sat</span>
              <span class="text-sm text-slate-300">{content.office_hours.weekdays}</span>
            </div>
            <div class="flex items-start gap-3 rounded-lg bg-slate-800/50 px-4 py-3">
              <span class="mt-0.5 text-sm font-semibold text-slate-500 whitespace-nowrap">Sunday</span>
              <span class="text-sm text-slate-400">{content.office_hours.sunday}</span>
            </div>
          </div>
          <p class="mt-4 rounded-lg border border-primary-500/20 bg-primary-500/5 px-4 py-3 text-xs text-slate-400">
            💡 {content.office_hours.note}
          </p>
        </div>

        <!-- Batch Timings -->
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-7">
          <div class="mb-4 flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-secondary-500/10">
              <svg class="h-5 w-5 text-secondary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h2 class="font-heading text-xl font-bold text-white">Batch Timings</h2>
          </div>
          <div class="overflow-hidden rounded-xl border border-slate-800">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-slate-800 bg-slate-800/50">
                  <th class="px-4 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-400">Batch</th>
                  <th class="px-4 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-400">Time</th>
                  <th class="px-4 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-slate-400">Days</th>
                </tr>
              </thead>
              <tbody>
                {content.batch_timings.map((row, i) => (
                  <tr class:list={['border-b border-slate-800/60', i % 2 === 1 ? 'bg-slate-800/20' : '']}>
                    <td class="px-4 py-3 font-medium text-white">{row.label}</td>
                    <td class="px-4 py-3 text-secondary-400 font-mono text-xs">{row.time}</td>
                    <td class="px-4 py-3 text-slate-400">{row.days}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Delivery Modes ────────────────────────────────────────────────── -->
  <section class="py-10 lg:py-14 bg-slate-900/30">
    <div class="container mx-auto px-4">
      <h2 class="mb-2 text-center font-heading text-2xl font-bold text-white">
        Offline or Online — You Choose
      </h2>
      <p class="mb-8 text-center text-slate-400 text-sm">Same instructor. Same curriculum. Same certificate.</p>
      <div class="mx-auto grid max-w-4xl gap-5 md:grid-cols-2">
        {content.delivery_modes.map((mode) => (
          <div class="flex gap-5 rounded-2xl border border-slate-800 bg-slate-900/50 p-7 transition-all hover:border-primary-500/30">
            <div class="flex-shrink-0">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-primary-500/20 to-secondary-500/20">
                {mode.icon === 'building' && (
                  <svg class="h-6 w-6 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                )}
                {mode.icon === 'globe' && (
                  <svg class="h-6 w-6 text-secondary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
              </div>
            </div>
            <div>
              <h3 class="mb-2 font-heading text-lg font-bold text-white">{mode.label}</h3>
              <p class="text-sm leading-relaxed text-slate-400">{mode.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── What to Expect ────────────────────────────────────────────────── -->
  <section class="py-10 lg:py-14">
    <div class="container mx-auto px-4">
      <h2 class="mb-2 text-center font-heading text-2xl font-bold text-white">What Happens Next?</h2>
      <p class="mb-8 text-center text-sm text-slate-400">Your journey in 4 simple steps</p>

      <!-- Sub-tabs -->
      <div class="mx-auto mb-8 flex max-w-sm overflow-hidden rounded-xl border border-slate-700 bg-slate-900 p-1" role="tablist">
        <button type="button" role="tab" data-expect-tab="academy" aria-selected="true"
          class="expect-tab-btn flex-1 rounded-lg px-4 py-2 text-sm font-semibold transition-all bg-slate-700 text-white">
          For Students
        </button>
        <button type="button" role="tab" data-expect-tab="services" aria-selected="false"
          class="expect-tab-btn flex-1 rounded-lg px-4 py-2 text-sm font-semibold transition-all text-slate-400 hover:text-slate-200">
          For Businesses
        </button>
      </div>

      <!-- Academy steps -->
      <div data-expect-panel="academy" class="expect-panel mx-auto max-w-4xl">
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {content.what_to_expect.academy.map((step) => (
            <div class="relative rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
              <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-primary-500/15 font-heading text-lg font-bold text-primary-400 ring-2 ring-primary-500/30">
                {step.step}
              </div>
              <h4 class="mb-2 font-semibold text-white">{step.label}</h4>
              <p class="text-sm leading-relaxed text-slate-400">{step.detail}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Services steps -->
      <div data-expect-panel="services" class="expect-panel mx-auto max-w-4xl hidden">
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {content.what_to_expect.services.map((step) => (
            <div class="relative rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
              <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-secondary-500/15 font-heading text-lg font-bold text-secondary-400 ring-2 ring-secondary-500/30">
                {step.step}
              </div>
              <h4 class="mb-2 font-semibold text-white">{step.label}</h4>
              <p class="text-sm leading-relaxed text-slate-400">{step.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Contact Form ──────────────────────────────────────────────────── -->
  <section class="py-10 lg:py-14 bg-slate-900/30">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-2xl">
        <div class="rounded-3xl border border-slate-800 bg-slate-900/50 p-8 md:p-12">
          <h2 class="mb-2 text-center font-heading text-2xl font-bold text-white">
            Send us a message
          </h2>
          <p class="mb-8 text-center text-slate-400">
            Fill out the form and we'll get back to you within 24 hours.
          </p>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FAQ ───────────────────────────────────────────────────────────── -->
  <section class="py-10 lg:py-14">
    <div class="container mx-auto px-4">
      <h2 class="mb-2 text-center font-heading text-2xl font-bold text-white">
        Frequently Asked Questions
      </h2>
      <p class="mb-8 text-center text-sm text-slate-400">
        Everything you need to know before reaching out
      </p>
      <div class="mx-auto max-w-3xl space-y-3">
        {content.faq.map((item) => (
          <details class="faq-item group rounded-xl border border-slate-800 bg-slate-900/50 transition-all open:border-primary-500/30 open:bg-slate-900">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 text-sm font-semibold text-white">
              <span>{item.question}</span>
              <svg class="h-4 w-4 flex-shrink-0 text-slate-400 transition-transform group-open:rotate-180 group-open:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="px-6 pb-5 pt-0 text-sm leading-relaxed text-slate-400">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── CTA Block ─────────────────────────────────────────────────────── -->
  <section class="py-10 lg:py-14 bg-slate-900/30">
    <div class="container mx-auto px-4">
      <!-- Sub-tabs -->
      <div class="mx-auto mb-8 flex max-w-sm overflow-hidden rounded-xl border border-slate-700 bg-slate-900 p-1" role="tablist">
        <button type="button" role="tab" data-cta-tab="academy" aria-selected="true"
          class="cta-tab-btn flex-1 rounded-lg px-4 py-2 text-sm font-semibold transition-all bg-slate-700 text-white">
          For Students
        </button>
        <button type="button" role="tab" data-cta-tab="services" aria-selected="false"
          class="cta-tab-btn flex-1 rounded-lg px-4 py-2 text-sm font-semibold transition-all text-slate-400 hover:text-slate-200">
          For Businesses
        </button>
      </div>

      <!-- Academy CTA -->
      <div data-cta-panel="academy" class="cta-panel mx-auto max-w-3xl text-center">
