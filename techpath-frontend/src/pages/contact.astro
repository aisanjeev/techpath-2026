<script>
  // ── Contact Tabs (Academy / Services) ──────────────────────────────────
  (function () {
    const btns = document.querySelectorAll<HTMLButtonElement>('[data-contact-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-contact-panel]');

    function activateTab(id: string) {
      btns.forEach((btn) => {
        const active = btn.dataset.contactTab === id;
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
        btn.classList.toggle('bg-primary-500', active);
        btn.classList.toggle('text-slate-950', active);
        btn.classList.toggle('text-slate-400', !active);
        btn.classList.remove('hover:text-slate-200');
        if (!active) btn.classList.add('hover:text-slate-200');
      });
      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.contactPanel !== id);
      });
    }

    btns.forEach((btn) => {
      btn.addEventListener('click', () => activateTab(btn.dataset.contactTab!));
    });
  })();

  // ── What to Expect Tabs ────────────────────────────────────────────────
  (function () {
    const btns = document.querySelectorAll<HTMLButtonElement>('[data-expect-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-expect-panel]');

    function activateTab(id: string) {
      btns.forEach((btn) => {
        const active = btn.dataset.expectTab === id;
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
        btn.classList.toggle('bg-slate-700', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('text-slate-400', !active);
      });
      panels.forEach((p) => {
        p.classList.toggle('hidden', p.dataset.expectPanel !== id);
      });
    }

    btns.forEach((btn) => btn.addEventListener('click', () => activateTab(btn.dataset.expectTab!)));
  })();

  // ── CTA Block Tabs ─────────────────────────────────────────────────────
  (function () {
    const btns = document.querySelectorAll<HTMLButtonElement>('[data-cta-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-cta-panel]');

    function activateTab(id: string) {
      btns.forEach((btn) => {
        const active = btn.dataset.ctaTab === id;
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
        btn.classList.toggle('bg-slate-700', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('text-slate-400', !active);
      });
      panels.forEach((p) => {
        p.classList.toggle('hidden', p.dataset.ctaPanel !== id);
      });
    }

    btns.forEach((btn) => btn.addEventListener('click', () => activateTab(btn.dataset.ctaTab!)));
  })();
</script>
