---
/**
 * Training Page
 * High-converting landing page for TechPath training programs
 * Following 7-section strategy for maximum SEO and conversions
 */
import MainLayout from '@layouts/MainLayout.astro';
import TrainingHero from './_components/TrainingHero.astro';
import PainPointsSection from './_components/PainPointsSection.astro';
import USPSection from './_components/USPSection.astro';
import CourseGrid from './_components/CourseGrid.astro';
import TransformationStories from './_components/TransformationStories.astro';
import OfferBanner from './_components/OfferBanner.astro';
import TrainingEnquiryForm from './_components/TrainingEnquiryForm.astro';
import FAQSection from '@components/sections/FAQSection.astro';
import CTA from '@components/shared/CTA.astro';
import { fetchCourses, normalizeApiCourse } from '@services/courseService';
import { fetchTrainingPageContent, getDefaultTrainingContent } from '@services/trainingContentService';

export const prerender = false;

let courses: any[] = [];
let fetchError = false;

try {
  const response = await fetchCourses({ limit: 50 });
  courses = response.map(normalizeApiCourse);
} catch (error) {
  console.error('Error fetching courses from API:', error);
  fetchError = true;
}

// Training page content from API; fallback when API unavailable
const contentFromApi = await fetchTrainingPageContent();
const content = contentFromApi ?? getDefaultTrainingContent();

// Schema.org JSON-LD for SEO (uses content.schema_defaults + courses)
const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": content.schema_defaults.name,
  "description": content.schema_defaults.description,
  "url": "https://techpath.biz/training",
  "logo": "https://techpath.biz/images/techpath-logo.webp",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": content.schema_defaults.rating_value,
    "reviewCount": content.schema_defaults.review_count,
    "bestRating": "5"
  },
  ...(courses.length > 0 && {
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Tech Training Courses",
      "itemListElement": courses.slice(0, 5).map((course: { name: string; skills: string[]; price: number }) => ({
        "@type": "Course",
        "name": course.name,
        "description": `Learn ${course.skills?.join(', ') || ''} with live instructor training`,
        "provider": {
          "@type": "Organization",
          "name": "TechPath"
        },
        "offers": {
          "@type": "Offer",
          "price": course.price,
          "priceCurrency": "INR"
        }
      }))
    }
  })
};
---

<MainLayout
  title={content.seo?.title ?? 'Online Tech Courses | Certificate Programs | TechPath Training'}
  description={content.seo?.description ?? 'Learn Data Science, AI, Cloud, Web Development with live instructors. Courses from ₹7K. 94% job placement. 30-day money-back guarantee. Enroll now!'}
  image={content.seo?.image ?? undefined}
  canonicalUrl={content.seo?.canonical_url ?? undefined}
  noIndex={content.seo?.no_index ?? false}
>
  <!-- Schema.org JSON-LD -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

  <!-- Main Content with Sticky Form Sidebar on Desktop -->
  <div class="relative">
    <!-- Desktop Sticky Form Sidebar -->
    <div class="sticky-form-container hidden lg:block">
      <div class="sticky top-24 w-80 xl:w-96">
        <TrainingEnquiryForm variant="desktop" />
      </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
      <!-- Section 1: Hero -->
      <TrainingHero hero={content.hero} />

      <!-- Section 2: Pain Points -->
      <PainPointsSection painPoints={content.pain_points} />

      <!-- Section 3: USP / Why Choose Us -->
      <USPSection usps={content.usps} />

      <!-- Section 4: Course Catalog -->
      {fetchError ? (
        <section class="bg-slate-900 py-16">
          <div class="container mx-auto px-4 text-center">
            <div class="mx-auto max-w-md rounded-xl border border-red-500/30 bg-red-500/10 p-8">
              <svg class="mx-auto h-12 w-12 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <h3 class="mt-4 text-xl font-semibold text-white">Unable to Load Courses</h3>
              <p class="mt-2 text-slate-400">Please try again later or contact us for assistance.</p>
              <a href="/contact" class="mt-4 inline-block rounded-lg bg-primary-500 px-6 py-2 text-white hover:bg-primary-600">
                Contact Us
              </a>
            </div>
          </div>
        </section>
      ) : courses.length === 0 ? (
        <section class="bg-slate-900 py-16">
          <div class="container mx-auto px-4 text-center">
            <div class="mx-auto max-w-md p-8">
              <svg class="mx-auto h-12 w-12 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              <h3 class="mt-4 text-xl font-semibold text-white">No Courses Available</h3>
              <p class="mt-2 text-slate-400">New courses coming soon! Sign up to be notified.</p>
            </div>
          </div>
        </section>
      ) : (
        <CourseGrid courses={courses} />
      )}

      <!-- Section 5: Transformation Stories -->
      <TransformationStories stories={content.stories} />

      <!-- Section 6: Offer + Urgency -->
      <OfferBanner offerBanner={content.offer_banner} />

      <!-- Section 7: FAQ -->
      <section class="bg-slate-950 py-16 lg:py-24">
        <div class="container mx-auto px-4">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <span class="mb-4 inline-block rounded-full bg-primary-500/10 px-4 py-1.5 text-sm font-semibold text-primary-400">
              FAQ
            </span>
            <h2 class="mb-4 font-heading text-3xl font-bold text-white md:text-4xl">
              Frequently Asked <span class="text-primary-400">Questions</span>
            </h2>
            <p class="text-lg text-slate-400">
              Got questions? We've got answers.
            </p>
          </div>
          <FAQSection faqs={content.faqs} />
        </div>
      </section>
    </div>
  </div>

  <!-- Mobile Floating Form (handled by component) -->
  <TrainingEnquiryForm variant="mobile" />

  <!-- Final CTA -->
  <CTA
    title={content.cta.title}
    description={content.cta.description}
    primaryButton={{ label: content.cta.primary_button.label, href: content.cta.primary_button.href }}
    secondaryButton={{ label: content.cta.secondary_button.label, href: content.cta.secondary_button.href }}
  />
</MainLayout>

<style>
  /* Desktop layout with sticky sidebar */
  @media (min-width: 1024px) {
    .relative {
      display: flex;
      flex-direction: row-reverse;
      gap: 2rem;
      max-width: 1600px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .sticky-form-container {
      flex-shrink: 0;
      padding-top: 2rem;
    }

    .main-content {
      flex: 1;
      min-width: 0;
    }
  }
</style>

