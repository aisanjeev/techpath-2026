// Training-specific FAQs
const trainingFaqs = [
  {
    question: "Do I need prior coding experience to enroll?",
    answer: "It depends on the course. Our beginner-level courses like MERN Full Stack and Data Analytics are designed for absolute beginners. Intermediate and advanced courses may require basic programming knowledge. Each course page lists specific prerequisites."
  },
  {
    question: "What is your job guarantee policy?",
    answer: "We offer placement assistance with a 94% success rate. While we can't legally guarantee a job, we provide resume building, mock interviews, and connect you with our 500+ hiring partners. If you don't get placed within 6 months of completion, you get a 50% refund."
  },
  {
    question: "What if I don't like the course?",
    answer: "We offer a 30-day money-back guarantee. If you're not satisfied within the first 30 days, simply request a refund - no questions asked. We want you to be 100% confident in your investment."
  },
  {
    question: "Can I access the course content after completion?",
    answer: "Yes! You get lifetime access to all course materials, including any future updates. You can revisit lessons, download resources, and access recordings anytime."
  },
  {
    question: "What are the class timings?",
    answer: "We offer flexible timing with both weekday (evening) and weekend batches. Live classes are recorded, so you can catch up if you miss a session. Most courses have 2-3 live sessions per week, each 2-3 hours long."
  },
  {
    question: "Is there EMI option available?",
    answer: "Yes! We offer flexible EMI options starting from ₹2,000/month depending on the course. We've partnered with leading fintech providers to offer 0% interest EMI for select courses."
  },
  {
    question: "What projects will I build?",
    answer: "Each course includes 5-10 hands-on projects that you'll add to your GitHub portfolio. Projects are industry-relevant and designed with input from hiring managers. You'll have real deployable applications by the end."
  },
  {
    question: "How are the live classes conducted?",
    answer: "Classes are conducted via Zoom with small batches (max 15-25 students). You'll interact directly with instructors, participate in live coding, and get instant doubt resolution. All sessions are recorded for later viewing."
  },
];

// Schema.org JSON-LD for SEO
const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "TechPath Training",
  "description": "Online tech courses and certification programs with live instructor training",
  "url": "https://techpath.biz/training",
  "logo": "https://techpath.biz/images/techpath-logo.webp",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "2000",
    "bestRating": "5"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Tech Training Courses",
    "itemListElement": courses.slice(0, 5).map(course => ({
      "@type": "Course",
      "name": course.name,
      "description": `Learn ${course.skills.join(', ')} with live instructor training`,
      "provider": {
        "@type": "Organization",
        "name": "TechPath"
      },
      "offers": {
        "@type": "Offer",
        "price": course.price,
        "priceCurrency": "INR"
      }
    }))
  }
};
---

<MainLayout
  title="Online Tech Courses | Certificate Programs | TechPath Training"
  description="Learn Data Science, AI, Cloud, Web Development with live instructors. Courses from ₹7K. 94% job placement. 30-day money-back guarantee. Enroll now!"
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

  <!-- Main Content with Sticky Form Sidebar on Desktop -->
  <div class="relative">
    <!-- Desktop Sticky Form Sidebar -->
    <div class="sticky-form-container hidden lg:block">
      <div class="sticky top-24 w-80 xl:w-96">
        <TrainingEnquiryForm variant="desktop" />
      </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
      <!-- Section 1: Hero -->
      <TrainingHero />

      <!-- Section 2: Pain Points -->
      <PainPointsSection />

      <!-- Section 3: USP / Why Choose Us -->
      <USPSection />

      <!-- Section 4: Course Catalog -->
      <CourseGrid courses={courses} />

      <!-- Section 5: Transformation Stories -->
      <TransformationStories />

      <!-- Section 6: Offer + Urgency -->
      <OfferBanner />

      <!-- Section 7: FAQ -->
      <section class="bg-slate-950 py-16 lg:py-24">
        <div class="container mx-auto px-4">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <span class="mb-4 inline-block rounded-full bg-primary-500/10 px-4 py-1.5 text-sm font-semibold text-primary-400">
              FAQ
            </span>
            <h2 class="mb-4 font-heading text-3xl font-bold text-white md:text-4xl">
              Frequently Asked <span class="text-primary-400">Questions</span>
            </h2>
            <p class="text-lg text-slate-400">
              Got questions? We've got answers.
            </p>
          </div>
          <FAQSection faqs={trainingFaqs} />
        </div>
      </section>
    </div>
  </div>

  <!-- Mobile Floating Form (handled by component) -->
  <TrainingEnquiryForm variant="mobile" />

  <!-- Final CTA -->
  <CTA
    title="Ready to Transform Your Career?"
    description="Join 50,000+ students who've changed their lives with TechPath training."
    primaryButton={{ label: 'Explore Courses', href: '#courses' }}
    secondaryButton={{ label: 'Talk to Counselor', href: '/contact' }}
  />
</MainLayout>

<style>
  /* Desktop layout with sticky sidebar */
  @media (min-width: 1024px) {
    .relative {
      display: flex;
      flex-direction: row-reverse;
      gap: 2rem;
      max-width: 1600px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .sticky-form-container {
      flex-shrink: 0;
      padding-top: 2rem;
    }

    .main-content {
      flex: 1;
      min-width: 0;
    }
  }
</style>

