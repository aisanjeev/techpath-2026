---
/**
 * OfferBanner Component
 * Urgency section with countdown timer and benefits
 */
import CountdownTimer from './CountdownTimer.astro';

interface Props {
  discount?: string;
  savings?: string;
  targetDate?: string;
}

const {
  discount = "₹15,000 OFF",
  savings = "Save 30%",
  targetDate = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString(),
} = Astro.props;

const benefits = [
  "24/7 Doubt Support",
  "Job Interview Prep (3 sessions)",
  "Resume Building Help",
  "LinkedIn Profile Optimization",
  "Mock Interview Rounds (4)",
  "Lifetime Course Access",
  "30-Day Money-Back Guarantee",
  "Certificate of Completion",
];
---

<section id="enroll" class="relative overflow-hidden bg-gradient-to-br from-primary-950 via-slate-900 to-slate-950 py-16 lg:py-24">
  <!-- Background Effects -->
  <div class="absolute inset-0">
    <div class="absolute left-1/4 top-0 h-64 w-64 rounded-full bg-primary-500/10 blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 h-64 w-64 rounded-full bg-secondary-500/10 blur-3xl"></div>
  </div>

  <div class="container relative mx-auto px-4">
    <div class="mx-auto max-w-4xl">
      <!-- Offer Badge -->
      <div class="mb-8 text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-4 py-2 text-sm font-semibold text-orange-400">
          <svg class="h-4 w-4 animate-pulse" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd" />
          </svg>
          EARLY BIRD OFFER - Limited Time Only
        </span>
      </div>

      <!-- Main Content -->
      <div class="rounded-3xl border border-slate-700/50 bg-slate-800/30 p-8 backdrop-blur-sm md:p-12">
        <div class="grid gap-8 lg:grid-cols-2">
          <!-- Left: Offer Details -->
          <div>
            <h2 class="mb-2 font-heading text-3xl font-bold text-white md:text-4xl">
              Get <span class="text-primary-400">{discount}</span>
            </h2>
            <p class="mb-6 text-lg text-slate-300">
              First 50 enrollments: <span class="font-semibold text-green-400">{savings}</span>
            </p>

            <!-- Countdown -->
            <div class="mb-8">
              <CountdownTimer targetDate={targetDate} label="⏰ Offer expires in:" />
            </div>

            <!-- CTA -->
            <a
              href="#courses"
              class="group inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-8 py-4 text-lg font-bold text-white shadow-lg shadow-orange-500/25 transition-all hover:from-orange-600 hover:to-orange-700 hover:shadow-xl"
            >
              Claim Your Spot Now
              <svg class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <p class="mt-3 text-sm text-slate-400">
              🔒 Secure checkout • No spam • Cancel anytime
            </p>
          </div>

          <!-- Right: Benefits -->
          <div class="rounded-2xl border border-slate-700/50 bg-slate-800/50 p-6">
            <h3 class="mb-4 font-heading text-lg font-bold text-white">
              ✅ Includes with Every Course:
            </h3>
            <ul class="grid gap-3 sm:grid-cols-2">
              {benefits.map((benefit) => (
                <li class="flex items-center gap-2 text-sm text-slate-300">
                  <svg class="h-4 w-4 flex-shrink-0 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {benefit}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Trust indicators -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-6 border-t border-slate-700/50 pt-8">
          <div class="flex items-center gap-2 text-sm text-slate-400">
            <svg class="h-5 w-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            100% Secure Payment
          </div>
          <div class="flex items-center gap-2 text-sm text-slate-400">
            <svg class="h-5 w-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
            EMI Available
          </div>
          <div class="flex items-center gap-2 text-sm text-slate-400">
            <svg class="h-5 w-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            30-Day Refund
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

