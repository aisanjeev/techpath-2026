---
/**
 * CourseGrid Component
 * Filterable grid of course cards
 */
import CourseCard from './CourseCard.astro';
import CourseFilters from './CourseFilters.astro';

interface Course {
  slug: string;
  name: string;
  category: string;
  rating: number;
  reviewCount: number;
  duration: string;
  batchSize: number;
  price: number;
  originalPrice: number;
  emiAvailable: boolean;
  emiAmount?: number;
  placementRate: number;
  skills: string[];
  level: 'beginner' | 'intermediate' | 'advanced';
  image?: string;
}

interface Props {
  courses: Course[];
}

const { courses } = Astro.props;

const categories = [
  { value: 'all', label: 'All Courses' },
  { value: 'data-science', label: 'Data Science' },
  { value: 'cloud', label: 'Cloud & DevOps' },
  { value: 'ai-ml', label: 'AI & ML' },
  { value: 'fullstack', label: 'Full Stack' },
  { value: 'business', label: 'Business' },
];
---

<section id="courses" class="bg-slate-950 py-16 lg:py-24">
  <div class="container mx-auto px-4">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <span class="mb-4 inline-block rounded-full bg-primary-500/10 px-4 py-1.5 text-sm font-semibold text-primary-400">
        Course Catalog
      </span>
      <h2 class="mb-4 font-heading text-3xl font-bold text-white md:text-4xl">
        Explore Our <span class="text-primary-400">Training Programs</span>
      </h2>
      <p class="text-lg text-slate-400">
        Choose from 15+ industry-relevant courses designed to accelerate your career.
      </p>
    </div>

    <!-- Filters -->
    <CourseFilters categories={categories} />

    <!-- Course Grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {courses.map((course) => (
        <CourseCard {...course} />
      ))}
    </div>

    <!-- View All CTA -->
    <div class="mt-12 text-center">
      <p class="mb-4 text-slate-400">
        Can't find what you're looking for?
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 text-primary-400 transition-colors hover:text-primary-300"
      >
        Request a Custom Training Program
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

