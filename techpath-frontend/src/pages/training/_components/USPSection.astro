---
/**
 * USPSection Component
 * Highlights TechPath's unique selling propositions
 */
const usps = [
  {
    icon: "🎓",
    title: "Expert Instructors",
    highlights: [
      "Real engineers with 7+ years experience",
      "Currently working in top tech companies",
      "Teach current market-relevant skills",
    ],
    color: "from-blue-500 to-cyan-500",
  },
  {
    icon: "💻",
    title: "Live + Interactive",
    highlights: [
      "Daily doubt-clearing sessions",
      "Real-time code reviews",
      "Small batches (max 20 students)",
    ],
    color: "from-purple-500 to-pink-500",
  },
  {
    icon: "🚀",
    title: "Job-Ready Projects",
    highlights: [
      "Build 5-10 live projects",
      "Add to your GitHub portfolio",
      "Get job interviews faster",
    ],
    color: "from-primary-500 to-secondary-500",
  },
  {
    icon: "💰",
    title: "Transparent Pricing",
    highlights: [
      "No hidden charges ever",
      "30-day money-back guarantee",
      "Flexible EMI options available",
    ],
    color: "from-green-500 to-emerald-500",
  },
];
---

<section class="bg-slate-900 py-16 lg:py-24">
  <div class="container mx-auto px-4">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <span class="mb-4 inline-block rounded-full bg-primary-500/10 px-4 py-1.5 text-sm font-semibold text-primary-400">
        Why Choose Us
      </span>
      <h2 class="mb-4 font-heading text-3xl font-bold text-white md:text-4xl">
        Why Top Companies Choose <span class="text-primary-400">TechPath</span> Graduates
      </h2>
      <p class="text-lg text-slate-400">
        We don't just teach — we transform careers with a proven methodology.
      </p>
    </div>

    <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-4">
      {usps.map((usp) => (
        <div class="group relative overflow-hidden rounded-2xl border border-slate-700/50 bg-slate-800/50 p-6 transition-all hover:border-slate-600 hover:bg-slate-800">
          <!-- Gradient overlay on hover -->
          <div class={`absolute inset-0 bg-gradient-to-br ${usp.color} opacity-0 transition-opacity group-hover:opacity-5`}></div>
          
          <div class="relative">
            <div class="mb-4 text-4xl">{usp.icon}</div>
            <h3 class="mb-4 font-heading text-xl font-bold text-white">
              {usp.title}
            </h3>
            <ul class="space-y-2">
              {usp.highlights.map((highlight) => (
                <li class="flex items-start gap-2 text-sm text-slate-400">
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {highlight}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

