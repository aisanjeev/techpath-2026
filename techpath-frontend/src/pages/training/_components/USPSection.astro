---
/**
 * USPSection Component
 * Highlights TechPath's unique selling propositions (content from API or fallback)
 */
interface Props {
  usps: {
    section_title: string;
    section_subtext: string;
    items: Array<{
      icon: string;
      title: string;
      highlights: string[];
      color: string;
    }>;
  };
}

const { usps } = Astro.props;
const items = usps.items ?? [];
---

<section class="bg-slate-900 py-16 lg:py-24">
  <div class="container mx-auto px-4">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <span class="mb-4 inline-block rounded-full bg-primary-500/10 px-4 py-1.5 text-sm font-semibold text-primary-400">
        Why Choose Us
      </span>
      <h2 class="mb-4 font-heading text-3xl font-bold text-white md:text-4xl">
        {usps.section_title}
      </h2>
      <p class="text-lg text-slate-400">
        {usps.section_subtext}
      </p>
    </div>

    {items.length > 0 && (
    <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-4">
      {items.map((usp) => (
        <div class="group relative overflow-hidden rounded-2xl border border-slate-700/50 bg-slate-800/50 p-6 transition-all hover:border-slate-600 hover:bg-slate-800">
          <!-- Gradient overlay on hover -->
          <div class={`absolute inset-0 bg-gradient-to-br ${usp.color} opacity-0 transition-opacity group-hover:opacity-5`}></div>
          
          <div class="relative">
            <div class="mb-4 text-4xl">{usp.icon}</div>
            <h3 class="mb-4 font-heading text-xl font-bold text-white">
              {usp.title}
            </h3>
            <ul class="space-y-2">
              {usp.highlights.map((highlight) => (
                <li class="flex items-start gap-2 text-sm text-slate-400">
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {highlight}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
    )}
  </div>
</section>

