---
/**
 * TransformationStories Component
 * Student success stories (content from API or fallback)
 */
interface Props {
  stories: {
    section_title: string;
    section_subtext: string;
    items: Array<{
      name: string;
      location: string;
      previous_role: string;
      current_role: string;
      previous_salary: string;
      current_salary: string;
      course: string;
      duration: string;
      quote: string;
      rating: number;
      has_video: boolean;
    }>;
  };
}

const { stories } = Astro.props;
const items = stories.items ?? [];
---

<section class="bg-slate-900 py-16 lg:py-24">
  <div class="container mx-auto px-4">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <span class="mb-4 inline-block rounded-full bg-primary-500/10 px-4 py-1.5 text-sm font-semibold text-primary-400">
        Success Stories
      </span>
      <h2 class="mb-4 font-heading text-3xl font-bold text-white md:text-4xl">
        {stories.section_title}
      </h2>
      <p class="text-lg text-slate-400">
        {stories.section_subtext}
      </p>
    </div>

    {items.length > 0 && (
    <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2">
      {items.map((story) => (
        <div class="group relative overflow-hidden rounded-2xl border border-slate-700/50 bg-slate-800/30 p-6 transition-all hover:border-primary-500/30">
          {/* Video Badge */}
          {story.has_video && (
            <div class="absolute right-4 top-4 flex items-center gap-1 rounded-full bg-red-500/20 px-2 py-1 text-xs font-medium text-red-400">
              <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
              </svg>
              Video
            </div>
          )}

          {/* Header */}
          <div class="mb-4 flex items-center gap-4">
            {/* Avatar */}
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-primary-500 to-secondary-500 text-xl font-bold text-white">
              {story.name.split(' ').map(n => n[0]).join('')}
            </div>
            <div>
              <h3 class="font-semibold text-white">{story.name}</h3>
              <p class="text-sm text-slate-400">{story.location}</p>
            </div>
          </div>

          {/* Transformation */}
          <div class="mb-4 flex items-center gap-3 rounded-xl bg-slate-800/50 p-4">
            <div class="flex-1">
              <p class="text-xs text-slate-400">Before</p>
              <p class="font-medium text-slate-300">{story.previous_role}</p>
              <p class="text-sm text-slate-400">{story.previous_salary}</p>
            </div>
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-green-500/20">
              <svg class="h-4 w-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
            <div class="flex-1 text-right">
              <p class="text-xs text-slate-400">After</p>
              <p class="font-medium text-green-400">{story.current_role}</p>
              <p class="text-sm font-semibold text-green-400">{story.current_salary}</p>
            </div>
          </div>

          {/* Quote */}
          <blockquote class="mb-4 text-sm italic text-slate-300 leading-relaxed">
            "{story.quote}"
          </blockquote>

          {/* Footer */}
          <div class="flex items-center justify-between border-t border-slate-700/50 pt-4">
            <div class="text-xs text-slate-400">
              <span class="text-primary-400">{story.course}</span> • {story.duration}
            </div>
            <div class="flex gap-0.5">
              {[...Array(story.rating || 5)].map(() => (
                <svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
    )}

    <!-- Stats Bar -->
    <div class="mx-auto mt-12 max-w-4xl rounded-2xl border border-slate-700/50 bg-slate-800/30 p-6">
      <div class="grid grid-cols-2 gap-6 md:grid-cols-4">
        <div class="text-center">
          <p class="text-3xl font-bold text-primary-400">300%</p>
          <p class="text-sm text-slate-400">Avg Salary Hike</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold text-primary-400">94%</p>
          <p class="text-sm text-slate-400">Placement Rate</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold text-primary-400">50K+</p>
          <p class="text-sm text-slate-400">Students Trained</p>
        </div>
        <div class="text-center">
          <p class="text-3xl font-bold text-primary-400">500+</p>
          <p class="text-sm text-slate-400">Hiring Partners</p>
        </div>
      </div>
    </div>
  </div>
</section>

