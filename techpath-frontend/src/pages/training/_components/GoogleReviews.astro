---
/**
 * GoogleReviews Component
 * Renders live Google Places reviews for Techpath Academy.
 * Renders nothing when placeData is null (API key missing or fetch failed).
 */
import type { GooglePlaceData } from '@utils/googleReviews';

interface Props {
  placeData: GooglePlaceData | null;
  sectionTitle?: string;
  sectionSubtext?: string;
  mapsUrl?: string;
}

const {
  placeData,
  sectionTitle = 'What Our Students Say on Google',
  sectionSubtext = 'Real reviews from verified students — Mughalsarai, Chandauli, Varanasi, and across eastern UP.',
  mapsUrl = 'https://www.google.com/maps/search/Techpath+Academy+Mughalsarai',
} = Astro.props;

// Nothing to render
if (!placeData || !placeData.reviews?.length) return;

const reviews = placeData.reviews;
const overallRating = placeData.rating ?? 0;
const totalCount = placeData.user_ratings_total ?? 0;

// Render filled/empty stars for a given integer rating (1-5)
function starArray(rating: number) {
  return Array.from({ length: 5 }, (_, i) => i + 1 <= Math.round(rating));
}
---

<section class="bg-slate-900 py-16 lg:py-24">
  <div class="container mx-auto px-4">

    <!-- Header -->
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <!-- Google "G" badge -->
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-800 px-4 py-1.5">
        <!-- Google coloured "G" SVG -->
        <svg class="h-4 w-4" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          <path fill="none" d="M0 0h48v48H0z"/>
        </svg>
        <span class="text-xs font-semibold text-slate-300">Google Reviews</span>
      </div>

      <h2 class="mb-3 font-heading text-3xl font-bold text-white md:text-4xl">
        {sectionTitle}
      </h2>
      <p class="mb-4 text-lg text-slate-400">{sectionSubtext}</p>

      <!-- Overall rating summary -->
      {overallRating > 0 && (
        <div class="inline-flex items-center gap-3 rounded-2xl border border-slate-700 bg-slate-800/60 px-6 py-3">
          <span class="font-heading text-4xl font-bold text-white">{overallRating.toFixed(1)}</span>
          <div>
            <div class="flex gap-0.5">
              {starArray(overallRating).map((filled) => (
                <svg
                  class={`h-5 w-5 ${filled ? 'text-yellow-400' : 'text-slate-600'}`}
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            {totalCount > 0 && (
              <p class="mt-0.5 text-xs text-slate-400">
                Based on {totalCount.toLocaleString()} reviews
              </p>
            )}
          </div>
        </div>
      )}
    </div>

    <!-- Review Cards Grid -->
    <div class="mx-auto grid max-w-6xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {reviews.map((review) => {
        const initials = review.author_name
          .split(' ')
          .map((n: string) => n[0] ?? '')
          .slice(0, 2)
          .join('');
        const truncated =
          review.text.length > 280
            ? review.text.slice(0, 280).trimEnd() + '…'
            : review.text;

        return (
          <div class="flex flex-col rounded-2xl border border-slate-700/50 bg-slate-800/40 p-5 transition-colors hover:border-slate-600/70">
            <!-- Reviewer -->
            <div class="mb-4 flex items-center gap-3">
              <!-- Profile photo with initial fallback -->
              <div class="relative h-10 w-10 flex-shrink-0">
                <img
                  src={review.profile_photo_url}
                  alt={review.author_name}
                  width="40"
                  height="40"
                  class="h-10 w-10 rounded-full object-cover"
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                />
                <div
                  class="hidden h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-primary-500 to-secondary-500 text-sm font-bold text-white"
                  aria-hidden="true"
                >
                  {initials}
                </div>
              </div>

              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-semibold text-white">{review.author_name}</p>
                <p class="text-xs text-slate-500">{review.relative_time_description}</p>
              </div>

              <!-- Google G -->
              <svg class="h-4 w-4 flex-shrink-0 opacity-50" viewBox="0 0 48 48" aria-hidden="true">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                <path fill="none" d="M0 0h48v48H0z"/>
              </svg>
            </div>

            <!-- Stars -->
            <div class="mb-3 flex gap-0.5">
              {starArray(review.rating).map((filled) => (
                <svg
                  class={`h-4 w-4 ${filled ? 'text-yellow-400' : 'text-slate-600'}`}
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <!-- Review text -->
            <p class="flex-1 text-sm leading-relaxed text-slate-300">{truncated}</p>
          </div>
        );
      })}
    </div>

    <!-- "See all on Google" link -->
    <div class="mt-10 text-center">
      <a
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-800/60 px-6 py-3 text-sm font-semibold text-slate-300 transition-colors hover:border-slate-500 hover:text-white"
      >
        <svg class="h-4 w-4" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          <path fill="none" d="M0 0h48v48H0z"/>
        </svg>
        See all reviews on Google
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

  </div>
</section>
