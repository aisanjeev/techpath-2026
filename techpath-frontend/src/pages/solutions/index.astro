    icon: '🏥',
    color: '#0ea5e9',
    colorClass: 'sky',
    keyChallenge: 'Manual processes & compliance',
    painPoints: [
      {
        title: 'Manual Processes Drain Resources',
        description: 'Healthcare organizations lose $4.3M annually to manual administrative tasks.',
        statistic: '73% report workflow inefficiencies',
        impact: 'Lost productivity, staff burnout, delayed patient care',
      },
      {
        title: 'Compliance & Security Concerns',
        description: 'HIPAA violations average $2.8M per incident.',
        statistic: '45% had compliance issues last year',
        impact: 'Legal liability, reputation damage, operational disruption',
      },
      {
        title: 'Data Fragmentation',
        description: 'Patient data scattered across disconnected systems.',
        statistic: 'Averaging 12 different systems per organization',
        impact: 'Poor patient outcomes, inefficient care coordination',
      },
    ],
    solutions: [
      { title: 'Automated Patient Management', description: 'AI-powered workflows reduce administrative time by 65%', icon: '⚡', benefit: 'Save 20+ hours/week' },
      { title: 'HIPAA-Compliant Systems', description: 'Enterprise-grade security with automatic compliance monitoring', icon: '🔒', benefit: 'Zero compliance violations' },
      { title: 'Data Integration', description: 'Unified patient records across all departments', icon: '🔄', benefit: 'Real-time visibility' },
      { title: 'Predictive Analytics', description: 'AI-driven insights for better patient outcomes', icon: '📊', benefit: 'Proactive care' },
    ],
    outcomes: ['35% reduction in operational costs', '50% faster patient onboarding', '98% compliance score'],
    metric: { value: '65%', label: 'Time Savings', description: '20 hours saved weekly' },
    caseStudy: {
      company: "St. Mary's Hospital Network",
      challenge: 'Managing patient data across 12 disconnected systems, causing 30+ hours/week of manual work',
      solution: 'Implemented unified patient management platform with AI automation',
      results: [
        { value: '65%', label: 'Time Reduction' },
        { value: '95%', label: 'Data Accuracy' },
        { value: '$2.4M', label: 'Annual Savings' },
      ],
      testimonial: {
        text: 'This solution transformed how we manage patient care. We reduced administrative burden and improved patient outcomes.',
        author: 'Dr. James Chen',
        title: 'Chief Medical Officer',
      },
    },
  },
  {
    id: 'finance',
    name: 'Financial Services',
    icon: '🏦',
    color: '#8b5cf6',
    colorClass: 'violet',
    keyChallenge: 'Fraud detection & regulatory compliance',
    painPoints: [
      {
        title: 'Fraud Losses Escalating',
        description: 'Financial fraud costs institutions billions annually.',
        statistic: '$28.5B lost to fraud globally',
        impact: 'Direct financial losses, customer trust erosion',
      },
      {
        title: 'Regulatory Complexity',
        description: 'Compliance requirements constantly evolving.',
        statistic: 'Average $850K in regulatory fines',
        impact: 'Legal penalties, operational overhead',
      },
      {
        title: 'Risk Assessment Gaps',
        description: 'Traditional methods miss emerging threats.',
        statistic: '45% of institutions had compliance violations',
        impact: 'Exposure to systemic risks, audit failures',
      },
    ],
    solutions: [
      { title: 'Fraud Detection AI', description: 'Real-time fraud prevention with machine learning', icon: '🛡️', benefit: '99.9% detection rate' },
      { title: 'Regulatory Compliance', description: 'Automated GDPR, SOX, PCI-DSS monitoring', icon: '📋', benefit: 'Always audit-ready' },
      { title: 'Risk Assessment', description: 'Predictive risk scoring and monitoring', icon: '⚠️', benefit: 'Proactive risk management' },
      { title: 'Real-time Analytics', description: 'Instant insights across all transactions', icon: '📈', benefit: 'Faster decisions' },
    ],
    outcomes: ['42% faster compliance audits', '99.9% fraud detection', '$1.2M annual savings'],
    metric: { value: '42%', label: 'Faster Compliance', description: '$1.2M savings/year' },
    caseStudy: {
      company: 'Global Bank Corp',
      challenge: 'Manual compliance processes taking 60+ hours per audit with frequent violations',
      solution: 'Deployed automated compliance monitoring with AI-powered fraud detection',
      results: [
        { value: '42%', label: 'Faster Audits' },
        { value: '99.9%', label: 'Fraud Detection' },
        { value: '$1.2M', label: 'Annual Savings' },
      ],
      testimonial: {
        text: 'We went from dreading audits to welcoming them. The automation gave us confidence we never had before.',
        author: 'Sarah Mitchell',
        title: 'Chief Compliance Officer',
      },
    },
  },
  {
    id: 'retail',
    name: 'Retail & E-commerce',
    icon: '🛒',
    color: '#f59e0b',
    colorClass: 'amber',
    keyChallenge: 'Inventory management & customer experience',
    painPoints: [
      {
        title: 'Inventory Discrepancies',
        description: 'Stock issues leading to lost sales and excess costs.',
        statistic: '15% inventory accuracy gap',
