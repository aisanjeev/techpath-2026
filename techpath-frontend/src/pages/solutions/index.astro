---
/**
 * Solutions Page
 * Industry-focused solutions for B2B conversion
 */
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumb from '@components/shared/Breadcrumb.astro';
import IndustrySection from '@components/solutions/IndustrySection.astro';
import SectionDivider from '@components/solutions/SectionDivider.astro';
import StatTile from '@components/solutions/StatTile.astro';

const apiBaseUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Solutions', href: '/solutions', current: true },
];

// Industry data with color coding
const industries = [
  {
    id: 'healthcare',
