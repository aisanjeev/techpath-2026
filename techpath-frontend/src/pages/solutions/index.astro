      { title: 'Inventory Management', description: 'AI-powered demand forecasting and stock optimization', icon: '📦', benefit: '40% reduction in stockouts' },
      { title: 'Customer Analytics', description: 'Deep customer insights for personalization', icon: '👥', benefit: '25% higher conversion' },
      { title: 'Omnichannel Integration', description: 'Seamless experience across all touchpoints', icon: '🔗', benefit: 'Unified customer view' },
      { title: 'Supply Chain Optimization', description: 'End-to-end visibility and automation', icon: '🚚', benefit: 'Faster fulfillment' },
    ],
    outcomes: ['40% inventory reduction', '25% conversion increase', '95% on-time delivery'],
    metric: { value: '40%', label: 'Inventory Reduction', description: '$500K savings/year' },
    caseStudy: {
      company: 'Fashion Forward Stores',
      challenge: 'Chronic stockouts and overstocking issues costing $500K+ annually',
      solution: 'Implemented AI-driven inventory management with demand forecasting',
      results: [
        { value: '40%', label: 'Stock Reduction' },
        { value: '25%', label: 'Sales Increase' },
        { value: '95%', label: 'Availability' },
      ],
      testimonial: {
        text: 'We finally have the right products in the right stores at the right time. Game changer for our business.',
        author: 'Michael Torres',
        title: 'VP of Operations',
      },
    },
  },
  {
    id: 'manufacturing',
    name: 'Manufacturing',
    icon: '🏭',
    color: '#ef4444',
    colorClass: 'red',
    keyChallenge: 'Downtime reduction & production optimization',
    painPoints: [
      {
        title: 'Unplanned Downtime',
        description: 'Equipment failures causing production losses.',
        statistic: '$2M+ annual downtime costs',
        impact: 'Lost production, missed deadlines, emergency repairs',
      },
      {
        title: 'Quality Control Issues',
        description: 'Defects not caught until late in production.',
        statistic: '80% of failures are preventable',
