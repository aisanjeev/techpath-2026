      { title: 'Supply Chain Management', description: 'Real-time visibility and automated procurement', icon: '📦', benefit: 'Zero stockouts' },
      { title: 'Quality Control Automation', description: 'Computer vision for defect detection', icon: '🔍', benefit: '99% defect detection' },
      { title: 'Production Optimization', description: 'AI-driven scheduling and resource allocation', icon: '⚙️', benefit: '20% throughput increase' },
    ],
    outcomes: ['30% uptime improvement', '80% reduction in failures', '$2M+ annual savings'],
    metric: { value: '30%', label: 'Uptime Improvement', description: '2000+ hours saved/year' },
    caseStudy: {
      company: 'Precision Manufacturing Inc',
      challenge: 'Frequent equipment failures causing $2M+ in annual downtime costs',
      solution: 'Deployed predictive maintenance with IoT sensors and AI analytics',
      results: [
        { value: '30%', label: 'Uptime Increase' },
        { value: '80%', label: 'Fewer Failures' },
        { value: '$2.1M', label: 'Cost Savings' },
      ],
      testimonial: {
        text: 'We went from reactive firefighting to proactive maintenance. Our OEE improved dramatically.',
        author: 'Robert Kim',
        title: 'Plant Manager',
      },
    },
  },
  {
    id: 'technology',
    name: 'Technology & SaaS',
    icon: '💻',
    color: '#06b6d4',
    colorClass: 'cyan',
    keyChallenge: 'Scaling infrastructure & cost optimization',
    painPoints: [
      {
        title: 'Cloud Cost Overruns',
        description: 'Unoptimized cloud spending draining budgets.',
        statistic: '35% of cloud spend is wasted',
        impact: 'Budget overruns, resource waste',
      },
      {
        title: 'Security Vulnerabilities',
        description: 'Growing attack surface as systems scale.',
        statistic: '5.4B records compromised in breaches',
        impact: 'Data breaches, compliance failures',
      },
      {
        title: 'Scaling Challenges',
        description: 'Infrastructure struggling to keep up with growth.',
        statistic: '40% of startups cite scaling as top challenge',
        impact: 'Performance issues, customer churn',
      },
    ],
    solutions: [
      { title: 'Scalable Infrastructure', description: 'Auto-scaling architecture that grows with you', icon: '📈', benefit: 'Infinite scalability' },
      { title: 'Security & Performance', description: 'Enterprise-grade security with zero-trust architecture', icon: '🔐', benefit: 'SOC 2 compliant' },
      { title: 'DevOps Automation', description: 'CI/CD pipelines and infrastructure as code', icon: '🔄', benefit: '10x faster deployments' },
      { title: 'Cost Optimization', description: 'AI-driven cloud spend analysis and optimization', icon: '💰', benefit: '50% cost reduction' },
    ],
    outcomes: ['50% cloud cost reduction', '99.99% uptime', '10x faster deployments'],
    metric: { value: '50%', label: 'Cost Savings', description: '$2.5M+/year for enterprises' },
    caseStudy: {
      company: 'CloudTech Solutions',
      challenge: 'Cloud costs spiraling out of control while struggling to maintain performance',
      solution: 'Implemented cloud cost optimization with auto-scaling infrastructure',
      results: [
        { value: '50%', label: 'Cost Reduction' },
        { value: '99.99%', label: 'Uptime' },
        { value: '10x', label: 'Faster Deploys' },
      ],
      testimonial: {
        text: 'We cut our AWS bill in half while actually improving performance. The ROI was immediate.',
        author: 'David Park',
        title: 'CTO',
      },
    },
  },
  {
    id: 'education',
    name: 'Education',
    icon: '🎓',
    color: '#10b981',
    colorClass: 'emerald',
    keyChallenge: 'Student engagement & administrative efficiency',
    painPoints: [
      {
        title: 'Low Completion Rates',
        description: 'Students dropping out before finishing courses.',
        statistic: '40-60% course completion rates',
        impact: 'Lost revenue, poor outcomes, reputation issues',
      },
      {
        title: 'Engagement Gaps',
        description: 'Students disengaged from learning materials.',
        statistic: '50% of students report low engagement',
        impact: 'Poor learning outcomes, high dropout rates',
      },
      {
        title: 'Administrative Overhead',
        description: 'Manual processes consuming staff time.',
        statistic: '30% of budget on administrative tasks',
        impact: 'Resource drain, staff burnout',
      },
    ],
    solutions: [
      { title: 'Student Engagement Platform', description: 'AI-powered personalized learning paths', icon: '📚', benefit: '35% higher completion' },
      { title: 'Learning Analytics', description: 'Real-time insights into student progress', icon: '📊', benefit: 'Early intervention' },
      { title: 'Administrative Automation', description: 'Automate enrollment, grading, and scheduling', icon: '⚡', benefit: '50% time savings' },
      { title: 'Remote Learning Tools', description: 'Comprehensive virtual classroom solutions', icon: '🌐', benefit: 'Learn anywhere' },
    ],
    outcomes: ['35% higher completion rates', '50% administrative savings', '90% student satisfaction'],
    metric: { value: '35%', label: 'Engagement Increase', description: '250 more completions/year' },
    caseStudy: {
      company: 'State University System',
      challenge: 'Online course completion rates stuck at 45% with high administrative costs',
      solution: 'Deployed AI-powered learning platform with automated administration',
      results: [
        { value: '35%', label: 'Completion Increase' },
        { value: '50%', label: 'Admin Savings' },
        { value: '92%', label: 'Satisfaction' },
      ],
      testimonial: {
        text: 'Student success improved dramatically. The AI identifies at-risk students before they fall behind.',
        author: 'Dr. Lisa Wang',
        title: 'Dean of Online Learning',
      },
    },
  },
];

const statTileIcons = ['time', 'shield', 'box', 'pulse', 'coin', 'spark'] as const;

const certifications = [
  { name: 'ISO 27001', description: 'Information Security' },
  { name: 'SOC 2 Type II', description: 'Service Organization Control' },
  { name: 'HIPAA', description: 'Healthcare Compliance' },
  { name: 'GDPR', description: 'Data Protection' },
  { name: 'PCI DSS', description: 'Payment Security' },
];
---

<MainLayout
  title="Industry Solutions"
  description="Tailored AI and tech solutions for healthcare, finance, retail, manufacturing, education, and SaaS. See how companies save 40%+ costs."
>
  <!-- HERO -->
  <section class="hero-section relative overflow-hidden">
    <div class="absolute inset-0 bg-slate-950" aria-hidden="true"></div>
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute left-1/2 top-1/2 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-teal-500/[0.08] blur-3xl"></div>
      <div class="absolute left-1/2 top-1/3 h-[300px] w-[300px] -translate-x-1/2 rounded-full bg-teal-500/[0.06] blur-2xl"></div>
    </div>

    <div class="container relative z-10 mx-auto px-4 py-20 md:py-28">
      <Breadcrumb items={breadcrumbItems} />

      <div class="mx-auto mt-8 max-w-3xl text-center">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 rounded-full border border-teal-500/20 bg-teal-500/10 px-4 py-1.5 text-xs font-medium text-teal-300">
          <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>
          Trusted by 200+ organisations worldwide
        </div>

        <h1 class="mt-6 font-heading text-4xl font-bold leading-tight text-white md:text-5xl lg:text-6xl">
          Industry-Specific Solutions
          <span class="block bg-gradient-to-r from-teal-300 to-teal-500 bg-clip-text text-transparent">
            That Fit Your Business
          </span>
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
          Tailored AI and technology solutions for healthcare, finance, retail, manufacturing, education, and SaaS companies.
        </p>

        <!-- CTAs -->
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href="#consultation"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-teal-500 px-8 py-4 font-semibold text-slate-950 shadow-lg shadow-teal-500/20 transition-all hover:bg-teal-400 hover:shadow-teal-500/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
          >
            Start Free Consultation
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>

          <div class="relative" id="industry-dropdown-container">
            <button
              type="button"
              id="industry-dropdown-btn"
              aria-haspopup="true"
              aria-expanded="false"
              class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-white/15 bg-white/[0.02] px-8 py-4 font-semibold text-white transition-all hover:border-white/25 hover:bg-white/[0.05] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 sm:w-auto"
            >
              Explore Industries
              <svg class="h-5 w-5 transition-transform" id="dropdown-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <div
              id="industry-dropdown-menu"
              class="absolute left-0 right-0 top-full z-50 mt-2 hidden max-h-[60vh] overflow-y-auto rounded-xl border border-white/10 bg-slate-900 py-2 shadow-2xl shadow-black/50 sm:left-auto sm:right-auto sm:w-72"
            >
              {industries.map((industry) => (
                <a
                  href={`#${industry.id}`}
                  class="industry-dropdown-item flex items-center gap-3 px-4 py-3 transition-colors hover:bg-white/[0.04]"
                  data-industry={industry.id}
                >
                  <span class="text-2xl" aria-hidden="true">{industry.icon}</span>
                  <div class="flex-1">
                    <div class="font-medium text-white">{industry.name}</div>
                    <div class="text-xs text-teal-300">{industry.metric.value} {industry.metric.label}</div>
                  </div>
                  <svg class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Meta dot row -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-x-2 gap-y-3 text-sm text-slate-400">
          <span class="inline-flex items-center gap-2">
            <svg class="h-4 w-4 stroke-teal-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Industry-proven solutions
          </span>
          <span class="text-slate-600" aria-hidden="true">·</span>
          <span class="inline-flex items-center gap-2">
            <svg class="h-4 w-4 stroke-teal-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Compliance-ready implementations
          </span>
          <span class="text-slate-600" aria-hidden="true">·</span>
          <span class="inline-flex items-center gap-2">
            <svg class="h-4 w-4 stroke-teal-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Rapid ROI
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- RESULTS THAT MATTER STRIP -->
  <section class="border-y border-white/5 bg-gradient-to-r from-slate-900 via-slate-950 to-slate-900 py-16">
    <div class="container mx-auto px-4">
      <h2 class="text-center font-heading text-2xl font-bold text-white">Results That Matter</h2>
      <p class="mt-2 text-center text-sm text-slate-400">Outcomes our clients have measured.</p>
      <div class="mt-12 grid grid-cols-2 gap-10 md:grid-cols-3 lg:grid-cols-6">
        {industries.map((industry, i) => (
          <StatTile
            value={industry.metric.value}
            label={industry.metric.label}
            iconKey={statTileIcons[i]}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRY SECTIONS -->
  <section id="industries" class="scroll-mt-20 py-20 md:py-24">
    <div class="container mx-auto px-4">
      <header class="mx-auto mb-16 max-w-3xl text-center">
        <h2 class="font-heading text-3xl font-bold text-white md:text-4xl">Solutions by Industry</h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-400">
          Every industry has unique challenges. We've developed specialized solutions that address your specific pain points.
        </p>
      </header>

      <div class="mx-auto max-w-6xl">
        {industries.map((industry, i) => (
          <>
            <IndustrySection industry={industry} index={i} />
            {i < industries.length - 1 && <SectionDivider />}
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- TRUSTED BY INDUSTRY LEADERS -->
  <section class="border-y border-white/5 bg-slate-950 py-20">
    <div class="container mx-auto px-4">
      <h2 class="text-center font-heading text-2xl font-bold text-white md:text-3xl">
        Trusted by Industry Leaders
      </h2>
      <p class="mt-3 text-center text-sm text-slate-400">Certified, audited, compliant.</p>

      <div class="mt-12 flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
        {certifications.map((cert) => (
          <div class="flex items-center gap-3 text-white/60 transition-colors hover:text-white/90">
            <svg class="h-6 w-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <div>
              <div class="text-sm font-semibold tracking-wide">{cert.name}</div>
              <div class="text-xs text-slate-500">{cert.description}</div>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-10 text-center text-sm text-slate-400">Available in 50+ countries · 24/7 support</p>
    </div>
  </section>

  <!-- CONSULTATION -->
  <section id="consultation" class="relative scroll-mt-20 overflow-hidden py-20 md:py-24">
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute left-1/2 top-1/2 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-teal-500/[0.06] blur-3xl"></div>
    </div>
    <div class="container relative z-10 mx-auto px-4">
      <div class="mx-auto max-w-5xl">
        <div class="mb-12 text-center">
          <h2 class="font-heading text-3xl font-bold text-white md:text-4xl">
            Ready to Transform Your Business?
          </h2>
          <p class="mt-4 text-lg text-slate-400">
            Schedule a free 30-minute consultation with our solutions architect.
          </p>
        </div>

        <div class="grid gap-8 lg:grid-cols-2">
          <!-- Form -->
          <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-8 md:p-10">
            <h3 class="font-heading text-xl font-bold text-white">Schedule Free Consultation</h3>
            <p class="mt-1 text-sm text-slate-400">We'll get back within 24 hours.</p>

            <form id="solutions-form" class="mt-8 space-y-5">
              <div class="grid gap-5 md:grid-cols-2">
                <div>
                  <label for="firstname" class="mb-2 block text-sm font-medium text-slate-300">First name <span class="text-teal-400">*</span></label>
                  <input
                    type="text"
                    id="firstname"
                    name="firstname"
                    required
                    autocomplete="given-name"
                    class="w-full rounded-lg border border-white/10 bg-white/[0.03] px-4 py-3 text-white placeholder-slate-500 transition-colors focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"
                    placeholder="John"
                  />
                </div>
                <div>
