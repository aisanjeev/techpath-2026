<style>
  .industry-section {
    opacity: 0;
    animation: fadeInUp 0.6s ease-out forwards;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  #industry-dropdown-menu {
    animation: dropdownFadeIn 0.2s ease-out;
  }

  @keyframes dropdownFadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  #dropdown-arrow {
    transition: transform 0.2s ease;
  }
</style>

<script>
  // Dropdown functionality
  const dropdownBtn = document.getElementById('industry-dropdown-btn');
  const dropdownMenu = document.getElementById('industry-dropdown-menu');
  const dropdownArrow = document.getElementById('dropdown-arrow');
  const dropdownItems = document.querySelectorAll('.industry-dropdown-item');

  let isDropdownOpen = false;

  function toggleDropdown() {
    isDropdownOpen = !isDropdownOpen;
    dropdownMenu?.classList.toggle('hidden', !isDropdownOpen);
    dropdownArrow?.classList.toggle('rotate-180', isDropdownOpen);
    dropdownBtn?.setAttribute('aria-expanded', String(isDropdownOpen));
  }

  function closeDropdown() {
    isDropdownOpen = false;
    dropdownMenu?.classList.add('hidden');
    dropdownArrow?.classList.remove('rotate-180');
    dropdownBtn?.setAttribute('aria-expanded', 'false');
  }

  dropdownBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleDropdown();
  });

  document.addEventListener('click', (e) => {
    const container = document.getElementById('industry-dropdown-container');
    if (container && !container.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  dropdownItems.forEach((item) => {
    item.addEventListener('click', (e) => {
      e.preventDefault();
      closeDropdown();

      const industryId = item.getAttribute('data-industry');
      if (industryId) {
        const targetSection = document.getElementById(industryId);
        if (targetSection) {
          targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.pushState(null, '', `#${industryId}`);

          const industrySelect = document.getElementById('industry') as HTMLSelectElement;
          if (industrySelect) {
            industrySelect.value = industryId;
          }
        }
      }
    });
  });

  const hash = window.location.hash.replace('#', '');
  const industrySelect = document.getElementById('industry') as HTMLSelectElement;

  if (hash && industrySelect) {
    const validIndustries = ['healthcare', 'finance', 'retail', 'manufacturing', 'technology', 'education'];
    if (validIndustries.includes(hash)) {
      industrySelect.value = hash;
      setTimeout(() => {
        const targetSection = document.getElementById(hash);
        if (targetSection) {
          targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 300);
    }
  }

  document.querySelectorAll('a[href^="#"]:not(.industry-dropdown-item)').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      e.preventDefault();
      const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
      if (href) {
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      }
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDropdown();
    }
  });
</script>

<script is:inline define:vars={{ apiBaseUrl }}>
  // Solutions consultation form handler
  const API_URL = apiBaseUrl;
  const solutionsForm = document.getElementById('solutions-form');
  const submitBtn = document.getElementById('solutions-submit-btn');
  const formMessage = document.getElementById('solutions-message');

  solutionsForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
    }

    const formData = new FormData(solutionsForm);
    const firstname = formData.get('firstname') || '';
    const lastname = formData.get('lastname') || '';
    const data = {
      name: `${firstname} ${lastname}`.trim(),
      email: formData.get('email'),
      company: formData.get('company') || null,
      service: formData.get('industry') || null,
      message: formData.get('challenge') || 'Consultation request from Solutions page',
    };

    try {
      const response = await fetch(`${API_URL}/api/v1/contact/`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (formMessage) {
        formMessage.classList.remove('hidden', 'text-red-400', 'text-green-400');

        if (response.ok) {
          formMessage.classList.add('text-green-400');
          formMessage.textContent = result.message || 'Thank you! We will contact you within 24 hours.';
          solutionsForm.reset();
        } else {
          formMessage.classList.add('text-red-400');
          formMessage.textContent = result.detail || 'An error occurred. Please try again.';
        }
      }
    } catch (error) {
      console.error('Solutions form error:', error);
      if (formMessage) {
        formMessage.classList.remove('hidden', 'text-green-400');
        formMessage.classList.add('text-red-400');
        formMessage.textContent = 'Network error. Please check your connection.';
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Schedule Consultation';
      }
    }
  });
</script>
