<style>
  .hero-section {
    background: linear-gradient(135deg, theme('colors.slate.950'), theme('colors.slate.900'));
  }

  .text-gradient {
    @apply bg-gradient-to-r from-primary-400 via-secondary-400 to-accent-400 bg-clip-text text-transparent;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }

  .animate-float {
    animation: float 8s ease-in-out infinite;
  }

  .animation-delay-300 {
    animation-delay: 3s;
  }

  /* Counter animation */
  .metric {
    font-variant-numeric: tabular-nums;
  }

  /* Industry sections */
  .industry-section {
    opacity: 0;
    animation: fadeInUp 0.6s ease-out forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Staggered animation for industry sections */
  .industry-section:nth-child(1) { animation-delay: 0.1s; }
  .industry-section:nth-child(2) { animation-delay: 0.2s; }
  .industry-section:nth-child(3) { animation-delay: 0.3s; }
  .industry-section:nth-child(4) { animation-delay: 0.4s; }
  .industry-section:nth-child(5) { animation-delay: 0.5s; }
  .industry-section:nth-child(6) { animation-delay: 0.6s; }

  /* Outcome card hover */
  .outcome-card:hover {
    transform: translateY(-4px);
    border-color: theme('colors.slate.700');
  }

  /* Pain point hover */
  .pain-point:hover {
    background: theme('colors.slate.800 / 50%');
  }

  /* Solution item hover */
  .solution-item:hover {
    background: theme('colors.slate.800 / 30%');
  }

  /* Dropdown styles */
  #industry-dropdown-menu {
    animation: dropdownFadeIn 0.2s ease-out;
  }

  @keyframes dropdownFadeIn {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #dropdown-arrow {
    transition: transform 0.2s ease;
  }
</style>

<script>
  // Dropdown functionality
  const dropdownBtn = document.getElementById('industry-dropdown-btn');
  const dropdownMenu = document.getElementById('industry-dropdown-menu');
  const dropdownArrow = document.getElementById('dropdown-arrow');
  const dropdownItems = document.querySelectorAll('.industry-dropdown-item');
  
  let isDropdownOpen = false;

  function toggleDropdown() {
    isDropdownOpen = !isDropdownOpen;
    dropdownMenu?.classList.toggle('hidden', !isDropdownOpen);
    dropdownArrow?.classList.toggle('rotate-180', isDropdownOpen);
  }

  function closeDropdown() {
    isDropdownOpen = false;
    dropdownMenu?.classList.add('hidden');
    dropdownArrow?.classList.remove('rotate-180');
  }

  // Toggle dropdown on button click
  dropdownBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleDropdown();
  });

  // Close dropdown when clicking outside
  document.addEventListener('click', (e) => {
    const container = document.getElementById('industry-dropdown-container');
    if (container && !container.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  // Handle industry selection and scroll
  dropdownItems.forEach((item) => {
    item.addEventListener('click', (e) => {
      e.preventDefault();
      closeDropdown();
      
      const industryId = item.getAttribute('data-industry');
      if (industryId) {
        const targetSection = document.getElementById(industryId);
        if (targetSection) {
          // Scroll to the industry section
          targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          
          // Update URL hash without jumping
          history.pushState(null, '', `#${industryId}`);
          
          // Also update the form industry select
          const industrySelect = document.getElementById('industry') as HTMLSelectElement;
          if (industrySelect) {
            industrySelect.value = industryId;
          }
        }
      }
    });
  });

  // Pre-select industry from URL hash on load
  const hash = window.location.hash.replace('#', '');
  const industrySelect = document.getElementById('industry') as HTMLSelectElement;
  
  if (hash && industrySelect) {
    const validIndustries = ['healthcare', 'finance', 'retail', 'manufacturing', 'technology', 'education'];
    if (validIndustries.includes(hash)) {
      industrySelect.value = hash;
      // Scroll to the industry section on page load
      setTimeout(() => {
        const targetSection = document.getElementById(hash);
        if (targetSection) {
          targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 300);
    }
  }

  // Smooth scroll for other anchor links (like consultation)
  document.querySelectorAll('a[href^="#"]:not(.industry-dropdown-item)').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const href = this.getAttribute('href');
      if (href) {
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      }
    });
  });

  // Close dropdown on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDropdown();
    }
  });
</script>

