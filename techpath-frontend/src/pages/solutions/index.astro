---

<MainLayout 
  title="Industry Solutions" 
  description="Tailored AI and tech solutions for healthcare, finance, retail, manufacturing, education, and SaaS. See how companies save 40%+ costs."
>
  <!-- HERO SECTION -->
  <section class="hero-section relative min-h-[80vh] flex items-center">
    <!-- Background gradient -->
    <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-slate-900 to-primary-950"></div>
    
    <!-- Animated background elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary-500/10 rounded-full blur-3xl animate-float"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-secondary-500/10 rounded-full blur-3xl animate-float animation-delay-300"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10 py-20">
      <Breadcrumb items={breadcrumbItems} />
      
      <div class="max-w-4xl mx-auto text-center mt-8">
        <!-- Trust badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-500/10 border border-primary-500/20 text-primary-400 text-sm mb-8">
          <span>✓</span>
          <span>Trusted by 500+ organizations worldwide</span>
        </div>

        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
          Industry-Specific Solutions
          <span class="text-gradient"> That Fit Your Business</span>
        </h1>
        
        <p class="text-xl text-slate-400 mb-8 max-w-2xl mx-auto">
          Tailored AI and technology solutions for healthcare, finance, retail, manufacturing, education, and SaaS companies.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <a 
            href="#consultation" 
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary-500 text-white font-semibold rounded-lg hover:bg-primary-600 transition-all hover:shadow-lg hover:shadow-primary-500/25"
          >
            Start Free Consultation
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          
          <!-- Dropdown Button -->
          <div class="relative" id="industry-dropdown-container">
            <button 
              type="button"
              id="industry-dropdown-btn"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-slate-700 text-white font-semibold rounded-lg hover:border-slate-600 hover:bg-slate-800/50 transition-all w-full sm:w-auto"
            >
              Explore Industries
              <svg class="w-5 h-5 transition-transform" id="dropdown-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            
            <!-- Dropdown Menu -->
            <div 
              id="industry-dropdown-menu"
              class="absolute top-full left-0 right-0 sm:left-auto sm:right-auto sm:w-72 mt-2 py-2 bg-slate-900 border border-slate-700 rounded-xl shadow-2xl shadow-black/50 hidden z-50 max-h-[60vh] overflow-y-auto"
            >
              {industries.map((industry) => (
                <a 
                  href={`#${industry.id}`}
                  class="industry-dropdown-item flex items-center gap-3 px-4 py-3 hover:bg-slate-800 transition-colors"
                  data-industry={industry.id}
                >
                  <span class="text-2xl">{industry.icon}</span>
                  <div class="flex-1">
                    <div class="font-medium text-white">{industry.name}</div>
                    <div class="text-xs" style={`color: ${industry.color}`}>{industry.metric.value} {industry.metric.label}</div>
                  </div>
                  <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Quick benefits -->
        <div class="flex flex-wrap justify-center gap-6 text-sm text-slate-400">
          <span class="flex items-center gap-2">
            <svg class="w-5 h-5 text-accent-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Industry-proven solutions
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-5 h-5 text-accent-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Compliance-ready implementations
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-5 h-5 text-accent-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Rapid ROI
          </span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- OUTCOMES SHOWCASE -->
  <section class="py-16 bg-slate-900/50 border-y border-slate-800">
    <div class="container mx-auto px-4">
      <h2 class="text-center font-heading text-2xl font-bold text-white mb-12">
        Results That Matter
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
        {industries.map((industry) => (
          <div class="outcome-card text-center p-6 rounded-xl bg-slate-800/30 border border-slate-800 hover:border-slate-700 transition-all group">
            <div class="text-3xl mb-2">{industry.icon}</div>
            <div class="metric text-3xl md:text-4xl font-bold text-white mb-1" style={`color: ${industry.color}`}>
              {industry.metric.value}
            </div>
            <div class="text-sm font-medium text-slate-300 mb-1">{industry.metric.label}</div>
            <div class="text-xs text-slate-500">{industry.metric.description}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SOLUTIONS GRID -->
  <section id="industries" class="py-20 scroll-mt-20">
    <div class="container mx-auto px-4">
      <header class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">
          Solutions by Industry
        </h2>
        <p class="text-lg text-slate-400">
          Every industry has unique challenges. We've developed specialized solutions that address your specific pain points.
        </p>
      </header>

      <div class="space-y-24">
        {industries.map((industry, index) => (
          <div id={industry.id} class="industry-section scroll-mt-24">
            <!-- Industry Header -->
            <div class="flex flex-col lg:flex-row lg:items-center gap-6 mb-8">
              <div class={`inline-flex items-center gap-3 px-4 py-2 rounded-xl bg-${industry.colorClass}-500/10 border border-${industry.colorClass}-500/20`} style={`border-color: ${industry.color}30; background: ${industry.color}10`}>
                <span class="text-4xl">{industry.icon}</span>
                <div>
                  <h3 class="font-heading text-2xl font-bold text-white">{industry.name}</h3>
                  <p class="text-sm text-slate-400">{industry.keyChallenge}</p>
                </div>
              </div>
            </div>

            <div class="grid lg:grid-cols-2 gap-8">
              <!-- Pain Points -->
              <div class="space-y-4">
                <h4 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                  <span class="text-red-400">⚠️</span> Key Challenges
                </h4>
                {industry.painPoints.map((pain) => (
                  <div class="pain-point p-4 rounded-xl bg-slate-800/30 border border-slate-800 hover:border-red-500/30 transition-all">
                    <h5 class="font-semibold text-white mb-1">{pain.title}</h5>
                    <p class="text-sm text-slate-400 mb-2">{pain.description}</p>
                    <div class="flex flex-wrap gap-3 text-xs">
                      <span class="px-2 py-1 rounded bg-red-500/10 text-red-400">{pain.statistic}</span>
                      <span class="text-slate-500">{pain.impact}</span>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Solutions -->
              <div class="space-y-4">
                <h4 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                  <span class="text-accent-400">✓</span> Our Solutions
                </h4>
                <div class="grid gap-4">
                  {industry.solutions.map((solution) => (
                    <div class="solution-item p-4 rounded-xl border border-slate-800 hover:border-slate-700 transition-all group" style={`border-left: 3px solid ${industry.color}`}>
                      <div class="flex items-start gap-3">
                        <span class="text-2xl">{solution.icon}</span>
                        <div class="flex-1">
                          <h5 class="font-semibold text-white mb-1 group-hover:text-primary-400 transition-colors">{solution.title}</h5>
                          <p class="text-sm text-slate-400 mb-2">{solution.description}</p>
                          <span class="inline-flex items-center gap-1 text-xs font-medium px-2 py-1 rounded-full" style={`background: ${industry.color}20; color: ${industry.color}`}>
                            {solution.benefit}
                          </span>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>

                <!-- Outcomes -->
                <div class="mt-6 p-4 rounded-xl bg-slate-800/50 border border-slate-800">
                  <h5 class="text-sm font-semibold text-slate-400 mb-3">Expected Outcomes</h5>
                  <div class="flex flex-wrap gap-2">
                    {industry.outcomes.map((outcome) => (
                      <span class="text-sm px-3 py-1 rounded-full bg-accent-500/10 text-accent-400 border border-accent-500/20">
                        ✓ {outcome}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <!-- Case Study -->
            <div class="mt-8 p-6 rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-900 to-slate-800/50" style={`border-top: 3px solid ${industry.color}`}>
