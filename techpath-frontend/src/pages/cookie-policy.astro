---
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumb from '@components/shared/Breadcrumb.astro';
import { fetchCookiePageContent } from '@services/pageContentService';
import { renderMarkdownWithLazyImages } from '@utils/renderMarkdownLazy';
import '@styles/markdown.css';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Cookie Policy', href: '/cookie-policy', current: true },
];

const content = await fetchCookiePageContent();
const bodyHtml = content.markdown_content
  ? await renderMarkdownWithLazyImages(content.markdown_content)
  : '';
---

<MainLayout
  title={content.seo?.title ?? 'Cookie Policy'}
  description={content.seo?.description ?? 'Learn about how Techpath uses cookies and similar technologies on our website.'}
  image={content.seo?.image ?? undefined}
  canonicalUrl={content.seo?.canonical_url ?? undefined}
  noIndex={content.seo?.no_index ?? false}
>
  <article class="legal-page py-12 lg:py-20">
    <div class="container mx-auto px-4">
      <Breadcrumb items={breadcrumbItems} />

      <header class="max-w-4xl mx-auto mb-12">
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-white mb-4">
          {content.page_title || 'Cookie Policy'}
        </h1>
        {content.last_updated && (
          <p class="text-slate-400">
            Last updated: {content.last_updated}
          </p>
        )}
      </header>

      <div class="max-w-4xl mx-auto prose-legal markdown-content prose prose-invert prose-slate prose-p:leading-relaxed prose-p:text-slate-300 prose-headings:text-white prose-li:text-slate-300 prose-a:text-primary-400 prose-a:no-underline hover:prose-a:underline" set:html={bodyHtml} />
    </div>
  </article>
</MainLayout>

<style>
  .legal-page {
    @apply bg-slate-950;
  }
</style>
