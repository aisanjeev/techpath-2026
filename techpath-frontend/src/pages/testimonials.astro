---
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumb from '@components/shared/Breadcrumb.astro';
import CTA from '@components/shared/CTA.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Testimonials', href: '/testimonials', current: true },
];

const testimonials = [
  {
    quote:
      'TechPath transformed our legacy systems into a modern, AI-powered platform. The results exceeded our expectations. Their team understood our complex requirements and delivered a solution that has significantly improved our operational efficiency.',
    author: 'Sarah Chen',
    role: 'CTO',
    company: 'FinanceFlow Inc.',
    avatar: '/images/testimonials/sarah.jpg',
    rating: 5,
  },
  {
    quote:
      'Their expertise in cloud migration saved us 40% on infrastructure costs while improving performance. The migration was seamless with zero downtime. I highly recommend TechPath for any enterprise cloud initiative.',
    author: 'Michael Roberts',
    role: 'VP Engineering',
    company: 'RetailMax',
    avatar: '/images/testimonials/michael.jpg',
    rating: 5,
  },
  {
    quote:
      'The team delivered our AI chatbot ahead of schedule. Customer satisfaction improved by 35% within the first month. Their proactive communication and technical expertise made the entire process smooth.',
    author: 'Emily Watson',
    role: 'Director of Operations',
    company: 'HealthTech Solutions',
    avatar: '/images/testimonials/emily.jpg',
    rating: 5,
  },
  {
    quote:
      'Working with TechPath was a game-changer for our startup. They built our MVP in record time and it scaled beautifully as we grew from 1K to 100K users. Couldn\'t have done it without them.',
    author: 'David Park',
    role: 'Founder & CEO',
    company: 'EduPlatform',
    avatar: '/images/testimonials/david.jpg',
    rating: 5,
  },
  {
    quote:
      'The security audit they conducted identified critical vulnerabilities we weren\'t aware of. Their remediation plan was thorough and we achieved SOC 2 compliance ahead of schedule.',
    author: 'Jennifer Martinez',
    role: 'CISO',
    company: 'SecureBank',
    avatar: '/images/testimonials/jennifer.jpg',
    rating: 5,
  },
  {
    quote:
      'TechPath\'s data analytics solution gave us insights we never had before. We\'ve been able to make data-driven decisions that increased our revenue by 25% year over year.',
    author: 'Robert Thompson',
    role: 'Head of Business Intelligence',
    company: 'LogiTrack',
    avatar: '/images/testimonials/robert.jpg',
    rating: 5,
  },
];
---

<MainLayout
  title="Testimonials"
  description="See what our clients say about working with TechPath. Real feedback from real businesses we've helped transform."
>
  <section class="py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <Breadcrumb items={breadcrumbItems} />

      <!-- Header -->
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <h1 class="mb-6 font-heading text-4xl font-bold text-white md:text-5xl lg:text-6xl">
          Client <span class="bg-gradient-to-r from-primary-400 to-secondary-400 bg-clip-text text-transparent">Testimonials</span>
        </h1>
        <p class="text-lg text-slate-400 md:text-xl">
          Don't just take our word for it. Here's what our clients have to say about working with
          TechPath.
        </p>
      </div>

      <!-- Testimonials Grid -->
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          testimonials.map((testimonial) => (
            <div class="flex flex-col rounded-2xl border border-slate-800 bg-slate-900/50 p-8">
              {/* Rating */}
              <div class="mb-4 flex gap-1">
                {Array.from({ length: testimonial.rating }).map(() => (
                  <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>

              {/* Quote */}
              <blockquote class="mb-6 flex-1 text-slate-300">"{testimonial.quote}"</blockquote>

              {/* Author */}
              <div class="flex items-center gap-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-primary-500/20 to-secondary-500/20">
                  <span class="text-lg font-bold text-primary-400">
                    {testimonial.author.charAt(0)}
                  </span>
                </div>
                <div>
                  <div class="font-semibold text-white">{testimonial.author}</div>
                  <div class="text-sm text-slate-400">
                    {testimonial.role}, {testimonial.company}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTA
    title="Ready to Join Our Success Stories?"
    description="Let's discuss how we can help transform your business."
    primaryButton={{ label: 'Get Started', href: '/contact' }}
    secondaryButton={{ label: 'View Case Studies', href: '/case-studies' }}
  />
</MainLayout>

